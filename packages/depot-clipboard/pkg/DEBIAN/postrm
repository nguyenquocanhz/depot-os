#!/bin/sh
# Trả bản /usr/bin/depot-clipboard cũ của Depot OS (nếu preinst đã cất đi) về chỗ cũ.
set -e
F=/usr/bin/depot-clipboard
case "$1" in
    remove|abort-install|disappear)
        if [ "$(dpkg-divert --listpackage "$F")" = depot-clipboard ]; then
            dpkg-divert --package depot-clipboard --remove --rename "$F"
        fi
        ;;
esac
exit 0
