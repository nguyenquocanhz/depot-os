# Màu theo bảng nổi của Depot OS (depot-tray, depot-settings): tối là mặc định, sáng khi máy dùng giao diện sáng.
PALETTE = {
    'dark': dict(bg='rgba(43, 52, 66, 0.98)', flat='#2b3442', line='rgba(255, 255, 255, 0.11)', fg='#ffffff',
                 dim='rgba(255, 255, 255, 0.72)', card='rgba(255, 255, 255, 0.055)',
                 cardline='rgba(255, 255, 255, 0.06)', hover='rgba(255, 255, 255, 0.10)',
                 sel='rgba(76, 194, 255, 0.16)', field='rgba(0, 0, 0, 0.22)', accent='#4cc2ff', onaccent='#04121c'),
    'light': dict(bg='rgba(249, 249, 249, 0.98)', flat='#f9f9f9', line='rgba(0, 0, 0, 0.14)', fg='#1b1b1b',
