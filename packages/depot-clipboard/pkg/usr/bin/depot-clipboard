VERSION = '1.0.0'
NAME = 'depot-clipboard'

CONF = os.path.join(os.environ.get('XDG_CONFIG_HOME') or os.path.expanduser('~/.config'), 'depot', 'clipboard')
DATA = os.path.join(os.environ.get('XDG_DATA_HOME') or os.path.expanduser('~/.local/share'), NAME)
PINS = os.path.join(DATA, 'pinned.json')

MAX_TEXT_BYTES = 2_000_000   # đoạn chữ dài hơn thế này thì không ghi vào lịch sử
MAX_IMAGE_SIDE = 8192        # ảnh có cạnh dài hơn thế này thì không ghi
WIDTH = 380                  # bề ngang bảng
LIST_HEIGHT = 420            # chiều cao tối đa của danh sách, quá thì cuộn

# cập nhật OTA: bản mới nhất là bản nằm trong nhánh main của kho (tệp .deb và .sha256 cạnh nguồn của gói)
UPDATE_RAW = 'https://raw.githubusercontent.com/nguyenquocanhz/depot-os/main/packages/depot-clipboard'
UPDATE_EVERY = 24 * 3600     # giây giữa hai lần bản chạy nền tự hỏi bản mới
# Thử: DEPOT_CLIPBOARD_UPDATE_URL=http://127.0.0.1:CỔNG trỏ sang một kho giả trên chính máy này (chỉ nhận 127.0.0.1)
_TEST_URL = os.environ.get('DEPOT_CLIPBOARD_UPDATE_URL', '')
if re.match(r'^http://127\.0\.0\.1(:\d+)?(/[\w./-]*)?$', _TEST_URL):
    UPDATE_RAW = _TEST_URL.rstrip('/')

USAGE = """depot-clipboard %s — Bộ nhớ tạm: lịch sử sao chép, Win+V để chọn lại và dán (X11)

  depot-clipboard start          chạy nền, ghi lại những gì được sao chép
  depot-clipboard show           mở / đóng bảng lịch sử ngay chỗ con trỏ (gán cho Win+V)
  depot-clipboard settings       mở bảng ở trang cài đặt
  depot-clipboard clear          xoá lịch sử, giữ các mục đã ghim
  depot-clipboard status         trạng thái bản chạy nền
  depot-clipboard quit           tắt bản chạy nền
  depot-clipboard restart        chạy lại bản chạy nền
  depot-clipboard bind           gán phím Win+V (XFCE); desktop khác: in cách tự gán
  depot-clipboard --check-update hỏi kho GitHub có bản mới không
  depot-clipboard --update       tải và cài bản mới
  depot-clipboard --version

Trong bảng: gõ để tìm (không dấu cũng được), ↑ ↓ chọn, Enter dán, Delete xoá mục, Ctrl+P ghim, Esc đóng.
Tuỳ chỉnh: ~/.config/depot/clipboard — MAX_TEXTS=30  MAX_IMAGES=3  PASTE=0  THEME=dark|light  UPDATE_CHECK=0""" % VERSION


def conf_get(key, default=''):
    try:
        with open(CONF, encoding='utf-8') as f:
            for line in f:
                k, _, v = line.strip().partition('=')
                if k.strip() == key:
                    return v.strip()
    except OSError:
        pass
    return default


def conf_set(key, value):
    lines = []
    try:
        with open(CONF, encoding='utf-8') as f:
            lines = [l.rstrip('\n') for l in f if l.split('=', 1)[0].strip() != key]
    except OSError:
        pass
    lines.append('%s=%s' % (key, value))
    try:
        os.makedirs(os.path.dirname(CONF), exist_ok=True)
        with open(CONF, 'w', encoding='utf-8') as f:
            f.write('\n'.join(lines) + '\n')
    except OSError:
        pass


def conf_int(key, default, low, high):
    try:
        return max(low, min(high, int(conf_get(key, str(default)))))
    except ValueError:
        return default


# ---------------------------------------------------------------- nói chuyện với bản chạy nền

def runtime_path(ext):
    """Tệp khoá / socket của bản chạy nền: mỗi người dùng, mỗi màn hình X một bản."""
    d = os.environ.get('XDG_RUNTIME_DIR')
    if not d or not os.path.isdir(d):
        # không có thư mục riêng của phiên: dùng một thư mục trong /tmp mà chỉ mình vào được
        d = '/tmp/%s-%d' % (NAME, os.getuid())
        try:
            os.mkdir(d, 0o700)
        except FileExistsError:
            pass
        st = os.lstat(d)
        if not stat.S_ISDIR(st.st_mode) or st.st_uid != os.getuid() or st.st_mode & 0o077:
            raise OSError('thư mục %s không an toàn' % d)
    disp = re.sub(r'\.\d+$', '', os.environ.get('DISPLAY', ''))
    return os.path.join(d, '%s-%d-%s.%s' % (NAME, os.getuid(), re.sub(r'[^A-Za-z0-9]', '_', disp), ext))


def send(cmd, timeout=5.0):
    """Gửi một lệnh cho bản chạy nền. Trả câu trả lời, hoặc None nếu không có bản nào đang chạy."""
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(timeout)
    try:
        s.connect(runtime_path('sock'))
        s.sendall(cmd.encode('utf-8') + b'\n')
        buf = b''
        while True:
            part = s.recv(65536)
            if not part:
                break
            buf += part
        return buf.decode('utf-8', 'replace')
    except OSError:
        return None
    finally:
        s.close()


def spawn_daemon(*extra):
    me = os.path.realpath(sys.argv[0])
    subprocess.Popen([me, 'start'] + list(extra), stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, start_new_session=True)


# ---------------------------------------------------------------- phím tắt Win+V

SHORTCUT = '/commands/custom/<Super>v'
SHORTCUT_CMD = 'depot-clipboard show'


def xfce_shortcut(force=False):
    """XFCE: gán Win+V cho Bộ nhớ tạm. Phím đang gán cho lệnh khác thì giữ nguyên, trừ khi force.
    Trả (kết quả, lệnh đang gán); kết quả: set | kept | other | none (không phải XFCE / không gán được)."""
    if 'XFCE' not in os.environ.get('XDG_CURRENT_DESKTOP', '').upper():
        return 'none', ''
    base = ['xfconf-query', '-c', 'xfce4-keyboard-shortcuts', '-p', SHORTCUT]
    try:
        cur = subprocess.run(base, capture_output=True, text=True, timeout=5, stdin=subprocess.DEVNULL)
        now = cur.stdout.strip() if cur.returncode == 0 else ''
        if now == SHORTCUT_CMD:
            return 'kept', now
        if now and not force:
            return 'other', now
        done = subprocess.run(base + ['-n', '-t', 'string', '-s', SHORTCUT_CMD], capture_output=True, timeout=5,
                              stdin=subprocess.DEVNULL)
        return ('set' if done.returncode == 0 else 'none'), now
    except (OSError, subprocess.SubprocessError):
        return 'none', ''


def bind_message(force):
    state, now = xfce_shortcut(force)
    if state == 'set':
        return 0, 'Đã gán Win+V cho Bộ nhớ tạm.'
    if state == 'kept':
        return 0, 'Win+V đã gán cho Bộ nhớ tạm từ trước.'
    if state == 'other':
        return 1, 'Win+V đang gán cho lệnh khác: %s — giữ nguyên. Muốn đổi: depot-clipboard bind --force' % now
    return 1, ('Chỉ tự gán được phím tắt trên XFCE. Desktop khác: vào phần phím tắt bàn phím, thêm lệnh\n'
               '    depot-clipboard show\nvà gán cho Win+V. i3: thêm vào ~/.config/i3/config\n'
               '    exec --no-startup-id depot-clipboard start\n'
               '    bindsym $mod+Shift+v exec --no-startup-id depot-clipboard show')


# ---------------------------------------------------------------- cập nhật OTA

def ver_key(v):
    return tuple(int(x) for x in re.findall(r'\d+', v)[:4])


def fetch(url, limit=5_000_000):
    req = urllib.request.Request(url, headers={'User-Agent': 'depot-clipboard/' + VERSION})
    with urllib.request.urlopen(req, timeout=15) as r:
        data = r.read(limit + 1)
    if len(data) > limit:
        raise ValueError('tệp tải về quá lớn')
    return data


def latest_version():
    """Phiên bản trong kho: trường Version của pkg/DEBIAN/control trên nhánh main."""
    m = re.search(r'^Version:\s*(\d+(?:\.\d+){1,3})\s*$', fetch(UPDATE_RAW + '/pkg/DEBIAN/control', 20000)
                  .decode('utf-8', 'replace'), re.M)
    if not m:
        raise ValueError('không đọc được phiên bản trong kho')
    return m.group(1)


def check_update():
    """Trả (trạng thái, bản mới nhất, thông báo); trạng thái: ok | update | error."""
    try:
        latest = latest_version()
    except (OSError, ValueError, urllib.error.URLError) as e:
        return 'error', '', 'Không hỏi được kho mã nguồn: %s' % e
    if ver_key(latest) > ver_key(VERSION):
        return 'update', latest, 'Có bản mới %s (đang dùng %s).' % (latest, VERSION)
    return 'ok', latest, 'Đang dùng bản mới nhất (%s).' % VERSION


def do_update():
    """Tải bản mới rồi cài. Trả (mã thoát, thông báo, đã cài xong chưa)."""
    state, latest, msg = check_update()
    if state != 'update':
        return (0 if state == 'ok' else 1), msg, False
    me = os.path.realpath(sys.argv[0])
    try:
        if os.access(me, os.W_OK) and not me.startswith('/usr/'):
            # bản chép tay vào thư mục người dùng (không phải gói .deb): thay chính tệp chương trình
            data = fetch(UPDATE_RAW + '/pkg/usr/bin/depot-clipboard')
            text = data.decode('utf-8')
            if not data.startswith(b'#!') or ("VERSION = '%s'" % latest) not in text:
                raise ValueError('mã trong kho chưa khớp phiên bản %s' % latest)
            compile(text, 'depot-clipboard', 'exec')             # hỏng cú pháp thì không thay
            with open(me + '.new', 'wb') as f:
                f.write(data)
            os.chmod(me + '.new', 0o755)
            os.replace(me + '.new', me)
            return 0, 'Đã cập nhật lên bản %s.' % latest, True
        name = 'depot-clipboard_%s_all.deb' % latest
        deb = fetch('%s/%s' % (UPDATE_RAW, name))
        want = fetch('%s/%s.sha256' % (UPDATE_RAW, name), 1000).decode('ascii', 'replace').split()[0].lower()
        if hashlib.sha256(deb).hexdigest() != want:
            raise ValueError('tệp %s tải về sai sha256 — không cài' % name)
        cache = os.path.join(os.environ.get('XDG_CACHE_HOME') or os.path.expanduser('~/.cache'), NAME)
        os.makedirs(cache, exist_ok=True)
        path = os.path.join(cache, name)
        with open(path, 'wb') as f:
            f.write(deb)
    except (OSError, ValueError, IndexError, SyntaxError, urllib.error.URLError) as e:
        return 1, 'Cập nhật không thành: %s' % e, False
    manual = 'Đã tải %s (sha256 khớp). Cài bằng: sudo apt install %s' % (name, path)
    if os.geteuid() == 0:
        argv = ['apt-get', 'install', '-y', path]
    elif os.environ.get('DISPLAY') and any(os.access(os.path.join(d, 'pkexec'), os.X_OK)
                                           for d in os.environ.get('PATH', '').split(':')):
        argv = ['pkexec', 'apt-get', 'install', '-y', path]      # hộp hỏi mật khẩu quản trị của hệ thống
    else:
        return 0, manual, False
    try:
        rc = subprocess.run(argv, stdin=subprocess.DEVNULL).returncode
    except OSError:
        rc = 1
    if rc:
        return 1, 'Chưa cài được (huỷ hoặc lỗi). ' + manual, False
    return 0, 'Đã cập nhật lên bản %s.' % latest, True


def auto_check():
    """Bản chạy nền: mỗi ngày hỏi một lần; có bản mới thì báo một lần cho mỗi phiên bản. Không tự cài."""
    if conf_get('UPDATE_CHECK', '1') == '0':
        return
    try:
        last = float(conf_get('UPDATE_LAST', '0'))
    except ValueError:
        last = 0.0
    if time.time() - last < UPDATE_EVERY:
        return
    conf_set('UPDATE_LAST', '%d' % time.time())
    state, latest, _msg = check_update()
    if state == 'update' and conf_get('UPDATE_SEEN') != latest:
        conf_set('UPDATE_SEEN', latest)
        try:
            subprocess.run(['notify-send', '-i', 'software-update-available', '-a', 'Bộ nhớ tạm',
                            'Bộ nhớ tạm: có bản mới %s' % latest,
                            'Đang dùng %s. Cập nhật: Win+V › bánh răng › Cập nhật, hoặc depot-clipboard --update'
                            % VERSION],
                           stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10)
        except (OSError, subprocess.SubprocessError):
            pass


# ---------------------------------------------------------------- dòng lệnh

ALIASES = {'--version': 'version', '-V': 'version', '--help': 'help', '-h': 'help', '--check-update': 'check-update',
           '--update': 'update', 'toggle': 'show'}
COMMANDS = ('start', 'show', 'settings', 'hide', 'clear', 'status', 'list', 'quit', 'restart', 'bind', 'defaults',
            'check-update', 'update', 'version', 'help')
ARGS = sys.argv[1:]
CMD = ALIASES.get(ARGS[0], ARGS[0]) if ARGS else 'show'
FLAGS = ARGS[1:]
if CMD not in COMMANDS or [a for a in FLAGS if a not in ('--show', '--settings', '--force')] \
        or (FLAGS and CMD != 'start' and (CMD, FLAGS) != ('bind', ['--force'])):
    print('depot-clipboard: không hiểu tham số %s\n\n%s' % (' '.join(ARGS), USAGE), file=sys.stderr)
    sys.exit(2)
if CMD == 'help':
    print(USAGE)
    sys.exit(0)
if CMD == 'version':
    print('depot-clipboard', VERSION)
    sys.exit(0)
if CMD == 'check-update':
    STATE, LATEST, MSG = check_update()
    print(MSG)
    sys.exit({'ok': 0, 'update': 10}.get(STATE, 1))
if CMD == 'update':
    CODE, MSG, DONE = do_update()
    print(MSG)
    if DONE and os.environ.get('DISPLAY') and send('restart') is not None:
        print('Bản chạy nền đã chạy lại bằng mã mới (lịch sử chưa ghim bắt đầu lại từ đầu).')
    sys.exit(CODE)
if CMD == 'bind':
    CODE, MSG = bind_message('--force' in FLAGS)
    print(MSG)
    sys.exit(CODE)
if CMD == 'defaults':
    # bản cũ (script gọi Clipman) đặt mặc định cho Clipman ở đây; depot-layout còn gọi lệnh này sau khi đổi bố cục
    sys.exit(0)
if not os.environ.get('DISPLAY'):
    print('depot-clipboard: không có màn hình X (biến DISPLAY) — chạy trong phiên đồ hoạ X11.', file=sys.stderr)
    sys.exit(1)
if CMD in ('show', 'settings'):
    if send(CMD) is None:
        spawn_daemon('--' + CMD)                 # chưa chạy nền: chạy rồi mở bảng luôn
    sys.exit(0)
if CMD == 'restart':
    if send('restart') is None:
        spawn_daemon()
    sys.exit(0)
if CMD in ('hide', 'clear', 'status', 'list', 'quit'):
    REPLY = send(CMD)
    if REPLY is None:
        print('depot-clipboard %s — chưa chạy nền. Chạy: depot-clipboard start &' % VERSION)
        sys.exit(0 if CMD == 'quit' else 1)
    if REPLY.strip():
        print(REPLY.rstrip('\n'))
    sys.exit(0)

# từ đây là "start": bản chạy nền
if send('ping', 2.0) is not None:
    print('depot-clipboard: đã có một bản đang chạy trên màn hình này.')
    sys.exit(0)
if os.environ.get('XDG_SESSION_TYPE') == 'wayland' and '--force' not in FLAGS:
    print('depot-clipboard: phiên Wayland không cho chương trình X11 theo dõi bộ nhớ tạm của app khác — không chạy. '
          'Dùng phiên X11 (Xorg), hoặc thử: depot-clipboard start --force')
    sys.exit(0)

os.environ.setdefault('GDK_BACKEND', 'x11')

