[Desktop Entry]
Type=Application
Version=1.0
Name=Depot Clipboard
Name[vi]=Bộ nhớ tạm
Comment=Keep a history of what was copied; Win+V opens it
Comment[vi]=Giữ lịch sử những gì đã sao chép; bấm Win+V để chọn lại và dán
Exec=depot-clipboard start
TryExec=depot-clipboard
Icon=depot-clipboard
Terminal=false
NoDisplay=true
X-GNOME-Autostart-enabled=true
