#!/usr/bin/python3
# SPDX-License-Identifier: GPL-3.0-only
# Copyright 2026 nguyenquocanhz — phát hành theo GNU GPL phiên bản 3, xem /usr/share/doc/depot-capslock/copyright
#
# depot-capslock — ô báo Caps Lock và Num Lock của Depot OS, tách thành gói riêng cho máy Debian / Ubuntu bất kỳ
# (phiên X11).
#
#   depot-capslock                 chạy nền: mỗi lần Caps Lock / Num Lock đổi trạng thái thì hiện ô báo hơn một giây
#   depot-capslock --test          hiện thử ô báo Caps Lock "bật" rồi "tắt", xong thoát
#   depot-capslock --test-num      hiện thử ô báo Num Lock "bật" rồi "tắt", xong thoát
#   depot-capslock --status        in "on" hoặc "off" (Caps Lock) rồi thoát
#   depot-capslock --status-num    in "on" hoặc "off" (Num Lock) rồi thoát
#   depot-capslock --force         vẫn chạy đủ cả hai ô báo trên Depot OS và ở phiên Wayland
#   depot-capslock --check-update  hỏi kho GitHub xem có bản mới không (mã thoát 10 = có bản mới)
#   depot-capslock --update        tải bản mới, đối chiếu sha256 rồi cài (cần quyền quản trị để cài gói .deb)
#
# Ô báo: ổ khoá đóng khi bật, ổ khoá mở khi tắt; trong thân khoá là chữ A / a (Caps Lock) hoặc chữ Num (Num Lock).
# Vẽ bằng cairo, không cần icon; không nhận bàn phím, chuột bấm xuyên qua được; chạy giống nhau trên XFCE, i3, MATE,
# Cinnamon, LXQt, Openbox.
#
# Tuỳ chỉnh trong ~/.config/depot-capslock.conf, mỗi dòng KHOÁ=giá trị, đọc lại mỗi lần hiện:
#   POSITION=top|center|bottom    chỗ hiện trên màn hình chính (mặc định top)
#   HOLD=1.3                      số giây ô báo nằm trên màn hình
#   ENABLED=0                     tạm tắt cả hai ô báo mà không phải gỡ gói
#   CAPSLOCK=0                    chỉ tắt ô báo Caps Lock
#   NUMLOCK=0                     chỉ tắt ô báo Num Lock
#   UPDATE_CHECK=0                bản chạy nền không tự hỏi bản mới (mặc định mỗi ngày hỏi một lần, chỉ báo, không tự cài)
#
# Trên Depot OS, phím nào depot-notify đã tự báo thì bản này nhường phím đó (không thì ra hai ô chồng nhau): ISO có
# depot-notify báo cả hai phím thì bản này thoát; ISO cũ chỉ báo Caps Lock thì bản này chạy riêng cho Num Lock.
#
# Mã vẽ lấy từ lớp LockOSD trong /usr/bin/depot-notify của Depot OS — sửa bên nào thì sửa luôn bên kia.

import fcntl
import hashlib
import math
import os
import re
import signal
import subprocess
import sys
import threading
import time
import urllib.error
import urllib.request

VERSION = '1.1.0'
CONF = os.path.expanduser('~/.config/depot-capslock.conf')

OSD = 132                    # cạnh ô báo
OSD_RADIUS = 26
OSD_HOLD = 1.3               # giây ô báo nằm trên màn hình
ANIM = 0.3                   # giây hiện / tắt

# phím -> (chữ khi bật, chữ khi tắt, cỡ chữ, khoá cấu hình để tắt riêng)
KEYS = {
    'caps': ('A', 'a', 25, 'CAPSLOCK'),
    'num': ('Num', 'Num', 15, 'NUMLOCK'),
}

# cập nhật OTA: bản mới nhất là bản nằm trong nhánh main của kho (tệp .deb và .sha256 cạnh nguồn của gói)
UPDATE_RAW = 'https://raw.githubusercontent.com/nguyenquocanhz/depot-os/main/packages/depot-capslock'
UPDATE_EVERY = 24 * 3600     # giây giữa hai lần bản chạy nền tự hỏi bản mới
# Thử: DEPOT_CAPSLOCK_UPDATE_URL=http://127.0.0.1:CỔNG trỏ sang một kho giả trên chính máy này (chỉ nhận 127.0.0.1)
_TEST_URL = os.environ.get('DEPOT_CAPSLOCK_UPDATE_URL', '')
if re.match(r'^http://127\.0\.0\.1(:\d+)?(/[\w./-]*)?$', _TEST_URL):
    UPDATE_RAW = _TEST_URL.rstrip('/')

USAGE = """depot-capslock %s — ô báo Caps Lock và Num Lock trên màn hình (X11)

  depot-capslock                 chạy nền, hiện ô báo mỗi khi bật / tắt Caps Lock hoặc Num Lock
  depot-capslock --test          hiện thử Caps Lock "bật" rồi "tắt", xong thoát
  depot-capslock --test-num      hiện thử Num Lock "bật" rồi "tắt", xong thoát
  depot-capslock --status        in on / off (Caps Lock)
  depot-capslock --status-num    in on / off (Num Lock)
  depot-capslock --force         vẫn chạy đủ hai ô báo trên Depot OS và ở phiên Wayland
  depot-capslock --check-update  hỏi kho GitHub có bản mới không
  depot-capslock --update        tải và cài bản mới
  depot-capslock --version

Tuỳ chỉnh: ~/.config/depot-capslock.conf — POSITION=top|center|bottom, HOLD=1.3, ENABLED=0, CAPSLOCK=0, NUMLOCK=0,
UPDATE_CHECK=0""" % VERSION


def conf_get(key, default=''):
    try:
        with open(CONF, encoding='utf-8') as f:
            for line in f:
                k, _, v = line.strip().partition('=')
                if k.strip() == key:
                    return v.strip()
    except OSError:
        pass
    return default


def conf_set(key, value):
    lines = []
    try:
        with open(CONF, encoding='utf-8') as f:
            lines = [l.rstrip('\n') for l in f if l.split('=', 1)[0].strip() != key]
    except OSError:
        pass
    lines.append('%s=%s' % (key, value))
    try:
        os.makedirs(os.path.dirname(CONF), exist_ok=True)
        with open(CONF, 'w', encoding='utf-8') as f:
            f.write('\n'.join(lines) + '\n')
    except OSError:
        pass


def depot_builtin():
    """Depot OS: các phím depot-notify đã tự báo — báo thêm thì ra hai ô chồng nhau. Trả tập {'caps', 'num'}."""
    try:
        with open('/usr/bin/depot-notify', 'rb') as f:
            src = f.read()
    except OSError:
        return set()
    have = set()
    if b'class LockOSD' in src:
        have.add('caps')
        if b'get_num_lock_state' in src:
            have.add('num')
    return have


# ---------------------------------------------------------------- cập nhật OTA

def ver_key(v):
    return tuple(int(x) for x in re.findall(r'\d+', v)[:4])


def fetch(url, limit=5_000_000):
    req = urllib.request.Request(url, headers={'User-Agent': 'depot-capslock/' + VERSION})
    with urllib.request.urlopen(req, timeout=15) as r:
        data = r.read(limit + 1)
    if len(data) > limit:
        raise ValueError('tệp tải về quá lớn')
    return data


def latest_version():
    """Phiên bản trong kho: trường Version của pkg/DEBIAN/control trên nhánh main."""
    m = re.search(r'^Version:\s*(\d+(?:\.\d+){1,3})\s*$', fetch(UPDATE_RAW + '/pkg/DEBIAN/control', 20000)
                  .decode('utf-8', 'replace'), re.M)
    if not m:
        raise ValueError('không đọc được phiên bản trong kho')
    return m.group(1)


def check_update():
    """Trả (trạng thái, bản mới nhất, thông báo); trạng thái: ok | update | error."""
    try:
        latest = latest_version()
    except (OSError, ValueError, urllib.error.URLError) as e:
        return 'error', '', 'Không hỏi được kho mã nguồn: %s' % e
    if ver_key(latest) > ver_key(VERSION):
        return 'update', latest, 'Có bản mới %s (đang dùng %s).' % (latest, VERSION)
    return 'ok', latest, 'Đang dùng bản mới nhất (%s).' % VERSION


def do_update():
    """Tải bản mới rồi cài. Trả (mã thoát, thông báo)."""
    state, latest, msg = check_update()
    if state != 'update':
        return (0 if state == 'ok' else 1), msg
    me = os.path.realpath(sys.argv[0])
    try:
        if os.access(me, os.W_OK) and not me.startswith('/usr/'):
            # bản chép tay vào thư mục người dùng (không phải gói .deb): thay chính tệp chương trình
            data = fetch(UPDATE_RAW + '/pkg/usr/bin/depot-capslock')
            text = data.decode('utf-8')
            if not data.startswith(b'#!') or ("VERSION = '%s'" % latest) not in text:
                raise ValueError('mã trong kho chưa khớp phiên bản %s' % latest)
            compile(text, 'depot-capslock', 'exec')              # hỏng cú pháp thì không thay
            with open(me + '.new', 'wb') as f:
                f.write(data)
            os.chmod(me + '.new', 0o755)
            os.replace(me + '.new', me)
            return 0, 'Đã cập nhật lên bản %s. Chạy lại: depot-capslock &' % latest
        name = 'depot-capslock_%s_all.deb' % latest
        deb = fetch('%s/%s' % (UPDATE_RAW, name))
        want = fetch('%s/%s.sha256' % (UPDATE_RAW, name), 1000).decode('ascii', 'replace').split()[0].lower()
        if hashlib.sha256(deb).hexdigest() != want:
            raise ValueError('tệp %s tải về sai sha256 — không cài' % name)
        cache = os.path.join(os.environ.get('XDG_CACHE_HOME') or os.path.expanduser('~/.cache'), 'depot-capslock')
        os.makedirs(cache, exist_ok=True)
        path = os.path.join(cache, name)
        with open(path, 'wb') as f:
            f.write(deb)
    except (OSError, ValueError, SyntaxError, urllib.error.URLError) as e:
        return 1, 'Cập nhật không thành: %s' % e
    manual = 'Đã tải %s (sha256 khớp). Cài bằng: sudo apt install %s' % (name, path)
    if os.geteuid() == 0:
        argv = ['apt-get', 'install', '-y', path]
    elif os.environ.get('DISPLAY') and any(os.access(os.path.join(d, 'pkexec'), os.X_OK)
                                           for d in os.environ.get('PATH', '').split(':')):
        argv = ['pkexec', 'apt-get', 'install', '-y', path]      # hộp hỏi mật khẩu quản trị của hệ thống
    else:
        return 0, manual
    try:
        rc = subprocess.run(argv, stdin=subprocess.DEVNULL).returncode
    except OSError:
        rc = 1
    if rc:
        return 1, 'Chưa cài được (huỷ hoặc lỗi). ' + manual
    return 0, 'Đã cập nhật lên bản %s. Bản chạy nền dùng mã mới từ lần đăng nhập sau.' % latest


def auto_check():
    """Bản chạy nền: mỗi ngày hỏi một lần; có bản mới thì báo một lần cho mỗi phiên bản. Không tự cài."""
    if conf_get('UPDATE_CHECK', '1') == '0':
        return
    try:
        last = float(conf_get('UPDATE_LAST', '0'))
    except ValueError:
        last = 0.0
    if time.time() - last < UPDATE_EVERY:
        return
    conf_set('UPDATE_LAST', '%d' % time.time())
    state, latest, _msg = check_update()
    if state == 'update' and conf_get('UPDATE_SEEN') != latest:
        conf_set('UPDATE_SEEN', latest)
        try:
            subprocess.run(['notify-send', '-i', 'software-update-available', '-a', 'Depot Caps Lock',
                            'Ô báo Caps Lock / Num Lock: có bản mới %s' % latest,
                            'Đang dùng %s. Cập nhật: depot-capslock --update' % VERSION],
                           stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10)
        except (OSError, subprocess.SubprocessError):
            pass


OPTS = ('--test', '--test-num', '--status', '--status-num', '--force', '--check-update', '--update', '--version',
        '--help', '-h')
ARGS = sys.argv[1:]
BAD = [a for a in ARGS if a not in OPTS]
if BAD:
    print('depot-capslock: không hiểu tham số %s\n\n%s' % (' '.join(BAD), USAGE), file=sys.stderr)
    sys.exit(2)
if '--help' in ARGS or '-h' in ARGS:
    print(USAGE)
    sys.exit(0)
if '--version' in ARGS:
    print('depot-capslock', VERSION)
    sys.exit(0)
if '--check-update' in ARGS:
    STATE, LATEST, MSG = check_update()
    print(MSG)
    sys.exit({'ok': 0, 'update': 10}.get(STATE, 1))
if '--update' in ARGS:
    CODE, MSG = do_update()
    print(MSG)
    sys.exit(CODE)
ONESHOT = any(a in ARGS for a in ('--test', '--test-num', '--status', '--status-num'))
SKIP = set()                 # các phím nhường cho depot-notify
if not ONESHOT and '--force' not in ARGS:
    SKIP = depot_builtin()
    if SKIP >= set(KEYS):
        print('depot-capslock: Depot OS đã có sẵn ô báo Caps Lock và Num Lock (depot-notify) — không chạy thêm. '
              'Muốn chạy bằng được: depot-capslock --force')
        sys.exit(0)
    if SKIP:
        print('depot-capslock: Caps Lock đã có depot-notify báo — bản này chỉ báo Num Lock.')
    if os.environ.get('XDG_SESSION_TYPE') == 'wayland':
        print('depot-capslock: phiên Wayland không báo trạng thái Caps Lock cho chương trình X11 — không chạy. '
              'Dùng phiên X11 (Xorg), hoặc thử: depot-capslock --force')
        sys.exit(0)

os.environ.setdefault('GDK_BACKEND', 'x11')

import gi  # noqa: E402
gi.require_version('Gtk', '3.0')
gi.require_version('Gdk', '3.0')
gi.require_foreign('cairo')
import cairo  # noqa: E402
gi.require_version('PangoCairo', '1.0')
from gi.repository import Gdk, GLib, Gtk, Pango, PangoCairo  # noqa: E402


def rrect(cr, x, y, w, h, r):
    r = max(0.0, min(r, w / 2, h / 2))
    cr.new_sub_path()
    cr.arc(x + w - r, y + r, r, -math.pi / 2, 0)
    cr.arc(x + w - r, y + h - r, r, 0, math.pi / 2)
    cr.arc(x + r, y + h - r, r, math.pi / 2, math.pi)
    cr.arc(x + r, y + r, r, math.pi, 3 * math.pi / 2)
    cr.close_path()


def ease_out(t):
    t = max(0.0, min(1.0, t))
    return 1 - (1 - t) ** 3


def workarea():
    disp = Gdk.Display.get_default()
    mon = disp.get_primary_monitor() or disp.get_monitor(0)
    wa, g = mon.get_workarea(), mon.get_geometry()
    if wa.width < 200 or wa.height < 200:          # không có trình quản lý cửa sổ: vùng làm việc rỗng
        wa = mon.get_geometry()
    if 'i3' in os.environ.get('XDG_CURRENT_DESKTOP', '').lower() and wa.y == g.y:
        wa.y += 30                                 # i3 không báo vùng làm việc: chừa i3bar ở trên
        wa.height -= 30
    return wa


def hold_time():
    try:
        return max(0.3, min(10.0, float(conf_get('HOLD', str(OSD_HOLD)).replace(',', '.'))))
    except ValueError:
        return OSD_HOLD


class LockOSD(Gtk.Window):
    """Cửa sổ nổi không qua trình quản lý cửa sổ (override-redirect): chạy giống nhau trên xfwm4, i3…"""

    def __init__(self):
        super().__init__(type=Gtk.WindowType.POPUP)
        self.set_type_hint(Gdk.WindowTypeHint.NOTIFICATION)
        self.set_title('Depot Caps Lock')
        self.set_app_paintable(True)
        self.set_resizable(False)
        self.set_accept_focus(False)
        scr = self.get_screen()
        vis = scr.get_rgba_visual()
        if vis:
            self.set_visual(vis)
        self.connect('draw', self._clear)
        self.connect('size-allocate', lambda *_: self.round_shape())
        scr.connect('composited-changed', lambda *_: self.on_composited())
        self.anim_id = None
        self.hide_id = None
        self.kind = 'caps'
        self.on = False
        self.alpha = 0.0
        area = Gtk.DrawingArea()
        area.set_size_request(OSD, OSD)
        area.connect('draw', self.paint)
        self.add(area)
        area.show()

    # ---------------------------------------------------------------- cửa sổ
    def composited(self):
        scr = self.get_screen()
        return scr.is_composited() and scr.get_rgba_visual() is not None

    def anim_on(self):
        s = Gtk.Settings.get_default()
        return self.composited() and (s is None or s.get_property('gtk-enable-animations'))

    @staticmethod
    def _clear(_w, cr):
        cr.set_operator(cairo.OPERATOR_SOURCE)
        cr.set_source_rgba(0, 0, 0, 0)
        cr.paint()
        cr.set_operator(cairo.OPERATOR_OVER)
        return False

    def round_shape(self):
        """Không compositor thì không trong suốt được: cắt 4 góc tròn bằng shape X."""
        if not self.get_realized():
            return
        if self.composited():
            self.shape_combine_region(None)
            return
        w, h = self.get_allocated_width(), self.get_allocated_height()
        surf = cairo.ImageSurface(cairo.FORMAT_A1, max(1, w), max(1, h))
        cr = cairo.Context(surf)
        rrect(cr, 0, 0, w, h, OSD_RADIUS)
        cr.fill()
        self.shape_combine_region(Gdk.cairo_region_create_from_surface(surf))

    def animate(self, step, done=None, duration=ANIM):
        """Gọi step(0..1 đã làm mượt) mỗi khung hình trong `duration` giây."""
        if self.anim_id is not None:
            GLib.source_remove(self.anim_id)
            self.anim_id = None
        if not self.anim_on():
            step(1.0)
            if done:
                done()
            return
        t0 = time.monotonic()

        def tick():
            t = (time.monotonic() - t0) / duration
            step(ease_out(t))
            if t >= 1.0:
                self.anim_id = None
                if done:
                    done()
                return False
            return True
        step(0.0)
        self.anim_id = GLib.timeout_add(16, tick)

    # ---------------------------------------------------------------- hình vẽ
    def paint(self, _w, cr):
        s = OSD
        rrect(cr, 0.5, 0.5, s - 1, s - 1, OSD_RADIUS)
        cr.set_source_rgba(0.03, 0.03, 0.045, 0.90 if self.composited() else 1.0)
        cr.fill_preserve()
        cr.set_source_rgba(1, 1, 1, 0.10)
        cr.set_line_width(1)
        cr.stroke()
        cx = s / 2
        bw, bh, by = 62, 48, 62             # thân ổ khoá
        r, lw = 19, 11                      # quai khoá
        cr.set_source_rgba(1, 1, 1, 0.96)
        cr.set_line_width(lw)
        cr.set_line_cap(cairo.LINE_CAP_BUTT)
        if self.on:                         # quai cắm cả hai chân vào thân
            top = by - 10
            cr.move_to(cx - r, by + 4)
            cr.line_to(cx - r, top)
            cr.arc(cx, top, r, math.pi, 2 * math.pi)
            cr.line_to(cx + r, by + 4)
        else:                               # quai nhấc lên, chân phải hở ra
            top = by - 22
            cr.move_to(cx - r, by + 4)
            cr.line_to(cx - r, top)
            cr.arc(cx, top, r, math.pi, 2 * math.pi)
            cr.line_to(cx + r, top + 9)
        cr.stroke()
        rrect(cr, cx - bw / 2, by, bw, bh, 9)
        cr.fill()
        on_text, off_text, size, _key = KEYS[self.kind]
        lay = self.create_pango_layout(on_text if self.on else off_text)
        lay.set_font_description(Pango.FontDescription('Inter,Sans Bold %d' % size))   # không có Inter thì chữ không chân nào cũng được
        tw, th = lay.get_pixel_size()
        cr.set_source_rgba(0.03, 0.03, 0.045, 1)
        cr.move_to(cx - tw / 2, by + (bh - th) / 2)
        PangoCairo.show_layout(cr, lay)
        return True

    # ---------------------------------------------------------------- hiện / tắt
    def fade(self, a):
        """Độ mờ của cả cửa sổ. Cửa sổ dùng visual RGBA nên GTK nhân độ mờ vào chính hình vẽ: không có compositor
        thì phải để 1.0 — không thì độ mờ còn sót từ lần mờ dần trước làm ô báo vẽ ra một ô đen trơn."""
        self.alpha = a
        Gtk.Widget.set_opacity(self, a if self.composited() else 1.0)

    def on_composited(self):
        """Compositor vừa bật / tắt (picom chết, người dùng tắt hiệu ứng): đổi cách bo góc và đặt lại độ mờ."""
        self.round_shape()
        self.fade(self.alpha)
        self.queue_draw()

    def place(self):
        wa = workarea()
        x = wa.x + (wa.width - OSD) // 2
        pos = conf_get('POSITION', 'top').lower()
        if pos == 'center':
            y = wa.y + (wa.height - OSD) // 2
        elif pos == 'bottom':
            y = wa.y + wa.height - OSD - 96
        else:
            y = wa.y + 48
        self.resize(OSD, OSD)
        self.move(x, max(wa.y, y))

    def flash(self, on, kind='caps'):
        self.kind = kind
        self.on = on
        self.place()
        if self.hide_id is not None:
            GLib.source_remove(self.hide_id)
        if not self.get_visible():
            self.alpha = 0.0
            self.show()
            self.round_shape()
            self.input_shape_combine_region(cairo.Region())      # chuột bấm xuyên qua ô báo
        self.queue_draw()
        a0 = self.alpha
        self.animate(lambda k: self.fade(a0 + (1 - a0) * k), duration=ANIM / 2)
        self.hide_id = GLib.timeout_add(int(hold_time() * 1000), self.fade_out)

    def fade_out(self):
        self.hide_id = None
        a0 = self.alpha
        self.animate(lambda k: self.fade(a0 * (1 - k)), self.hide)
        return False


def single_instance(disp_name):
    """Mỗi màn hình X một bản chạy nền. Giữ file khoá mở suốt đời tiến trình; trả None nếu đã có bản khác."""
    d = os.environ.get('XDG_RUNTIME_DIR')
    if not d or not os.path.isdir(d):
        d = '/tmp'
    path = os.path.join(d, 'depot-capslock-%d-%s.lock' % (os.getuid(), re.sub(r'[^A-Za-z0-9]', '_', disp_name)))
    try:
        fd = os.open(path, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        return None
    return fd


def main():
    disp = Gdk.Display.get_default()
    if disp is None:
        print('depot-capslock: không mở được màn hình X (biến DISPLAY) — chạy trong phiên đồ hoạ X11.', file=sys.stderr)
        return 1
    keymap = Gdk.Keymap.get_for_display(disp)
    if '--status' in ARGS:
        print('on' if keymap.get_caps_lock_state() else 'off')
        return 0
    if '--status-num' in ARGS:
        print('on' if keymap.get_num_lock_state() else 'off')
        return 0

    osd = LockOSD()
    if '--test' in ARGS or '--test-num' in ARGS:
        kind = 'num' if '--test-num' in ARGS else 'caps'
        hold = int(hold_time() * 1000)
        osd.flash(True, kind)
        GLib.timeout_add(hold + 400, lambda: osd.flash(False, kind) or False)
        GLib.timeout_add(2 * hold + 1200, lambda: Gtk.main_quit() or False)
        Gtk.main()
        return 0

    lock = single_instance(disp.get_name())
    if lock is None:
        print('depot-capslock: đã có một bản đang chạy trên màn hình này.')
        return 0

    # X báo qua XKB mỗi khi đèn khoá đổi, không cần cửa sổ nào của mình đang được chọn
    state = {'caps': keymap.get_caps_lock_state(), 'num': keymap.get_num_lock_state()}

    def on_keymap(km):
        now = {'caps': km.get_caps_lock_state(), 'num': km.get_num_lock_state()}
        for kind in ('caps', 'num'):
            if now[kind] == state[kind]:
                continue
            state[kind] = now[kind]
            if kind in SKIP or conf_get('ENABLED', '1') == '0' or conf_get(KEYS[kind][3], '1') == '0':
                continue
            osd.flash(now[kind], kind)

    keymap.connect('state-changed', on_keymap)

    def update_tick():
        threading.Thread(target=auto_check, daemon=True).start()
        return True
    GLib.timeout_add_seconds(120, lambda: update_tick() and False)
    GLib.timeout_add_seconds(3600, update_tick)
    for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, sig, lambda: Gtk.main_quit() or False)
    Gtk.main()
    os.close(lock)
    return 0


if __name__ == '__main__':
    sys.exit(main())
