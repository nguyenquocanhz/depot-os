<Window x:Class="DepotUnattend.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Depot Unattend · Tạo file cài Depot OS tự động" Width="1180" Height="860" MinWidth="940" MinHeight="600"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="13"
        Foreground="{StaticResource TextBrush}" Background="{StaticResource BgBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Margin="24,18,24,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource SecondaryButton}" Click="Open_Click" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8E5;" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Mở file…"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SecondaryButton}" Click="New_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE710;" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Làm mới"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Depot Unattend" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock VerticalAlignment="Bottom" Margin="10,0,0,3" FontSize="12" Foreground="{StaticResource MutedBrush}">
                        <Run Text="by"/> <Run Text="WrenEvil.tech" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/> <Run Text="&amp;"/> <Run Text="nguyenquocanhz" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/> <Run Text="(nqatech)"/>
                    </TextBlock>
                </StackPanel>
                <TextBlock Style="{StaticResource Muted}" FontSize="13"
                           Text="Điền form → lưu depot-autoinstall.conf vào gốc USB → boot ISO Depot OS, chọn &quot;Cài tự động&quot;. Giống autounattend.xml của Windows."/>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1" Margin="24,0,24,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="2*" MinWidth="340"/>
            </Grid.ColumnDefinitions>

            <!-- ===================== FORM ===================== -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                <StackPanel>

                    <!-- Ổ đĩa -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource H}" Text="1. Nơi cài"/>
                            <RadioButton x:Name="TargetDisk" GroupName="tgt" Margin="0,2" IsChecked="True"
                                         Content="Xoá sạch CẢ Ổ rồi chia lại (máy chỉ dùng Depot OS)"/>
                            <RadioButton x:Name="TargetPart" GroupName="tgt" Margin="0,2,0,8"
                                         Content="Chỉ QUICK FORMAT 1 phân vùng — giữ Windows, ổ D:, EFI; thêm Depot vào menu boot (dual-boot)"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                </Grid.RowDefinitions>
                                <StackPanel x:Name="DiskPanel" Grid.ColumnSpan="2" Grid.Row="0">
                                    <DockPanel>
                                        <TextBlock Style="{StaticResource Lbl}" Text="Ổ cài" Width="138"/>
                                        <ComboBox x:Name="DiskBox" IsEditable="True">
                                            <ComboBoxItem Content="auto"/>
                                            <ComboBoxItem Content="largest"/>
                                            <ComboBoxItem Content="smallest"/>
                                            <ComboBoxItem Content="/dev/sda"/>
                                            <ComboBoxItem Content="/dev/nvme0n1"/>
                                            <ComboBoxItem Content="/dev/mmcblk0"/>
                                        </ComboBox>
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource Muted}" Margin="150,0,0,6"
                                               Text="auto = máy có đúng 1 ổ trong (có 2 ổ thì dừng, không đoán) · largest / smallest = ổ trong lớn / nhỏ nhất · /dev/... = ghi rõ (xem: sudo depot-autoinstall --list-disks). USB và ổ chứa ISO không bao giờ bị chọn."/>
                                </StackPanel>
                                <StackPanel x:Name="PartPanel" Grid.ColumnSpan="2" Grid.Row="0" Visibility="Collapsed">
                                    <DockPanel>
                                        <TextBlock Style="{StaticResource Lbl}" Text="Phân vùng" Width="138"/>
                                        <ComboBox x:Name="PartBox" IsEditable="True">
                                            <ComboBoxItem Content="ask"/>
                                            <ComboBoxItem Content="LABEL=DEPOT"/>
                                            <ComboBoxItem Content="/dev/sda3"/>
                                            <ComboBoxItem Content="/dev/nvme0n1p5"/>
                                        </ComboBox>
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource Muted}" Margin="150,0,0,6"
                                               Text="ask = lúc cài hiện DANH SÁCH phân vùng để chọn bằng phím mũi tên · LABEL=… / UUID=… / /dev/sda3 = chọn sẵn (xem: sudo depot-autoinstall --list-partitions). Phân vùng Windows, EFI, Recovery, USB, &lt; 15 GB không bao giờ được chọn. Mẹo: trong Windows, Disk Management → Shrink để có chỗ trống ≥ 15 GB, tạo phân vùng đặt nhãn DEPOT."/>
                                </StackPanel>
                                <TextBlock Grid.Row="2" Style="{StaticResource Lbl}" Text="Kiểu boot"/>
                                <ComboBox Grid.Row="2" Grid.Column="1" x:Name="BootModeBox">
                                    <ComboBoxItem Content="auto" ToolTip="Theo máy đang boot"/>
                                    <ComboBoxItem Content="uefi" ToolTip="UEFI (GPT + EFI)"/>
                                    <ComboBoxItem Content="bios" ToolTip="Legacy BIOS (MBR)"/>
                                    <ComboBoxItem Content="both" ToolTip="Cả Legacy lẫn UEFI — ổ boot được trên mọi máy"/>
                                </ComboBox>
                                <TextBlock Grid.Row="3" Style="{StaticResource Lbl}" Text="Hệ thống tệp"/>
                                <ComboBox Grid.Row="3" Grid.Column="1" x:Name="FsBox">
                                    <ComboBoxItem Content="ext4"/>
                                    <ComboBoxItem Content="btrfs"/>
                                </ComboBox>
                                <TextBlock Grid.Row="4" Style="{StaticResource Lbl}" Text="Swap (MB)"/>
                                <DockPanel Grid.Row="4" Grid.Column="1">
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0"
                                               Text="0 = không tạo (Depot đã có zram)"/>
                                    <TextBox x:Name="SwapBox" Text="0"/>
                                </DockPanel>
                            </Grid>
                            <Border Background="{StaticResource DangerBgBrush}" CornerRadius="6" Padding="12,8" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock x:Name="DangerText" FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                                               Text="⚠ TOÀN BỘ DỮ LIỆU TRÊN Ổ ĐÃ CHỌN SẼ BỊ XOÁ SẠCH — kể cả Windows, ổ D:, ảnh, tài liệu."/>
                                    <CheckBox x:Name="WipeBox" Foreground="{StaticResource DangerBrush}"
                                              Content="Tôi hiểu và đồng ý XOÁ SẠCH cả ổ này (WIPE__DISK=yes — thiếu thì trình cài từ chối chạy)"/>
                                    <CheckBox x:Name="FormatBox" Foreground="{StaticResource DangerBrush}" Visibility="Collapsed"
                                              Content="Tôi hiểu và đồng ý QUICK FORMAT phân vùng này (FORMAT__PARTITION=yes)"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Ngôn ngữ -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource H}" Text="2. Ngôn ngữ, bàn phím, giờ"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource Lbl}" Text="Ngôn ngữ"/>
                                <ComboBox Grid.Column="1" x:Name="LocaleBox" IsEditable="True">
                                    <ComboBoxItem Content="vi_VN.UTF-8"/>
                                    <ComboBoxItem Content="en_US.UTF-8"/>
                                    <ComboBoxItem Content="en_GB.UTF-8"/>
                                    <ComboBoxItem Content="ja_JP.UTF-8"/>
                                    <ComboBoxItem Content="ko_KR.UTF-8"/>
                                    <ComboBoxItem Content="zh_CN.UTF-8"/>
                                    <ComboBoxItem Content="fr_FR.UTF-8"/>
                                    <ComboBoxItem Content="de_DE.UTF-8"/>
                                </ComboBox>
                                <TextBlock Grid.Row="1" Style="{StaticResource Lbl}" Text="Bàn phím"/>
                                <ComboBox Grid.Row="1" Grid.Column="1" x:Name="KbBox" IsEditable="True"
                                          ToolTip="Gõ tiếng Việt dùng Unikey (fcitx5) có sẵn — giữ us là được">
                                    <ComboBoxItem Content="us"/>
                                    <ComboBoxItem Content="vn"/>
                                    <ComboBoxItem Content="gb"/>
                                    <ComboBoxItem Content="fr"/>
                                    <ComboBoxItem Content="de"/>
                                    <ComboBoxItem Content="jp"/>
                                    <ComboBoxItem Content="kr"/>
                                </ComboBox>
                                <TextBlock Grid.Row="2" Style="{StaticResource Lbl}" Text="Kiểu phụ / tuỳ chọn"/>
                                <Grid Grid.Row="2" Grid.Column="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="KbVariantBox" ToolTip="KEYBOARD_VARIANT, vd: intl (để trống nếu không biết)"/>
                                    <TextBox Grid.Column="2" x:Name="KbOptionsBox" ToolTip="KEYBOARD_OPTIONS, vd: ctrl:nocaps"/>
                                </Grid>
                                <TextBlock Grid.Row="3" Style="{StaticResource Lbl}" Text="Múi giờ"/>
                                <ComboBox Grid.Row="3" Grid.Column="1" x:Name="TzBox" IsEditable="True">
                                    <ComboBoxItem Content="Asia/Ho_Chi_Minh"/>
                                    <ComboBoxItem Content="Asia/Bangkok"/>
                                    <ComboBoxItem Content="Asia/Singapore"/>
                                    <ComboBoxItem Content="Asia/Shanghai"/>
                                    <ComboBoxItem Content="Asia/Tokyo"/>
                                    <ComboBoxItem Content="Asia/Seoul"/>
                                    <ComboBoxItem Content="Australia/Sydney"/>
                                    <ComboBoxItem Content="Europe/London"/>
                                    <ComboBoxItem Content="Europe/Berlin"/>
                                    <ComboBoxItem Content="America/New_York"/>
                                    <ComboBoxItem Content="America/Los_Angeles"/>
                                    <ComboBoxItem Content="UTC"/>
                                </ComboBox>
                                <TextBlock Grid.Row="4" Style="{StaticResource Lbl}" Text="Đồng hồ phần cứng"/>
                                <ComboBox Grid.Row="4" Grid.Column="1" x:Name="RtcBox"
                                          ToolTip="auto: máy có Windows thì giữ giờ địa phương như Windows (không lệch 7 tiếng khi dual-boot)">
                                    <ComboBoxItem Content="auto"/>
                                    <ComboBoxItem Content="local"/>
                                    <ComboBoxItem Content="utc"/>
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Người dùng -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource H}" Text="3. Máy và người dùng"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource Lbl}" Text="Tên máy"/>
                                <TextBox Grid.Column="1" x:Name="HostBox" Text="depot-pc" ToolTip="Chữ không dấu, số, gạch ngang"/>
                                <TextBlock Grid.Row="1" Style="{StaticResource Lbl}" Text="Tên hiển thị"/>
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="FullNameBox" ToolTip="Có dấu được, vd Nguyễn Văn A"/>
                                <TextBlock Grid.Row="2" Style="{StaticResource Lbl}" Text="Tên đăng nhập"/>
                                <TextBox Grid.Row="2" Grid.Column="1" x:Name="UserBox" ToolTip="Viết thường, không dấu, không cách"/>
                                <TextBlock Grid.Row="3" Style="{StaticResource Lbl}" Text="Mật khẩu"/>
                                <PasswordBox Grid.Row="3" Grid.Column="1" x:Name="Pwd1"/>
                                <TextBlock Grid.Row="4" Style="{StaticResource Lbl}" Text="Nhập lại"/>
                                <PasswordBox Grid.Row="4" Grid.Column="1" x:Name="Pwd2"/>
                                <TextBlock Grid.Row="5" Grid.Column="1" x:Name="PwdNote" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                                <StackPanel Grid.Row="6" Grid.Column="1">
                                    <CheckBox x:Name="HashBox" IsChecked="True"
                                              Content="Mã hoá mật khẩu trong file (SHA-512, khuyên dùng — ai cầm USB cũng không đọc được)"/>
                                    <CheckBox x:Name="AutoLoginBox" Content="Tự đăng nhập vào desktop (mật khẩu vẫn cần cho sudo)"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Mạng + phần mềm -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource H}" Text="4. Mạng và phần mềm"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource Lbl}" Text="Wi-Fi (tên)"/>
                                <TextBox Grid.Column="1" x:Name="WifiBox" ToolTip="Dùng dây LAN thì để trống"/>
                                <TextBlock Grid.Row="1" Style="{StaticResource Lbl}" Text="Wi-Fi (mật khẩu)"/>
                                <PasswordBox Grid.Row="1" Grid.Column="1" x:Name="WifiPwd" ToolTip="Ghi dạng chữ trong file (Wi-Fi không mã hoá được)"/>
                                <CheckBox Grid.Row="2" Grid.Column="1" x:Name="AppsBox" IsChecked="True"
                                          Content="Firefox, VLC, LocalSend có sẵn. Tải thêm bộ app Depot lúc cài (GNOME Software, Telegram, Discord, Claude, in ấn…) — cần mạng"/>
                                <TextBlock Grid.Row="3" Style="{StaticResource Lbl}" Text="Gói cài thêm"/>
                                <TextBox Grid.Row="3" Grid.Column="1" x:Name="PkgBox" ToolTip="Tên gói Debian cách nhau bằng dấu cách, vd: htop git build-essential"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- SSH + tường lửa -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource H}" Text="5. Truy cập từ xa (OpenSSH) và tường lửa"/>
                            <CheckBox x:Name="FirewallBox" IsChecked="True"
                                      Content="Bật tường lửa ufw: chặn mọi kết nối vào, chỉ mở SSH (nếu bật), LocalSend 53317, mDNS 5353"/>
                            <CheckBox x:Name="SshBox" Content="Bật OpenSSH server (đăng nhập từ xa, root bị chặn)"/>
                            <Grid x:Name="SshPanel" IsEnabled="False" Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource Lbl}" Text="Cổng"/>
                                <TextBox Grid.Column="1" x:Name="SshPortBox" Text="22"/>
                                <TextBlock Grid.Row="1" Style="{StaticResource Lbl}" Text="User SSH riêng"/>
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="SshUserBox"
                                         ToolTip="Tạo user riêng cho SSH (không sudo). Để trống = SSH bằng user chính"/>
                                <TextBlock Grid.Row="2" Style="{StaticResource Lbl}" Text="Mật khẩu SSH"/>
                                <PasswordBox Grid.Row="2" Grid.Column="1" x:Name="SshPwd" ToolTip="Mã hoá SHA-512 khi lưu (nếu tích mã hoá ở mục 3)"/>
                                <TextBlock Grid.Row="3" Style="{StaticResource Lbl}" Text="Public key"/>
                                <TextBox Grid.Row="3" Grid.Column="1" x:Name="SshKeyBox" FontFamily="Consolas"
                                         ToolTip="1 dòng: ssh-ed25519 AAAA… máy-tôi (lấy từ %USERPROFILE%\.ssh\id_ed25519.pub)"/>
                                <TextBlock Grid.Row="4" Style="{StaticResource Lbl}" Text="Lưu trữ riêng"/>
                                <TextBox Grid.Row="4" Grid.Column="1" x:Name="SshStorageBox"
                                         ToolTip="Trống = /srv/&lt;user&gt; · thư mục khác · phân vùng /dev/sdb1 hoặc LABEL=SSHDATA (gắn vào /srv/&lt;user&gt;)"/>
                                <StackPanel Grid.Row="5" Grid.Column="1">
                                    <CheckBox x:Name="SshStorageFormatBox" Content="Quick format phân vùng lưu trữ (ext4) — mất dữ liệu trên đó"/>
                                    <CheckBox x:Name="SshPwAuthBox" IsChecked="True" Content="Cho đăng nhập bằng mật khẩu (bỏ tích = chỉ dùng key)"/>
                                    <CheckBox x:Name="SshSudoBox" Content="Cho user SSH quyền sudo"/>
                                </StackPanel>
                                <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource Muted}"
                                           Text="Từ máy khác: ssh user@địa-chỉ-IP -p cổng. Máy mới tự sinh khoá máy chủ riêng."/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Lệnh -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource H}" Text="6. Lệnh sau khi cài"/>
                            <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,4"
                                       Text="Mỗi dòng một lệnh, quyền root, trong máy mới. Có sẵn $DEPOT_USER và $DEPOT_HOSTNAME. Lỗi một lệnh không làm hỏng bản cài."/>
                            <TextBlock Text="Ngay khi cài xong (POST_INSTALL — giống SetupComplete.cmd)" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            <TextBox x:Name="PostBox" AcceptsReturn="True" Height="70" FontFamily="Consolas" VerticalScrollBarVisibility="Auto"
                                     TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto"/>
                            <TextBlock Text="Lần khởi động đầu, có mạng (FIRSTBOOT — giống FirstLogonCommands)" FontWeight="SemiBold" Margin="0,8,0,0"/>
                            <TextBox x:Name="FirstBox" AcceptsReturn="True" Height="70" FontFamily="Consolas" VerticalScrollBarVisibility="Auto"
                                     TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto"/>
                            <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0"
                                       Text="Chép file kèm theo: tạo thư mục depot-files\ cạnh file cấu hình trên USB — mọi thứ trong đó chép đè vào gốc máy mới (giống $OEM$\$1)."/>
                        </StackPanel>
                    </Border>

                    <!-- Khởi động / kết thúc -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource H}" Text="7. Xác nhận, bắt đầu và kết thúc"/>
                            <CheckBox x:Name="AutoStartBox"
                                      Content="Tự cài khi thấy file trên USB, không cần chọn mục boot &quot;Cài tự động&quot; (cài hàng loạt)"/>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="2" Style="{StaticResource Lbl}" Text="Trước khi format"/>
                                <ComboBox Grid.Row="2" Grid.Column="1" x:Name="ConfirmBox">
                                    <ComboBoxItem Content="countdown" ToolTip="Hiện bảng phân vùng + cảnh báo, đếm ngược rồi tự cài (phím bất kỳ = huỷ)"/>
                                    <ComboBoxItem Content="ask" ToolTip="Hiện bảng phân vùng + cảnh báo, hỏi Cài / Huỷ (mặc định Huỷ) — cần người bấm"/>
                                </ComboBox>
                                <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource Muted}" Margin="0,0,0,4"
                                           Text="Lúc cài luôn hiện bảng phân vùng (cái nào FORMAT, cái nào giữ nguyên) và cảnh báo trước khi bung hệ thống."/>
                                <TextBlock Style="{StaticResource Lbl}" Text="Đếm ngược (giây)"/>
                                <DockPanel Grid.Column="1">
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0"
                                               Text="nhấn phím bất kỳ trong lúc đếm để huỷ · 0 = không đợi"/>
                                    <TextBox x:Name="CountdownBox" Text="15"/>
                                </DockPanel>
                                <TextBlock Grid.Row="1" Style="{StaticResource Lbl}" Text="Cài xong thì"/>
                                <ComboBox Grid.Row="1" Grid.Column="1" x:Name="FinishBox">
                                    <ComboBoxItem Content="reboot" ToolTip="Khởi động lại (rút USB)"/>
                                    <ComboBoxItem Content="poweroff" ToolTip="Tắt máy"/>
                                    <ComboBoxItem Content="none" ToolTip="Đứng yên"/>
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ===================== PREVIEW ===================== -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border x:Name="StatusCard" CornerRadius="8" Padding="14,10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock x:Name="StatusTitle" FontWeight="SemiBold"/>
                        <TextBlock x:Name="StatusList" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="12"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Background="{StaticResource CodeBgBrush}" CornerRadius="8" Padding="2">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="depot-autoinstall.conf" Foreground="#94A3B8" FontSize="12" Margin="12,8,12,4"/>
                        <TextBox x:Name="Preview" IsReadOnly="True" FontFamily="Consolas" FontSize="12" Background="Transparent"
                                 Foreground="{StaticResource CodeFgBrush}" BorderThickness="0" Padding="10,0,10,10" Margin="0"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"/>
                    </DockPanel>
                </Border>
                <WrapPanel Grid.Row="2" Margin="0,10,0,0" HorizontalAlignment="Right">
                    <Button Style="{StaticResource SecondaryButton}" Click="Copy_Click" Margin="0,0,8,0" Content="Sao chép"/>
                    <Button Style="{StaticResource SecondaryButton}" Click="Save_Click" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74E;" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Lưu file…"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="UsbButton" Style="{StaticResource PrimaryButton}" Click="SaveUsb_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE88E;" VerticalAlignment="Center" Margin="0,0,6,0"/>
