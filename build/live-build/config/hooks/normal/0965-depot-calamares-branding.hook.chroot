#!/bin/sh
# Depot OS — bộ cài Calamares dùng branding "depot" (logo Depot by WrenEvil) thay cho "debian"
# File branding: includes.chroot/etc/calamares/branding/depot/ (ảnh sinh bằng design/identity/wrenevil/wrenevil_logo.py)
# settings.conf vẫn là của gói calamares-settings-debian (hook 0960, 1230 cũng sửa tại chỗ) — chỉ đổi dòng branding.
set -e
S=/etc/calamares/settings.conf
B=/etc/calamares/branding/depot
[ -f "$S" ] || { echo "!! thiếu $S"; exit 1; }
for f in branding.desc show.qml depot-logo.png welcome.png; do
    [ -f "$B/$f" ] || { echo "!! thiếu $B/$f — branding depot không đủ, giữ debian"; exit 1; }
done
grep -q '^branding:' "$S" || { echo "!! $S không có dòng branding: kiểm lại sau khi nâng Calamares"; exit 1; }
sed -i 's/^branding:.*/branding: depot/' "$S"
echo ">> Depot Calamares: $(grep '^branding:' "$S")"
