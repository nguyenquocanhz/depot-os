#!/bin/sh
# Depot OS — LocalSend: "AirDrop mở source" (gửi file chéo thiết bị cùng mạng).
# Không có trong kho Debian — tải .deb chính thức từ GitHub release lúc build.
# GHIM phiên bản + sha256: không hỏi api.github.com ("latest") nữa — bị giới hạn 60 lần/giờ, trả 403
# làm ISO thiếu LocalSend; và mỗi lần build ra một bản khác nhau. Nâng bản: đổi VER + SHA (digest trên trang release).
# Chạy trong SUBSHELL ( ) — exit 1 bên trong không giết hook (live-build fatal).
set -e
VER=1.18.2
SHA=cc42a4f3eacdcb25ec31f0016b1272acb003145ab30484db8965450e20c72cd2
URL="https://github.com/localsend/localsend/releases/download/v$VER/LocalSend-$VER-linux-x86-64.deb"
LOGD=/usr/share/depot-os
LOG="$LOGD/localsend.log"
mkdir -p "$LOGD"
command -v curl >/dev/null 2>&1 || exit 0

(
    echo "URL: $URL"
    curl -fsSL --retry 3 --max-time 300 -o /tmp/localsend.deb "$URL" || exit 1
    echo "$SHA  /tmp/localsend.deb" | sha256sum -c - || exit 1
    DEBIAN_FRONTEND=noninteractive apt-get install -y /tmp/localsend.deb || exit 1
    rm -f /tmp/localsend.deb
    echo "OK LocalSend $VER đã cài"
) > "$LOG" 2>&1 || true

if dpkg -l 2>/dev/null | grep -q '^ii.*localsend'; then
    echo ">> LocalSend $VER đã cài"
else
    echo "!! LocalSend cài không thành công — Log: $LOG" >&2
    tail -8 "$LOG" >&2
fi
exit 0
