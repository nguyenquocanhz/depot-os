// Depot OS — fastfetch: lời chào khi mở Terminal (logo "Depot by WrenEvil" Bóng ma + cấu hình máy, tiếng Việt)
// Tắt lời chào: touch ~/.config/depot/no-fetch   ·   Đổi riêng cho mình: ~/.config/fastfetch/config.jsonc
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "/usr/share/depot-os/fastfetch/depot-logo.txt",
        "color": { "1": "97", "2": "91", "3": "90" },
        "padding": { "top": 1, "left": 1, "right": 4 }
    },
    "display": {
        "separator": "  ",
        "key": { "width": 10 },
        "color": { "keys": "91", "title": "97" },
        "percent": { "type": 9 },
        "bar": { "charElapsed": "■", "charTotal": "·", "width": 12 }
    },
    "modules": [
        { "type": "title", "format": "{user-name}@{host-name}" },
        { "type": "custom", "format": "\u001b[90m────────────────────────────" },
        {
            "type": "command",
            "key": "OS",
            "text": "n=$(sed -n 's/^NAME=\"\\(.*\\)\"$/\\1/p' /etc/depot-edition 2>/dev/null); echo \"${n:-Depot OS} · Debian $(cut -d. -f1 /etc/debian_version)\""
        },
        { "type": "host", "key": "Máy" },
        { "type": "kernel", "key": "Kernel" },
        { "type": "uptime", "key": "Đã chạy" },
        { "type": "packages", "key": "Gói" },
        { "type": "de", "key": "Desktop" },
        { "type": "wm", "key": "WM" },
        { "type": "terminal", "key": "Terminal" },
        { "type": "cpu", "key": "CPU", "showPeCoreCount": true },
        { "type": "gpu", "key": "GPU" },
        { "type": "memory", "key": "RAM" },
        { "type": "disk", "key": "Ổ đĩa", "folders": "/" },
        { "type": "battery", "key": "Pin" },
        "break",
        { "type": "colors", "symbol": "circle", "paddingLeft": 0 }
    ]
}
