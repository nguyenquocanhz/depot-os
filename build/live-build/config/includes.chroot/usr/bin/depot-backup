#!/usr/bin/env python3
# Depot OS — depot-backup: app "Sao lưu" kiểu Windows Backup của Windows 11 — chọn nơi lưu (USB, ổ ngoài, thư mục bất
# kỳ), bật các nhóm muốn giữ (Thư mục, Ứng dụng, Cài đặt), bấm Sao lưu; máy mới hoặc cài lại thì bấm Khôi phục.
#
#   depot-backup                          mở cửa sổ
#   depot-backup start                    mở cửa sổ và bắt đầu sao lưu ngay (nơi lưu và các nhóm như lần trước)
#   depot-backup restore-page             mở cửa sổ ở trang Khôi phục
#   depot-backup run [--dest THƯ_MỤC]     sao lưu theo lựa chọn đã lưu (in tiến độ ra terminal)
#   depot-backup status                   in nơi lưu, các nhóm đang bật, lần sao lưu gần nhất
#   depot-backup list [THƯ_MỤC]           in các bản sao lưu tìm thấy (ở nơi lưu, các ổ đang cắm, hoặc THƯ_MỤC)
#   depot-backup restore BẢN [--only folders,settings,apps]   khôi phục từ một bản (BẢN = thư mục chứa manifest.json)
#
# Bản sao lưu là thư mục thường, mở xem được bằng trình quản lý tệp:  <nơi lưu>/Sao lưu Depot/<tên máy>/
#   Thư mục/<Tên>/…        bản chép các thư mục cá nhân đã chọn. Lần sau chỉ chép tệp mới hoặc đã đổi (so cỡ + giờ sửa).
#                          Tệp đã xoá ở máy KHÔNG bị xoá ở bản sao lưu.
#   Ứng dụng/              apt-manual.txt (gói người dùng chủ động cài), flatpak.txt, apt-sources.txt
#   Cài đặt/<nhóm>.tar.gz  cấu hình trong ~/.config của từng nhóm (giao diện + panel, bộ gõ, app tự chạy…)
#   manifest.json          thời điểm, tên máy, từng nhóm có gì — phần Khôi phục đọc file này
# Khôi phục: thư mục chép ngược về (tệp ở máy mới hơn thì giữ); cài đặt giải nén về ~/.config sau khi cất bản đang có
# vào ~/.local/share/depot-backup/ (đăng xuất rồi đăng nhập lại mới thấy đủ); ứng dụng: so danh sách với máy, cài lại
# gói còn thiếu bằng pkexec apt-get.
# KHÔNG sao lưu: mật khẩu Wi-Fi và tài khoản (nằm ở chỗ chỉ root đọc được, mà bản sao lưu thì không mã hoá), hồ sơ
# trình duyệt, dữ liệu của từng ứng dụng. Bản sao lưu không mã hoá: ai cầm ổ đĩa cũng đọc được.
# Thử: HOME=/thư-mục-giả XDG_CONFIG_HOME=/thư-mục-giả/.config depot-backup run --dest … (mọi đường dẫn tính từ hai biến này).

import json
import os
import pwd
import shutil
import socket
import subprocess
import sys
import tarfile
import threading
import time

HOME = os.path.expanduser('~')
CONFIG = os.environ.get('XDG_CONFIG_HOME') or os.path.join(HOME, '.config')
CONF = os.path.join(CONFIG, 'depot', 'backup')
ROOT_NAME = 'Sao lưu Depot'
SAFE_DIR = os.path.join(HOME, '.local', 'share', 'depot-backup')      # bản cài đặt đang có, cất trước khi khôi phục
FORMAT = 1

# khoá, biến trong user-dirs.dirs, tên hiện (cũng là tên thư mục trong bản sao lưu), tên mặc định, bật sẵn
FOLDERS = [
    ('desktop', 'XDG_DESKTOP_DIR', 'Màn hình nền', 'Desktop', True),
    ('documents', 'XDG_DOCUMENTS_DIR', 'Tài liệu', 'Documents', True),
    ('pictures', 'XDG_PICTURES_DIR', 'Ảnh', 'Pictures', True),
    ('videos', 'XDG_VIDEOS_DIR', 'Video', 'Videos', True),
    ('music', 'XDG_MUSIC_DIR', 'Nhạc', 'Music', True),
    ('download', 'XDG_DOWNLOAD_DIR', 'Tải về', 'Downloads', False),
]
# khoá, tên hiện, mô tả, các đường dẫn tính từ $HOME
SETTINGS = [
    ('look', 'Giao diện và thanh panel', 'Theme, bố cục, panel, khay, phím tắt, hình nền, hiệu ứng, Terminal',
     ['.config/xfce4', '.config/gtk-3.0', '.config/depot', '.config/depot-capslock.conf', '.config/plank',
      '.config/conky', '.config/picom', '.config/rofi', '.config/Thunar', '.config/fontconfig']),
    ('input', 'Bộ gõ tiếng Việt', 'Kiểu gõ, bảng mã, phím chuyển V–E của Unikey / Fcitx 5', ['.config/fcitx5']),
    ('startup', 'Ứng dụng tự chạy và mặc định', 'App chạy lúc đăng nhập, app mở từng loại tệp',
     ['.config/autostart', '.config/mimeapps.list', '.local/share/applications/mimeapps.list']),
    ('session', 'Phiên i3 và trình phát', 'Cấu hình i3, i3status, dunst, mpv',
     ['.config/i3', '.config/i3status', '.config/dunst', '.config/mpv']),
]


# ====================================================================== cấu hình

def conf_read():
    d = {}
    try:
        with open(CONF, encoding='utf-8') as f:
            for line in f:
                k, sep, v = line.rstrip('\n').partition('=')
                if sep:
                    d[k.strip()] = v
    except OSError:
        pass
    return d


def conf_write(d):
    try:
        os.makedirs(os.path.dirname(CONF), exist_ok=True)
        with open(CONF, 'w', encoding='utf-8') as f:
            f.write(''.join('%s=%s\n' % kv for kv in sorted(d.items())))
    except OSError:
        pass


def conf_set(key, value):
    d = conf_read()
    d[key] = value
    conf_write(d)


def selection(conf=None):
    """Các nhóm đang bật: {'folders': [khoá], 'apps': bool, 'settings': [khoá]}."""
    c = conf_read() if conf is None else conf
    folders = c['FOLDERS'].split(',') if 'FOLDERS' in c else [f[0] for f in FOLDERS if f[4]]
    settings = c['SETTINGS'].split(',') if 'SETTINGS' in c else [s[0] for s in SETTINGS]
    return {'folders': [k for k in folders if k], 'apps': c.get('APPS', '1') != '0',
            'settings': [k for k in settings if k]}


def user_dirs():
    """{khoá: đường dẫn thư mục cá nhân} theo ~/.config/user-dirs.dirs (tên thư mục đổi theo ngôn ngữ)."""
    raw = {}
    try:
        with open(os.path.join(CONFIG, 'user-dirs.dirs'), encoding='utf-8') as f:
            for line in f:
                k, sep, v = line.strip().partition('=')
                if sep and not k.startswith('#'):
                    raw[k] = v.strip().strip('"').replace('$HOME', HOME)
    except OSError:
        pass
    out = {}
    for key, var, _name, default, _on in FOLDERS:
        p = raw.get(var) or os.path.join(HOME, default)
        out[key] = p if os.path.normpath(p) != os.path.normpath(HOME) else ''     # trỏ về $HOME = không dùng
    return out


def human(n):
    for unit, size in (('GB', 1e9), ('MB', 1e6), ('KB', 1e3)):
        if n >= size:
            return ('%.1f %s' % (n / size, unit)).replace('.', ',')
    return '%d byte' % n


def short(path):
    """Đường dẫn cho gọn mắt: ~ thay thư mục nhà; dài quá thì chỉ giữ ba cấp cuối."""
    p = path.replace(HOME, '~', 1) if path.startswith(HOME) else path
    parts = p.split('/')
    return p if len(p) <= 64 or len(parts) <= 4 else '…/' + '/'.join(parts[-3:])


def backup_root(dest):
    return os.path.join(dest, ROOT_NAME, socket.gethostname())


# ====================================================================== chép tệp

class Stop(Exception):
    pass


def inside(path, parent):
    path, parent = os.path.realpath(path), os.path.realpath(parent)
    return path == parent or path.startswith(parent.rstrip('/') + '/')


def plan_copy(src, dst, skip=(), keep_newer=False):
    """Các tệp cần chép từ src sang dst: [(nguồn, đích, cỡ)], cùng số tệp và tổng cỡ của cả cây nguồn.
    Bỏ qua liên kết mềm và tệp đặc biệt; tệp đích cùng cỡ và cùng giờ sửa (lệch dưới 2 giây: ổ FAT) coi là đã có.
    keep_newer (khôi phục): tệp đích mới hơn thì giữ."""
    todo, files, total = [], 0, 0
    for base, dirs, names in os.walk(src):
        dirs[:] = [d for d in dirs if not os.path.islink(os.path.join(base, d))
                   and not any(inside(os.path.join(base, d), s) for s in skip)]
        rel = os.path.relpath(base, src)
        for name in names:
            s = os.path.join(base, name)
            try:
                st = os.lstat(s)
            except OSError:
                continue
            if not os.path.isfile(s) or os.path.islink(s):
                continue
            files += 1
            total += st.st_size
            d = os.path.normpath(os.path.join(dst, rel, name))
            try:
                dt = os.stat(d)
                if keep_newer and dt.st_mtime >= st.st_mtime - 2:
                    continue
                if dt.st_size == st.st_size and abs(dt.st_mtime - st.st_mtime) < 2.5:
                    continue
            except OSError:
                pass
            todo.append((s, d, st.st_size))
    return todo, files, total


def run_copy(todo, progress, stop, errors):
    """Chép từng tệp (ghi ra tệp tạm rồi đổi tên: rút ổ giữa chừng không để lại tệp dở mang tên thật)."""
    for s, d, size in todo:
        if stop.is_set():
            raise Stop()
        try:
            os.makedirs(os.path.dirname(d), exist_ok=True)
            tmp = d + '.depot-tmp'
            with open(s, 'rb') as fi, open(tmp, 'wb') as fo:
                while True:
                    if stop.is_set():
                        raise Stop()
                    buf = fi.read(1 << 20)
                    if not buf:
                        break
                    fo.write(buf)
                    progress(len(buf), s)
            st = os.stat(s)
            os.utime(tmp, (st.st_atime, st.st_mtime))
            os.replace(tmp, d)
        except Stop:
            try:
                os.remove(d + '.depot-tmp')
            except OSError:
                pass
            raise
        except OSError as e:
            errors.append('%s: %s' % (s, e.strerror or e))
            try:
                os.remove(d + '.depot-tmp')
            except OSError:
                pass
            progress(0, s)


# ====================================================================== ứng dụng

def cmd_lines(argv, any_code=False):
    try:
        p = subprocess.run(argv, capture_output=True, text=True, timeout=60, stdin=subprocess.DEVNULL,
                           env=dict(os.environ, LC_ALL='C'))
        return [l for l in p.stdout.splitlines() if l.strip()] if p.returncode == 0 or any_code else []
    except (OSError, subprocess.SubprocessError):
        return []


def apps_now():
    """{'apt': [gói cài chủ động], 'flatpak': [id], 'sources': [dòng nguồn apt]}"""
    sources = []
    for path in ['/etc/apt/sources.list'] + sorted(
            os.path.join('/etc/apt/sources.list.d', n) for n in (os.listdir('/etc/apt/sources.list.d')
                                                                  if os.path.isdir('/etc/apt/sources.list.d') else [])):
        try:
            with open(path, encoding='utf-8', errors='replace') as f:
                sources += ['# ' + path] + [l.rstrip() for l in f if l.strip() and not l.lstrip().startswith('#')]
        except OSError:
            pass
    return {'apt': sorted(cmd_lines(['apt-mark', 'showmanual'])),
            'flatpak': sorted(cmd_lines(['flatpak', 'list', '--app', '--columns=application'])),
            'sources': sources}


def apps_missing(root):
    """Gói có trong bản sao lưu mà máy này chưa cài: (cài được bằng apt, kho của máy không có), và app Flatpak thiếu."""
    def read(name):
        try:
            with open(os.path.join(root, 'Ứng dụng', name), encoding='utf-8') as f:
                return [l.strip() for l in f if l.strip() and not l.startswith('#')]
        except OSError:
            return []
    have = set(cmd_lines(['dpkg-query', '-W', '-f', '${Package}\n']))
    want = [p for p in read('apt-manual.txt') if p not in have]
    known = set()
    for i in range(0, len(want), 200):
        # hỏi theo lô; có gói lạ thì apt-cache trả mã lỗi nhưng vẫn in đủ các gói nó biết
        for line in cmd_lines(['apt-cache', 'show', '--no-all-versions'] + want[i:i + 200], any_code=True):
            if line.startswith('Package: '):
                known.add(line[9:].strip())
    flat_have = set(cmd_lines(['flatpak', 'list', '--app', '--columns=application']))
    return ([p for p in want if p in known], [p for p in want if p not in known],
            [a for a in read('flatpak.txt') if a not in flat_have])


# ====================================================================== sao lưu

def estimate(dest, sel=None):
    """Tính trước: {'folders': {khoá: (số tệp, cỡ, cỡ còn phải chép)}, 'need': tổng phải chép, 'free': chỗ trống}."""
    sel = sel or selection()
    dirs, root = user_dirs(), backup_root(dest) if dest else ''
    out = {'folders': {}, 'need': 0, 'free': None}
    for key, _var, name, _d, _on in FOLDERS:
        src = dirs.get(key)
        if not src or not os.path.isdir(src):
            continue
        todo, files, total = plan_copy(src, os.path.join(root, 'Thư mục', name) if root else '/nonexistent',
                                       skip=[root] if root else [])
        need = sum(t[2] for t in todo)
        out['folders'][key] = (files, total, need)
        if key in sel['folders']:
            out['need'] += need
    if dest and os.path.isdir(dest):
        try:
            out['free'] = shutil.disk_usage(dest).free
        except OSError:
            pass
    return out


def do_backup(dest, sel=None, report=lambda *a: None, stop=None):
    """Sao lưu. report(giai đoạn, đã xong, tổng, đang làm gì). Trả manifest (có khoá 'errors')."""
    sel = sel or selection()
    stop = stop or threading.Event()
    if not dest or not os.path.isdir(dest):
        raise OSError('Nơi lưu "%s" không có (ổ chưa cắm?)' % dest)
    if not os.access(dest, os.W_OK):
        raise OSError('Không ghi được vào "%s"' % dest)
    root = backup_root(dest)
    dirs = user_dirs()
    errors = []
    manifest = {'format': FORMAT, 'host': socket.gethostname(), 'user': os.path.basename(HOME),
                'time': time.strftime('%Y-%m-%d %H:%M:%S'), 'folders': {}, 'apps': {}, 'settings': {}}

    # 1) tính trước để biết có đủ chỗ không và vẽ thanh tiến độ theo byte
    report('scan', 0, 0, 'Đang xem cần chép những gì…')
    plans, need = [], 0
    for key, _var, name, _d, _on in FOLDERS:
        src = dirs.get(key)
        if key not in sel['folders'] or not src or not os.path.isdir(src):
            continue
        if inside(dest, src):
            raise OSError('Nơi lưu nằm trong thư mục "%s" đang được sao lưu — chọn nơi khác, hoặc tắt thư mục đó.' % name)
        todo, files, total = plan_copy(src, os.path.join(root, 'Thư mục', name), skip=[root])
        plans.append((key, name, src, todo, files, total))
        need += sum(t[2] for t in todo)
    free = shutil.disk_usage(dest).free
    if need + 20 * 1024 * 1024 > free:
        raise OSError('Nơi lưu không đủ chỗ: cần %s, còn trống %s.' % (human(need), human(free)))
    os.makedirs(root, exist_ok=True)

    # 2) thư mục
    done = [0]

    def progress(n, path):
        done[0] += n
        report('folders', done[0], need, path)
    for key, name, src, todo, files, total in plans:
        run_copy(todo, progress, stop, errors)
        manifest['folders'][key] = {'name': name, 'files': files, 'bytes': total, 'source': src}

    # 3) ứng dụng
    if sel['apps']:
        report('apps', need, need, 'Đang ghi danh sách ứng dụng…')
        apps = apps_now()
        d = os.path.join(root, 'Ứng dụng')
        os.makedirs(d, exist_ok=True)
        for name, lines in (('apt-manual.txt', apps['apt']), ('flatpak.txt', apps['flatpak']),
                            ('apt-sources.txt', apps['sources'])):
            with open(os.path.join(d, name), 'w', encoding='utf-8') as f:
                f.write('\n'.join(lines) + ('\n' if lines else ''))
        manifest['apps'] = {'apt': len(apps['apt']), 'flatpak': len(apps['flatpak'])}

    # 4) cài đặt
    for key, name, _desc, paths in SETTINGS:
        if key not in sel['settings']:
            continue
        if stop.is_set():
            raise Stop()
        report('settings', need, need, 'Đang gói cài đặt: %s…' % name)
        d = os.path.join(root, 'Cài đặt')
        os.makedirs(d, exist_ok=True)
        have = [p for p in paths if os.path.lexists(os.path.join(HOME, p))]
        tmp = os.path.join(d, key + '.tar.gz.depot-tmp')
        try:
            with tarfile.open(tmp, 'w:gz') as tar:
                for p in have:
                    tar.add(os.path.join(HOME, p), arcname=p)
            os.replace(tmp, os.path.join(d, key + '.tar.gz'))
            manifest['settings'][key] = {'name': name, 'paths': have}
        except (OSError, tarfile.TarError) as e:
            errors.append('Cài đặt "%s": %s' % (name, e))

    manifest['errors'] = len(errors)
    with open(os.path.join(root, 'manifest.json.depot-tmp'), 'w', encoding='utf-8') as f:
        json.dump(manifest, f, ensure_ascii=False, indent=1)
    os.replace(os.path.join(root, 'manifest.json.depot-tmp'), os.path.join(root, 'manifest.json'))
    if errors:
        with open(os.path.join(root, 'loi-lan-sao-luu-cuoi.txt'), 'w', encoding='utf-8') as f:
            f.write('\n'.join(errors) + '\n')
    conf_set('LAST', '%s|%s|%d' % (manifest['time'], root, len(errors)))
    report('done', need, need, '')
    manifest['error_list'] = errors
    return manifest


# ====================================================================== khôi phục

def read_manifest(root):
    try:
        with open(os.path.join(root, 'manifest.json'), encoding='utf-8') as f:
            m = json.load(f)
        return m if isinstance(m, dict) and m.get('format') == FORMAT else None
    except (OSError, ValueError):
        return None


def find_backups(extra=()):
    """[(thư mục bản sao lưu, manifest)] ở nơi lưu đã chọn, các ổ đang cắm và các thư mục chỉ thêm; mới nhất trước."""
    places = [conf_read().get('DEST', '')] + list(extra)
    try:
        with open('/proc/mounts', encoding='utf-8') as f:
            places += [l.split()[1].replace('\\040', ' ') for l in f
                       if l.split()[1].startswith(('/media/', '/run/media/', '/mnt/'))]
    except OSError:
        pass
    found, seen = [], set()
    for place in places:
        if not place:
            continue
        cands = [place, os.path.join(place, ROOT_NAME)]
        base = os.path.join(place, ROOT_NAME)
        if os.path.isdir(base):
            try:
                cands += [os.path.join(base, n) for n in sorted(os.listdir(base))]
            except OSError:
                pass
        for c in cands:
            real = os.path.realpath(c)
            m = read_manifest(c) if real not in seen else None
            if m:
                seen.add(real)
                found.append((c, m))
    return sorted(found, key=lambda x: x[1].get('time', ''), reverse=True)


def do_restore(root, only=('folders', 'settings', 'apps'), report=lambda *a: None, stop=None):
    """Khôi phục từ bản ở root. Trả {'folders': số tệp đã chép, 'settings': [nhóm], 'saved': tệp cất cài đặt cũ,
    'apps': (cài được, không có trong kho, flatpak thiếu), 'errors': [...]}."""
    m = read_manifest(root)
    if not m:
        raise OSError('"%s" không phải bản sao lưu Depot (thiếu manifest.json).' % root)
    stop = stop or threading.Event()
    res = {'folders': 0, 'settings': [], 'saved': '', 'apps': ([], [], []), 'errors': []}
    dirs = user_dirs()
    if 'folders' in only:
        report('scan', 0, 0, 'Đang xem cần chép những gì…')
        plans, need = [], 0
        for key, info in m.get('folders', {}).items():
            src = os.path.join(root, 'Thư mục', info.get('name', key))
            dst = dirs.get(key)
            if not dst or not os.path.isdir(src):
                continue
            todo, _files, _total = plan_copy(src, dst, keep_newer=True)
            plans.append(todo)
            need += sum(t[2] for t in todo)
        free = shutil.disk_usage(HOME).free
        if need + 50 * 1024 * 1024 > free:
            raise OSError('Máy không đủ chỗ để khôi phục thư mục: cần %s, còn trống %s.' % (human(need), human(free)))
        done = [0]

        def progress(n, path):
            done[0] += n
            report('folders', done[0], need, path)
        for todo in plans:
            run_copy(todo, progress, stop, res['errors'])
            res['folders'] += len(todo)
    if 'settings' in only and m.get('settings'):
        report('settings', 1, 1, 'Đang khôi phục cài đặt…')
        names = {s[0]: s for s in SETTINGS}
        groups = [k for k in m['settings'] if k in names and os.path.isfile(os.path.join(root, 'Cài đặt', k + '.tar.gz'))]
        # cất bản đang có trước khi ghi đè
        os.makedirs(SAFE_DIR, exist_ok=True)
        saved = os.path.join(SAFE_DIR, 'truoc-khi-khoi-phuc-%s.tar.gz' % time.strftime('%Y%m%d-%H%M%S'))
        try:
            with tarfile.open(saved, 'w:gz') as tar:
                for k in groups:
                    for p in names[k][3]:
                        if os.path.lexists(os.path.join(HOME, p)):
                            tar.add(os.path.join(HOME, p), arcname=p)
            res['saved'] = saved
        except (OSError, tarfile.TarError) as e:
            raise OSError('Không cất được cài đặt đang có (%s) nên chưa khôi phục cài đặt.' % e)
        if 'look' in groups and os.path.realpath(HOME) == os.path.realpath(pwd.getpwuid(os.getuid()).pw_dir):
            # xfconfd giữ cài đặt trong bộ nhớ và sẽ ghi đè file vừa khôi phục: cho nó nghỉ, lần gọi sau nó đọc lại
            subprocess.run(['pkill', '-x', 'xfconfd'], stdin=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        for k in groups:
            allowed = tuple(names[k][3])
            try:
                with tarfile.open(os.path.join(root, 'Cài đặt', k + '.tar.gz'), 'r:gz') as tar:
                    members = [t for t in tar.getmembers()
                               if not os.path.isabs(t.name) and '..' not in t.name.split('/')
                               and any(t.name == a or t.name.startswith(a + '/') for a in allowed)
                               and (t.isfile() or t.isdir())]
                    tar.extractall(HOME, members=members, filter='data')
                res['settings'].append(names[k][1])
            except (OSError, tarfile.TarError, TypeError) as e:
                res['errors'].append('Cài đặt "%s": %s' % (names[k][1], e))
    if 'apps' in only and m.get('apps'):
        report('apps', 1, 1, 'Đang so danh sách ứng dụng…')
        res['apps'] = apps_missing(root)
    report('done', 1, 1, '')
    return res


# ====================================================================== dòng lệnh

def cli(args):
    cmd = args[0]
    if cmd == 'status':
        c, sel, dirs = conf_read(), selection(), user_dirs()
        print('Nơi lưu: %s' % (c.get('DEST') or '(chưa chọn)'))
        print('Thư mục: %s' % (', '.join(f[2] for f in FOLDERS if f[0] in sel['folders'] and dirs.get(f[0])
                                         and os.path.isdir(dirs[f[0]])) or 'không'))
        print('Ứng dụng: %s' % ('có' if sel['apps'] else 'không'))
        print('Cài đặt: %s' % (', '.join(s[1] for s in SETTINGS if s[0] in sel['settings']) or 'không'))
        last = c.get('LAST', '').split('|')
        print('Lần gần nhất: %s' % ('%s → %s%s' % (last[0], last[1], ' (%s lỗi)' % last[2] if last[2] != '0' else '')
                                    if len(last) == 3 else 'chưa sao lưu lần nào'))
        return 0
    if cmd == 'list':
        found = find_backups(args[1:2])
        for root, m in found:
            print('%s\t%s\t%s' % (m.get('time', '?'), m.get('host', '?'), root))
        if not found:
            print('Không thấy bản sao lưu nào.')
        return 0
    if cmd == 'run':
        dest = args[args.index('--dest') + 1] if '--dest' in args[:-1] else conf_read().get('DEST', '')
        if not dest:
            print('depot-backup: chưa chọn nơi lưu — thêm --dest THƯ_MỤC', file=sys.stderr)
            return 2
        last = [0.0]

        def report(stage, done, total, what):
            if stage == 'folders' and time.monotonic() - last[0] > 0.5:
                last[0] = time.monotonic()
                print('\r  %s / %s   ' % (human(done), human(total)), end='', flush=True)
            elif stage in ('scan', 'apps', 'settings'):
                print('\r' + what.ljust(60))
        try:
            m = do_backup(dest, report=report)
        except OSError as e:
            print('\ndepot-backup: %s' % e, file=sys.stderr)
            return 1
        print('\rXong: %s' % backup_root(dest))
        for key, info in m['folders'].items():
            print('  %-14s %d tệp, %s' % (info['name'], info['files'], human(info['bytes'])))
        if m['apps']:
            print('  Ứng dụng       %d gói apt, %d app Flatpak' % (m['apps']['apt'], m['apps']['flatpak']))
        if m['settings']:
            print('  Cài đặt        %s' % ', '.join(v['name'] for v in m['settings'].values()))
        for e in m['error_list'][:20]:
            print('  !! ' + e)
        return 0 if not m['error_list'] else 3
    if cmd == 'restore' and len(args) > 1:
        only = tuple(args[args.index('--only') + 1].split(',')) if '--only' in args[:-1] else ('folders', 'settings', 'apps')
        try:
            r = do_restore(args[1], only, report=lambda stage, d, t, what: stage != 'folders' and what and print(what))
        except OSError as e:
            print('depot-backup: %s' % e, file=sys.stderr)
            return 1
        print('Thư mục: đã chép %d tệp' % r['folders'])
        if r['settings']:
            print('Cài đặt: %s — bản cũ cất ở %s. Đăng xuất rồi đăng nhập lại để áp dụng.' % (', '.join(r['settings']), r['saved']))
        ok, unknown, flat = r['apps']
        if ok:
            print('Ứng dụng còn thiếu, cài bằng:\n  sudo apt install %s' % ' '.join(ok))
        if unknown:
            print('Kho của máy này không có: %s' % ' '.join(unknown))
        if flat:
            print('App Flatpak còn thiếu: %s' % ' '.join(flat))
        for e in r['errors'][:20]:
            print('  !! ' + e)
        return 0 if not r['errors'] else 3
    print(__doc__ or 'dùng: depot-backup [run [--dest THƯ_MỤC] | status | list [THƯ_MỤC] | restore BẢN [--only …]]',
          file=sys.stderr)
    return 2


if __name__ == '__main__' and sys.argv[1:] and sys.argv[1] in ('run', 'status', 'list', 'restore'):
    sys.exit(cli(sys.argv[1:]))
if __name__ == '__main__' and sys.argv[1:] and sys.argv[1] in ('-h', '--help'):
    print('dùng: depot-backup [run [--dest THƯ_MỤC] | status | list [THƯ_MỤC] | restore BẢN [--only folders,settings,apps]]')
    sys.exit(0)

