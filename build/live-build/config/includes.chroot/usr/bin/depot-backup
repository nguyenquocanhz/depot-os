def bg(fn, done=None):
    def work():
        try:
            r = fn()
        except Exception as e:                      # noqa: BLE001
            r = e
        if done:
            GLib.idle_add(lambda: (done(r), False)[1])
    threading.Thread(target=work, daemon=True).start()


def label(text='', cls=None, xalign=0.0, wrap=False):
    l = Gtk.Label(label=text)
    l.set_xalign(xalign)
    if wrap:
        l.set_line_wrap(True)
        l.set_line_wrap_mode(Pango.WrapMode.WORD_CHAR)
        l.set_max_width_chars(70)
    else:
        l.set_ellipsize(Pango.EllipsizeMode.MIDDLE)
    for c in (cls or '').split():
        l.get_style_context().add_class(c)
    return l


def image(name, px=20, cls=None):
    theme = Gtk.IconTheme.get_default()
    img = Gtk.Image.new_from_icon_name(name if theme.has_icon(name) else 'folder-symbolic', Gtk.IconSize.MENU)
    img.set_pixel_size(px)
    if cls:
        img.get_style_context().add_class(cls)
    return img


def button(text, cb, accent=False):
    b = Gtk.Button(label=text)
    b.get_style_context().add_class('bk-btn')
    if accent:
        b.get_style_context().add_class('accent')
    b.set_can_focus(False)
    b.set_valign(Gtk.Align.CENTER)
    b.connect('clicked', lambda *_: cb())
    return b


def switch(active, cb):
    sw = Gtk.Switch()
    sw.set_active(active)
    sw.set_valign(Gtk.Align.CENTER)
    sw.set_can_focus(False)
    sw.connect('notify::active', lambda s, _p: cb(s.get_active()))
    return sw


class Group:
    """Một nhóm kiểu Windows Backup: thẻ có icon, tên, tóm tắt; bấm thì mở ra các dòng con có công tắc."""

    def __init__(self, icon_name, title, sub, trailing=None, rows=None):
        self.box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        head = Gtk.Box()
        head.pack_start(image(icon_name, 20, 'bk-row-icon'), False, False, 0)
        col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
        col.set_valign(Gtk.Align.CENTER)
        col.pack_start(label(title, 'bk-row-title'), False, False, 0)
        self.sub = label(sub, 'bk-row-sub')
        col.pack_start(self.sub, False, False, 0)
        head.pack_start(col, True, True, 0)
        self.value = label('', 'bk-row-value', xalign=1.0)
        if rows is None:
            for w in trailing or []:
                head.pack_end(w, False, False, 0)
            head.pack_end(self.value, False, False, 0)
            head.get_style_context().add_class('bk-card')
            self.box.pack_start(head, False, False, 0)
            return
        self.chev = image('pan-down-symbolic', 14, 'bk-chev')
        head.pack_end(self.chev, False, False, 0)
        head.pack_end(self.value, False, False, 0)
        self.head = Gtk.Button()
        self.head.add(head)
        self.head.set_can_focus(False)
        self.head.get_style_context().add_class('bk-card')
        self.head.connect('clicked', lambda *_: self.toggle())
        self.box.pack_start(self.head, False, False, 0)
        self.rev = Gtk.Revealer()
        self.rev.set_transition_type(Gtk.RevealerTransitionType.SLIDE_DOWN)
        self.rev.set_transition_duration(160)
        inner = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        inner.get_style_context().add_class('bk-sub')
        for r in rows:
            inner.pack_start(r, False, False, 0)
        self.rev.add(inner)
        self.box.pack_start(self.rev, False, False, 0)

    def toggle(self):
        on = not self.rev.get_reveal_child()
        self.rev.set_reveal_child(on)
        self.chev.set_from_icon_name('pan-up-symbolic' if on else 'pan-down-symbolic', Gtk.IconSize.MENU)
        ctx = self.head.get_style_context()
        (ctx.add_class if on else ctx.remove_class)('open')


def subrow(title, sub, trailing):
    row = Gtk.Box()
    row.get_style_context().add_class('bk-subrow')
    col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
    col.set_valign(Gtk.Align.CENTER)
    col.pack_start(label(title, 'bk-row-title'), False, False, 0)
    sub_l = label(sub, 'bk-row-sub')
    col.pack_start(sub_l, False, False, 0)
    row.pack_start(col, True, True, 0)
    for w in trailing:
        row.pack_end(w, False, False, 0)
    row.sub = sub_l
    return row


class Window(Gtk.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title='Sao lưu')
        self.set_default_size(760, 720)
        self.set_size_request(560, 460)
        self.set_icon_name('drive-harddisk')
        self.get_style_context().add_class('bk-win')
        self.busy = False
        self.stop = threading.Event()
        self.est = None
        self.css = Gtk.CssProvider()
        Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), self.css,
                                                 Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION + 20)
        self.apply_theme()
        Gtk.Settings.get_default().connect('notify::gtk-theme-name', lambda *_: self.apply_theme())
        self.build_titlebar()
        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        root.get_style_context().add_class('bk-root')
        self.add(root)
        self.stack = Gtk.Stack()
        self.stack.set_transition_type(Gtk.StackTransitionType.CROSSFADE)
        self.stack.set_transition_duration(120)
        root.pack_start(self.stack, True, True, 0)
        self.stack.add_named(self.build_backup_page(), 'backup')
        self.stack.add_named(self.build_restore_page(), 'restore')
        root.show_all()
        self.show_page('backup')
        self.connect('delete-event', self.on_close)
        self.refresh()

    # ------------------------------------------------------------------ khung
    def apply_theme(self):
        mode = conf_value_settings()
        if mode not in PALETTES:
            st = Gtk.Settings.get_default()
            mode = 'dark' if 'dark' in (st.get_property('gtk-theme-name') or '').lower() or st.get_property(
                'gtk-application-prefer-dark-theme') else 'light'
        self.css.load_from_data((''.join('@define-color bk_%s %s;\n' % kv for kv in PALETTES[mode].items())
                                 + CSS).encode())

    def build_titlebar(self):
        bar = Gtk.Box()
        bar.get_style_context().add_class('bk-titlebar')
        self.back = Gtk.Button()
        self.back.add(image('go-previous-symbolic', 16))
        self.back.get_style_context().add_class('bk-back')
        self.back.set_can_focus(False)
        self.back.get_child().show()
        self.back.set_no_show_all(True)
        self.back.connect('clicked', lambda *_: self.show_page('backup'))
        bar.pack_start(self.back, False, False, 0)
        self.app_title = label('Sao lưu Depot', 'bk-app-title')
        bar.pack_start(self.app_title, False, False, 0)
        for icon_name, cls, cb in (('window-close-symbolic', 'close', self.close),
                                   ('window-maximize-symbolic', 'max',
                                    lambda: self.unmaximize() if self.is_maximized() else self.maximize()),
                                   ('window-minimize-symbolic', 'min', self.iconify)):
            b = Gtk.Button()
            b.add(image(icon_name, 14))
            b.get_style_context().add_class('bk-winbtn')
            b.get_style_context().add_class(cls)
            b.set_can_focus(False)
            b.set_valign(Gtk.Align.START)
            b.connect('clicked', lambda _b, f=cb: f())
            bar.pack_end(b, False, False, 0)
        bar.show_all()
        self.set_titlebar(bar)

    def show_page(self, name):
        if self.busy:
            return
        self.stack.set_visible_child_name(name)
        self.back.set_visible(name != 'backup')
        self.app_title.set_text('Sao lưu Depot' if name == 'backup' else 'Khôi phục')
        if name == 'restore':
            self.fill_backups()

    def on_close(self, *_):
        if self.busy:
            self.stop.set()                          # đang chép: dừng cho gọn rồi mới đóng
            return True
        return False

    def scrolled(self, child):
        sc = Gtk.ScrolledWindow()
        sc.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        sc.add(child)
        return sc

    # ------------------------------------------------------------------ trang Sao lưu
    def build_backup_page(self):
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        col.get_style_context().add_class('bk-page')
        hero = Gtk.Box(spacing=18)
        hero.set_margin_bottom(14)
        hero.pack_start(image('drive-harddisk', 56), False, False, 0)
        hcol = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
        hcol.set_valign(Gtk.Align.CENTER)
        hcol.pack_start(label('Sao lưu máy này', 'bk-hero-title'), False, False, 0)
        self.hero_sub = label('', 'bk-hero-sub', wrap=True)
        hcol.pack_start(self.hero_sub, False, False, 0)
        hero.pack_start(hcol, True, True, 0)
        col.pack_start(hero, False, False, 0)

        # nơi lưu
        self.dest_btn = Gtk.MenuButton()
        self.dest_btn.add(label('Chọn nơi lưu'))
        self.dest_btn.get_style_context().add_class('bk-btn')
        self.dest_btn.set_can_focus(False)
        self.dest_btn.set_valign(Gtk.Align.CENTER)
        self.dest_pop = Gtk.Popover()
        self.dest_pop.get_style_context().add_class('bk-pop')
        self.dest_btn.set_popover(self.dest_pop)
        self.dest_btn.connect('toggled', lambda b: b.get_active() and self.fill_places())
        self.dest = Group('drive-removable-media-symbolic', 'Nơi lưu', '', trailing=[self.dest_btn])
        col.pack_start(self.dest.box, False, False, 0)
        col.pack_start(Gtk.Box(height_request=8), False, False, 0)

        sel, dirs = selection(), user_dirs()
        # thư mục
        self.folder_rows = {}
        rows = []
        for key, _var, name, _d, _on in FOLDERS:
            path = dirs.get(key)
            if not path or not os.path.isdir(path):
                continue
            row = subrow(name, path.replace(HOME, '~', 1),
                         [switch(key in sel['folders'], lambda on, key=key: self.set_member('FOLDERS', key, on))])
            self.folder_rows[key] = row
            rows.append(row)
        self.g_folders = Group('folder-symbolic', 'Thư mục', '', rows=rows)
        col.pack_start(self.g_folders.box, False, False, 0)
        # ứng dụng
        self.g_apps = Group('view-app-grid-symbolic', 'Ứng dụng',
                            'Ghi nhớ danh sách ứng dụng đã cài để cài lại nhanh trên máy mới',
                            trailing=[switch(sel['apps'], lambda on: (conf_set('APPS', '1' if on else '0'),
                                                                      self.refresh()))])
        col.pack_start(self.g_apps.box, False, False, 0)
        # cài đặt
        rows = [subrow(name, desc, [switch(key in sel['settings'],
                                           lambda on, key=key: self.set_member('SETTINGS', key, on))])
                for key, name, desc, _paths in SETTINGS]
        self.g_settings = Group('preferences-system-symbolic', 'Cài đặt', '', rows=rows)
        col.pack_start(self.g_settings.box, False, False, 0)
        col.pack_start(Gtk.Box(height_request=8), False, False, 0)
        col.pack_start(label('Không sao lưu mật khẩu Wi‑Fi, tài khoản, hồ sơ trình duyệt. Bản sao lưu không mã hoá: '
                             'ai cầm ổ đĩa cũng đọc được.', 'bk-note', wrap=True), False, False, 0)
        page.pack_start(self.scrolled(col), True, True, 0)

        # thanh dưới
        bottom = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        bottom.get_style_context().add_class('bk-bottom')
        self.bar = Gtk.ProgressBar()
        self.bar.set_no_show_all(True)
        bottom.pack_start(self.bar, False, False, 0)
        line = Gtk.Box(spacing=8)
        self.status = label('', 'bk-note', wrap=True)
        line.pack_start(self.status, True, True, 0)
        self.run_btn = button('Sao lưu', self.on_run, accent=True)
        line.pack_end(self.run_btn, False, False, 0)
        self.restore_btn = button('Khôi phục…', lambda: self.show_page('restore'))
        line.pack_end(self.restore_btn, False, False, 0)
        bottom.pack_start(line, False, False, 0)
        page.pack_start(bottom, False, False, 0)
        return page

    def set_member(self, conf_key, key, on):
        sel = selection()
        cur = sel['folders' if conf_key == 'FOLDERS' else 'settings']
        order = [f[0] for f in FOLDERS] if conf_key == 'FOLDERS' else [s[0] for s in SETTINGS]
        new = [k for k in order if (k in cur and k != key) or (k == key and on)]
        conf_set(conf_key, ','.join(new))
        self.refresh()

    def places(self):
        """[(tên hiện, đường dẫn)] các ổ đang cắm ghi được."""
        out = []
        try:
            with open('/proc/mounts', encoding='utf-8') as f:
                for l in f:
                    p = l.split()[1].replace('\\040', ' ')
                    if p.startswith(('/media/', '/run/media/', '/mnt/')) and os.access(p, os.W_OK):
                        try:
                            free = human(shutil.disk_usage(p).free)
                        except OSError:
                            continue
                        out.append(('%s — còn trống %s' % (os.path.basename(p) or p, free), p))
        except OSError:
            pass
        return out

    def fill_places(self):
        old = self.dest_pop.get_child()
        if old:
            self.dest_pop.remove(old)
        col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)

        def item(text, cb):
            b = Gtk.Button()
            b.add(label(text))
            b.get_style_context().add_class('bk-item')
            b.connect('clicked', lambda *_: (self.dest_pop.popdown(), cb()))
            col.pack_start(b, False, False, 0)
        for name, path in self.places():
            item(name, lambda path=path: self.set_dest(path))
        item('Thư mục khác…', self.choose_folder)
        col.show_all()
        self.dest_pop.add(col)

    def choose_folder(self):
        dlg = Gtk.FileChooserNative.new('Chọn nơi lưu bản sao lưu', self, Gtk.FileChooserAction.SELECT_FOLDER,
                                        'Chọn', 'Huỷ')
        cur = conf_read().get('DEST', '')
        if cur and os.path.isdir(cur):
            dlg.set_current_folder(cur)
        if dlg.run() == Gtk.ResponseType.ACCEPT and dlg.get_filename():
            self.set_dest(dlg.get_filename())
        dlg.destroy()

    def set_dest(self, path):
        conf_set('DEST', path)
        self.refresh()

    def refresh(self):
        """Đọc lại cấu hình, tính dung lượng ở luồng phụ rồi cập nhật các dòng."""
        c, sel = conf_read(), selection()
        dest = c.get('DEST', '')
        last = c.get('LAST', '').split('|')
        self.hero_sub.set_text('%s · %s' % (socket.gethostname(), 'Lần sao lưu gần nhất: %s%s' % (
            last[0], ' (%s tệp lỗi)' % last[2] if last[2] != '0' else '') if len(last) == 3
            else 'Chưa sao lưu lần nào'))
        self.dest.sub.set_text(short(dest) if dest else 'Chưa chọn — cắm USB hoặc ổ ngoài, hoặc chọn '
                               'một thư mục')
        self.dest_btn.get_child().set_text('Đổi' if dest else 'Chọn nơi lưu')
        self.g_settings.sub.set_text(', '.join(s[1] for s in SETTINGS if s[0] in sel['settings']) or 'Không sao lưu')
        self.g_settings.value.set_text('Bật' if sel['settings'] else 'Tắt')
        self.g_apps.value.set_text('Bật' if sel['apps'] else 'Tắt')
        self.g_folders.value.set_text('%d thư mục' % len([k for k in sel['folders'] if k in self.folder_rows])
                                      if sel['folders'] else 'Tắt')
        if self.busy:
            return
        self.run_btn.set_sensitive(False)
        self.status.set_text('Đang tính dung lượng…')
        bg(lambda: estimate(dest, sel), lambda r: self.show_estimate(r, dest, sel))

    def show_estimate(self, est, dest, sel):
        if self.busy or isinstance(est, Exception):
            return
        self.est = est
        names = []
        for key, row in self.folder_rows.items():
            files, total, _need = est['folders'].get(key, (0, 0, 0))
            row.sub.set_text('%s · %d tệp, %s' % (user_dirs()[key].replace(HOME, '~', 1), files, human(total)))
            if key in sel['folders']:
                names.append(next(f[2] for f in FOLDERS if f[0] == key))
        self.g_folders.sub.set_text(', '.join(names) or 'Không sao lưu thư mục nào')
        self.status.get_style_context().remove_class('bk-bad')
        nothing = not (sel['folders'] or sel['apps'] or sel['settings'])
        if not dest:
            self.status.set_text('Chọn nơi lưu để bắt đầu.')
        elif not os.path.isdir(dest):
            self.status.set_text('Không thấy nơi lưu (ổ chưa cắm?).')
            self.status.get_style_context().add_class('bk-bad')
        elif nothing:
            self.status.set_text('Chưa bật nhóm nào để sao lưu.')
        elif est['free'] is not None and est['need'] + 20 * 1024 * 1024 > est['free']:
            self.status.set_text('Nơi lưu không đủ chỗ: cần chép %s, còn trống %s.' % (human(est['need']),
                                                                                       human(est['free'])))
            self.status.get_style_context().add_class('bk-bad')
        else:
            self.status.set_text('Cần chép %s%s' % (human(est['need']), ' · nơi lưu còn trống %s' % human(est['free'])
                                                    if est['free'] is not None else ''))
            self.run_btn.set_sensitive(True)
            return
        self.run_btn.set_sensitive(False)

    # ------------------------------------------------------------------ chạy sao lưu / khôi phục
    def start(self, work, done, stop_label_for):
        self.busy = True
        self.stop.clear()
        self.bar.set_fraction(0)
        self.bar.show()
        self.restore_btn.set_sensitive(False)
        self.run_btn.set_sensitive(True)
        self.run_btn.set_label('Dừng')
        self.run_btn.get_style_context().remove_class('accent')
        last = [0.0]

        def report(stage, d, t, what):
            now = time.monotonic()
            if stage == 'folders' and now - last[0] < 0.1:
                return
            last[0] = now

            def show():
                if stage == 'folders' and t:
                    self.bar.set_fraction(min(1.0, d / t))
                    self.status.set_text('%s / %s — %s' % (human(d), human(t), os.path.basename(what)))
                elif what:
                    self.status.set_text(what)
                return False
            GLib.idle_add(show)

        def finish(r):
            self.busy = False
            self.bar.hide()
            self.run_btn.set_label(stop_label_for)
            self.run_btn.get_style_context().add_class('accent')
            self.restore_btn.set_sensitive(True)
            done(r)
        bg(lambda: work(report), finish)

    def on_run(self):
        if self.busy:
            self.stop.set()
            self.status.set_text('Đang dừng…')
            return
        dest, sel = conf_read().get('DEST', ''), selection()
        self.start(lambda report: do_backup(dest, sel, report, self.stop), self.backup_done, 'Sao lưu')

    def start_when_ready(self, tries=40):
        """depot-backup start: chờ phần tính dung lượng xong (nút Sao lưu sáng lên) rồi chạy; không chạy được thì thôi."""
        if self.busy:
            return False
        if self.run_btn.get_sensitive() and self.est is not None:
            self.on_run()
        elif tries > 0 and self.status.get_text().startswith('Đang tính'):
            GLib.timeout_add(150, self.start_when_ready, tries - 1)
        return False

    def backup_done(self, r):
        self.refresh()
        if isinstance(r, Stop):
            self.message('Đã dừng. Các tệp chép xong vẫn nằm ở nơi lưu; lần sau sẽ chép tiếp phần còn lại.')
        elif isinstance(r, Exception):
            self.message('Sao lưu không thành: %s' % r, bad=True)
        else:
            n = len(r.get('error_list', []))
            where = short(backup_root(conf_read().get('DEST', '')))
            self.message('Đã sao lưu xong vào %s.' % where + (
                ' %d tệp không chép được (xem loi-lan-sao-luu-cuoi.txt trong thư mục đó).' % n if n else ''),
                bad=bool(n))

    def message(self, text, bad=False):
        def show():
            self.status.set_text(text)
            ctx = self.status.get_style_context()
            (ctx.add_class if bad else ctx.remove_class)('bk-bad')
            return False
        GLib.timeout_add(450, show)                  # sau khi refresh() ghi dòng "Cần chép…"

    # ------------------------------------------------------------------ trang Khôi phục
    def build_restore_page(self):
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        col.get_style_context().add_class('bk-page')
        col.pack_start(label('Khôi phục từ bản sao lưu', 'bk-hero-title'), False, False, 0)
        sub = label('Chọn một bản sao lưu. Thư mục được chép về (tệp ở máy mới hơn thì giữ nguyên); cài đặt đang có '
                    'được cất lại trước khi ghi đè.', 'bk-hero-sub', wrap=True)
        sub.set_margin_bottom(12)
        col.pack_start(sub, False, False, 0)
        self.backup_list = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        col.pack_start(self.backup_list, False, False, 0)
        self.r_only = {'folders': True, 'settings': True, 'apps': True}
        self.r_opts = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        self.r_opts.set_margin_top(10)
        for key, icon_name, title, desc in (
                ('folders', 'folder-symbolic', 'Thư mục', 'Chép các thư mục cá nhân trong bản sao lưu về máy này'),
                ('settings', 'preferences-system-symbolic', 'Cài đặt', 'Giao diện, panel, bộ gõ… — đăng xuất rồi đăng '
                 'nhập lại để áp dụng'),
                ('apps', 'view-app-grid-symbolic', 'Ứng dụng', 'So với máy này và cài lại những ứng dụng còn thiếu')):
            g = Group(icon_name, title, desc,
                      trailing=[switch(True, lambda on, key=key: self.r_only.__setitem__(key, on))])
            self.r_opts.pack_start(g.box, False, False, 0)
        col.pack_start(self.r_opts, False, False, 0)
        self.r_result = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        self.r_result.set_margin_top(12)
        col.pack_start(self.r_result, False, False, 0)
        page.pack_start(self.scrolled(col), True, True, 0)
        bottom = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        bottom.get_style_context().add_class('bk-bottom')
        self.r_bar = Gtk.ProgressBar()
        self.r_bar.set_no_show_all(True)
        bottom.pack_start(self.r_bar, False, False, 0)
        line = Gtk.Box(spacing=8)
        self.r_status = label('', 'bk-note', wrap=True)
        line.pack_start(self.r_status, True, True, 0)
        self.r_btn = button('Khôi phục', self.on_restore, accent=True)
        line.pack_end(self.r_btn, False, False, 0)
        line.pack_end(button('Tìm ở thư mục khác…', self.browse_backup), False, False, 0)
        bottom.pack_start(line, False, False, 0)
        page.pack_start(bottom, False, False, 0)
        self.r_root = None
        self.r_extra = []
        return page

    def fill_backups(self):
        for w in self.backup_list.get_children():
            self.backup_list.remove(w)
        found = find_backups(self.r_extra)
        group = None
        self.r_root = found[0][0] if found else None
        for root, m in found:
            what = []
            if m.get('folders'):
                what.append('%d thư mục (%s)' % (len(m['folders']), human(sum(f.get('bytes', 0)
                                                                         for f in m['folders'].values()))))
            if m.get('apps'):
                what.append('%d ứng dụng' % (m['apps'].get('apt', 0) + m['apps'].get('flatpak', 0)))
            if m.get('settings'):
                what.append('%d nhóm cài đặt' % len(m['settings']))
            radio = Gtk.RadioButton.new_from_widget(group)
            group = group or radio
            radio.set_active(root == self.r_root)
            radio.set_can_focus(False)
            radio.set_valign(Gtk.Align.CENTER)
            radio.connect('toggled', lambda r, root=root: r.get_active() and setattr(self, 'r_root', root))
            g = Group('drive-harddisk-symbolic', 'Máy "%s" — %s' % (m.get('host', '?'), m.get('time', '?')),
                      '%s · %s' % (short(root), ', '.join(what) or 'trống'), trailing=[radio])
            self.backup_list.pack_start(g.box, False, False, 0)
        if not found:
            self.backup_list.pack_start(label('Chưa thấy bản sao lưu nào ở nơi lưu đã chọn và các ổ đang cắm. Cắm ổ '
                                              'chứa thư mục "%s", hoặc bấm "Tìm ở thư mục khác…".' % ROOT_NAME,
                                              'bk-note', wrap=True), False, False, 0)
        self.backup_list.show_all()
        self.r_opts.set_visible(bool(found))
        self.r_btn.set_sensitive(bool(found))
        self.r_status.set_text('')

    def browse_backup(self):
        dlg = Gtk.FileChooserNative.new('Chọn thư mục chứa bản sao lưu', self, Gtk.FileChooserAction.SELECT_FOLDER,
                                        'Chọn', 'Huỷ')
        if dlg.run() == Gtk.ResponseType.ACCEPT and dlg.get_filename():
            self.r_extra.append(dlg.get_filename())
            self.fill_backups()
            if not find_backups([dlg.get_filename()]) or self.r_root is None:
                self.r_status.set_text('Thư mục đó không chứa bản sao lưu Depot.')
        dlg.destroy()

    def on_restore(self):
        if self.busy:
            self.stop.set()
            return
        root, only = self.r_root, tuple(k for k, on in self.r_only.items() if on)
        if not root or not only:
            self.r_status.set_text('Chọn một bản sao lưu và ít nhất một nhóm.')
            return
        for w in self.r_result.get_children():
            self.r_result.remove(w)
        # dùng chung start(): tạm trỏ thanh tiến độ / dòng trạng thái / nút sang trang này
        keep = (self.bar, self.status, self.run_btn, self.restore_btn)
        self.bar, self.status, self.run_btn, self.restore_btn = self.r_bar, self.r_status, self.r_btn, self.back

        def done(r):
            self.bar, self.status, self.run_btn, self.restore_btn = keep
            self.restore_done(r)
        self.start(lambda report: do_restore(root, only, report, self.stop), done, 'Khôi phục')

    def restore_done(self, r):
        if isinstance(r, Stop):
            self.r_status.set_text('Đã dừng.')
            return
        if isinstance(r, Exception):
            self.r_status.set_text('Khôi phục không thành: %s' % r)
            return
        self.r_status.set_text('Đã khôi phục xong.')
        lines = ['Thư mục: đã chép %d tệp về máy.' % r['folders']] if r['folders'] else []
        if r['settings']:
            lines.append('Cài đặt: %s. Bản đang có đã cất ở %s. Đăng xuất rồi đăng nhập lại để áp dụng.' % (
                ', '.join(r['settings']), short(r['saved'])))
        ok, unknown, flat = r['apps']
        if unknown:
            lines.append('Kho phần mềm của máy này không có: %s' % ', '.join(unknown[:30]) + ('…' if len(unknown) > 30 else ''))
        if flat:
            lines.append('App Flatpak còn thiếu (cài trong Phần mềm): %s' % ', '.join(flat))
        if r['errors']:
            lines.append('%d lỗi: %s' % (len(r['errors']), '; '.join(r['errors'][:3])))
        for text in lines:
            self.r_result.pack_start(label(text, 'bk-note', wrap=True), False, False, 0)
        if ok:
            g = Group('view-app-grid-symbolic', '%d ứng dụng còn thiếu' % len(ok),
                      ', '.join(ok[:8]) + ('…' if len(ok) > 8 else ''),
                      trailing=[button('Cài lại', lambda: self.install(ok))])
            self.r_result.pack_start(g.box, False, False, 0)
        elif 'apps' in self.r_only and self.r_only['apps'] and not unknown and not flat:
            self.r_result.pack_start(label('Ứng dụng: máy này đã có đủ các ứng dụng trong bản sao lưu.', 'bk-note'),
                                     False, False, 0)
        self.r_result.show_all()

    def install(self, pkgs):
        self.r_status.set_text('Đang cài %d ứng dụng… (hệ thống sẽ hỏi mật khẩu quản trị)' % len(pkgs))

        def work():
            return subprocess.run(['pkexec', 'apt-get', 'install', '-y'] + pkgs, stdin=subprocess.DEVNULL,
                                  capture_output=True, text=True).returncode
        bg(work, lambda rc: self.r_status.set_text('Đã cài xong.' if rc == 0 else 'Chưa cài được (huỷ hoặc lỗi mạng).'))


def conf_value_settings():
    """Chế độ màu dùng chung với app Cài đặt (THEME=system|dark|light trong ~/.config/depot/settings)."""
    try:
        with open(os.path.join(CONFIG, 'depot', 'settings'), encoding='utf-8') as f:
            for line in f:
                k, _, v = line.strip().partition('=')
                if k == 'THEME':
                    return v
    except OSError:
        pass
    return 'system'


class App(Gtk.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE)
        self.win = None

    def do_command_line(self, cl):
        args = cl.get_arguments()[1:]
        if self.win is None:
            self.win = Window(self)
        if args and args[0] == 'restore-page':
            self.win.show_page('restore')
        self.win.present()
        if args and args[0] == 'start' and not self.win.busy:
            self.win.show_page('backup')
            self.win.start_when_ready()
        if args and args[0] == '--shots' and len(args) > 1:      # chụp hai trang để soát giao diện rồi thoát
            self.shots(args[1])
        return 0

    def shots(self, outdir):
        os.makedirs(outdir, exist_ok=True)
        steps = [('backup', lambda: self.win.show_page('backup')),
                 ('backup-mo', lambda: (self.win.g_folders.toggle(), self.win.g_settings.toggle())),
                 ('restore', lambda: self.win.show_page('restore'))]
        state = {'i': -1}

        def step():
            if state['i'] >= 0:
                gw = self.win.get_window()
                pb = Gdk.pixbuf_get_from_window(gw, 0, 0, gw.get_width(), gw.get_height())
                if pb:
                    pb.savev(os.path.join(outdir, steps[state['i']][0] + '.png'), 'png', [], [])
            state['i'] += 1
            if state['i'] >= len(steps):
                self.win.destroy()
                return False
            steps[state['i']][1]()
            return True
        GLib.timeout_add(1500, step)


if __name__ == '__main__':
    sys.exit(App().run(sys.argv))
