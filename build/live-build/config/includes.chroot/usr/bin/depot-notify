def log(*a):
    if DEBUG:
        print('depot-notify:', *a, file=sys.stderr, flush=True)


def conf_get(key, default=''):
    try:
        with open(CONF, encoding='utf-8') as f:
            for line in f:
                k, _, v = line.strip().partition('=')
                if k == key:
                    return v
    except OSError:
        pass
    return default


def conf_set(key, value):
    lines = []
    try:
        with open(CONF, encoding='utf-8') as f:
            lines = [l.rstrip('\n') for l in f if l.split('=', 1)[0].strip() != key]
    except OSError:
        pass
    lines.append('%s=%s' % (key, value))
    try:
        os.makedirs(os.path.dirname(CONF), exist_ok=True)
        with open(CONF, 'w', encoding='utf-8') as f:
            f.write('\n'.join(lines) + '\n')
    except OSError:
        pass


def write_private(path, text):
    """Ghi file chỉ chủ phiên đọc được (thông báo có thể chứa nội dung tin nhắn)."""
    try:
        fd = os.open(path + '.tmp', os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, 'w', encoding='utf-8') as f:
            f.write(text)
        os.replace(path + '.tmp', path)
    except OSError as e:
        log('không ghi được', path, e)


def rrect(cr, x, y, w, h, r):
    r = max(0.0, min(r, w / 2, h / 2))
    cr.new_sub_path()
    cr.arc(x + w - r, y + r, r, -math.pi / 2, 0)
    cr.arc(x + w - r, y + h - r, r, 0, math.pi / 2)
    cr.arc(x + r, y + h - r, r, math.pi / 2, math.pi)
    cr.arc(x + r, y + r, r, math.pi, 3 * math.pi / 2)
    cr.close_path()


def ease_out(t):
    t = max(0.0, min(1.0, t))
    return 1 - (1 - t) ** 3


def ago(ts):
    d = time.time() - ts
    if d < 60:
        return 'vừa xong'
    if d < 3600:
        return '%d phút trước' % (d // 60)
    lt, now = time.localtime(ts), time.localtime()
    if (lt.tm_year, lt.tm_yday) == (now.tm_year, now.tm_yday):
        return time.strftime('%H:%M', lt)
    return time.strftime('%d/%m %H:%M', lt)


def safe_markup(text, limit=600):
    """Thân thông báo: cho phép <b> <i> <u> <a> theo chuẩn; sai cú pháp thì hiện như chữ thường."""
    text = re.sub(r'<img\b[^>]*>', '', text or '').strip()
    if len(text) > limit:
        text = text[:limit].rstrip() + '…'
        return html.escape(html.unescape(text), quote=False)
    if '<' not in text and '&' not in text:
        return text
    # dấu & trần ("A & B") rất hay gặp: coi là chữ, không để hỏng cả <b>, <i> của thông báo
    text = re.sub(r'&(?!(?:amp|lt|gt|quot|apos|#\d+|#x[0-9a-fA-F]+);)', '&amp;', text)
    try:
        Pango.parse_markup(text, -1, '\0')
        return text
    except GLib.Error:
        return html.escape(text, quote=False)


def workarea():
    disp = Gdk.Display.get_default()
    mon = disp.get_primary_monitor() or disp.get_monitor(0)
    wa, g = mon.get_workarea(), mon.get_geometry()
    if wa.width < 200 or wa.height < 200:          # không có WM (Xvfb): workarea rỗng
        wa = mon.get_geometry()
    if 'i3' in os.environ.get('XDG_CURRENT_DESKTOP', '').lower() and wa.y == g.y:
        wa.y += 30                                 # i3 không báo vùng làm việc: chừa i3bar ở trên
        wa.height -= 30
    return wa


class WinBase(Gtk.Window):
    """Cửa sổ nổi không qua trình quản lý cửa sổ (override-redirect): chạy giống nhau trên xfwm4, i3."""

    def __init__(self, radius, hint):
        super().__init__(type=Gtk.WindowType.POPUP)
        self.radius = radius
        self.set_type_hint(hint)
        self.set_app_paintable(True)
        self.set_resizable(False)
        self.get_style_context().add_class('depot-win')
        scr = self.get_screen()
        vis = scr.get_rgba_visual()
        if vis:
            self.set_visual(vis)
        self.connect('draw', self._clear)
        self.connect('size-allocate', lambda *_: self.round_shape())
        scr.connect('composited-changed', lambda *_: self.round_shape())
        self.anim_id = None

    def composited(self):
        scr = self.get_screen()
        return scr.is_composited() and scr.get_rgba_visual() is not None

    def anim_on(self):
        s = Gtk.Settings.get_default()
        return self.composited() and (s is None or s.get_property('gtk-enable-animations'))

    @staticmethod
    def _clear(_w, cr):
        cr.set_operator(cairo.OPERATOR_SOURCE)
        cr.set_source_rgba(0, 0, 0, 0)
        cr.paint()
        cr.set_operator(cairo.OPERATOR_OVER)
        return False

    def round_shape(self):
        """Không compositor thì không trong suốt được: cắt 4 góc tròn bằng shape X."""
        if not self.get_realized():
            return
        if self.composited():
            self.shape_combine_region(None)
            return
        w, h = self.get_allocated_width(), self.get_allocated_height()
        surf = cairo.ImageSurface(cairo.FORMAT_A1, max(1, w), max(1, h))
        cr = cairo.Context(surf)
        rrect(cr, 0, 0, w, h, self.radius)
        cr.fill()
        self.shape_combine_region(Gdk.cairo_region_create_from_surface(surf))

    def animate(self, step, done=None, duration=ANIM):
        """Gọi step(0..1 đã làm mượt) mỗi khung hình trong `duration` giây."""
        if self.anim_id is not None:
            GLib.source_remove(self.anim_id)
            self.anim_id = None
        if not self.anim_on():
            step(1.0)
            if done:
                done()
            return
        t0 = time.monotonic()

        def tick():
            t = (time.monotonic() - t0) / duration
            step(ease_out(t))
            if t >= 1.0:
                self.anim_id = None
                if done:
                    done()
                return False
            return True
        step(0.0)
        self.anim_id = GLib.timeout_add(16, tick)


class Card(Gtk.EventBox):
    """Một thông báo: icon, tên app · giờ, nút ×, tiêu đề, nội dung, nút hành động. Dùng cho thẻ nổi lẫn khung."""

    def __init__(self, app, n, in_sidebar):
        super().__init__()
        self.app, self.n = app, n
        self.set_visible_window(False)
        self.add_events(Gdk.EventMask.BUTTON_PRESS_MASK | Gdk.EventMask.BUTTON_RELEASE_MASK |
                        Gdk.EventMask.ENTER_NOTIFY_MASK | Gdk.EventMask.LEAVE_NOTIFY_MASK)
        self.box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        ctx = self.box.get_style_context()
        ctx.add_class('depot-card')
        if n['urgency'] >= 2:
            ctx.add_class('critical')
        self.add(self.box)

        img = self.icon(n, 36)
        img.set_valign(Gtk.Align.START)
        img.set_margin_top(2)
        self.box.pack_start(img, False, False, 0)

        col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        self.box.pack_start(col, True, True, 0)

        head = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        col.pack_start(head, False, False, 0)
        if in_sidebar and n.get('unread'):
            head.pack_start(self.label('●', 'depot-dot'), False, False, 0)
        name = self.label(n['app'] or 'Thông báo', 'depot-app', chars=22)
        head.pack_start(name, False, False, 0)
        if in_sidebar:
            head.pack_start(self.label('· ' + ago(n['time']), 'depot-time'), False, False, 0)
        close = Gtk.Button(label='✕')
        close.get_style_context().add_class('depot-close')
        close.set_relief(Gtk.ReliefStyle.NONE)
        close.set_can_focus(False)
        close.set_valign(Gtk.Align.START)
        close.connect('clicked', lambda _b: self.app.dismiss(self.n))
        head.pack_end(close, False, False, 0)

        if n['summary']:
            col.pack_start(self.label(n['summary'], 'depot-summary', chars=30, lines=2), False, False, 0)
        if n['body']:
            col.pack_start(self.label(safe_markup(n['body']), 'depot-body', chars=34,
                                      lines=6 if in_sidebar else 4, markup=True), False, False, 0)
        acts = [a for a in n['actions'] if a[0] != 'default'] if n['alive'] else []
        if acts:
            row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
            row.set_margin_top(8)
            for i, (key, text) in enumerate(acts[:3]):
                b = Gtk.Button(label=text)
                b.set_can_focus(False)
                b.set_relief(Gtk.ReliefStyle.NONE)
                c = b.get_style_context()
                c.add_class('depot-pill')
                if i == 0:
                    c.add_class('accent')
                b.connect('clicked', lambda _b, k=key: self.app.invoke(self.n, k))
                row.pack_start(b, False, False, 0)
            col.pack_start(row, False, False, 0)

        self.pressed = False
        self.connect('enter-notify-event', self.on_cross, True)
        self.connect('leave-notify-event', self.on_cross, False)
        self.connect('button-press-event', self.on_press)
        self.connect('button-release-event', self.on_release)
        self.on_hover = None       # thẻ nổi: dừng / chạy lại đồng hồ tự cất
        self.on_secondary = None   # thẻ nổi: chuột phải = cất vào khung

    @staticmethod
    def label(text, cls, chars=0, lines=1, markup=False):
        l = Gtk.Label(xalign=0)
        if markup:
            l.set_markup(text)
        else:
            l.set_text(text)
        l.get_style_context().add_class(cls)
        if chars:
            l.set_max_width_chars(chars)
            l.set_ellipsize(Pango.EllipsizeMode.END)
        if lines > 1:
            l.set_line_wrap(True)
            l.set_line_wrap_mode(Pango.WrapMode.WORD_CHAR)
            l.set_lines(lines)
        return l

    def icon(self, n, size):
        img = Gtk.Image()
        pix = n.get('pix')
        src = n.get('icon') or ''
        if pix is None and src.startswith('file://'):
            try:
                src = GLib.filename_from_uri(src)[0]
            except GLib.Error:
                src = ''
        if pix is None and src.startswith('/'):
            try:
                pix = GdkPixbuf.Pixbuf.new_from_file_at_scale(src, size, size, True)
            except GLib.Error:
                src = ''
        if pix is not None:
            if pix.get_width() != size or pix.get_height() != size:
                k = size / max(pix.get_width(), pix.get_height())
                pix = pix.scale_simple(max(1, int(pix.get_width() * k)), max(1, int(pix.get_height() * k)),
                                       GdkPixbuf.InterpType.BILINEAR)
            img.set_from_pixbuf(pix)
            return img
        theme = Gtk.IconTheme.get_default()
        for name in (src, 'dialog-warning' if n['urgency'] >= 2 else '', 'preferences-system-notifications',
                     'dialog-information'):
            if name and theme.has_icon(name):
                img.set_from_icon_name(name, Gtk.IconSize.DND)
                break
        img.set_pixel_size(size)
        return img

    def flag(self, f, on):
        if on:
            self.box.set_state_flags(f, False)
        else:
            self.box.unset_state_flags(f)

    def on_cross(self, _w, e, entered):
        if e.detail == Gdk.NotifyType.INFERIOR:     # qua lại nút × bên trong: vẫn là đang ở trên thẻ
            return False
        self.flag(Gtk.StateFlags.PRELIGHT, entered)
        if not entered:
            self.pressed = False
            self.flag(Gtk.StateFlags.ACTIVE, False)
        if self.on_hover:
            self.on_hover(entered)
        return False

    def on_press(self, _w, e):
        if e.type != Gdk.EventType.BUTTON_PRESS:
            return False
        if e.button == 1:
            self.pressed = True
            self.flag(Gtk.StateFlags.ACTIVE, True)
        return True

    def on_release(self, _w, e):
        self.flag(Gtk.StateFlags.ACTIVE, False)
        was, self.pressed = self.pressed, False
        a = self.get_allocation()
        inside = 0 <= e.x <= a.width and 0 <= e.y <= a.height
        if e.button == 1 and was and inside:
            self.app.activate_note(self.n)
        elif e.button == 3 and inside and self.on_secondary:
            self.on_secondary()
        return True


class Toast(WinBase):
    def __init__(self, app, n):
        super().__init__(TOAST_RADIUS, Gdk.WindowTypeHint.NOTIFICATION)
        self.app, self.n = app, n
        self.set_title('Depot Thông báo')
        self.timer = None
        self.closing = False
        self.pos = (0, 0)
        self.alpha = 0.0
        self.card = Card(app, n, False)
        self.card.on_hover = self.hovered
        self.card.on_secondary = lambda: app.stash(n)
        self.add(self.card)
        self.set_size_request(TOAST_W, -1)
        self.card.show_all()
        self.height = self.card.get_preferred_height_for_width(TOAST_W)[1]
        self.resize(TOAST_W, self.height)
        self.remaining = self.lifetime()
        self.t_start = time.monotonic()

    def lifetime(self):
        """Giây thẻ nằm trên màn hình; None = tới khi người dùng tắt (thông báo khẩn)."""
        ms = self.n['timeout']
        if self.n['urgency'] >= 2 and ms <= 0:
            return None
        if ms < 0:
            return DEFAULT_TIMEOUT
        if ms == 0:
            return 10.0                    # app xin "không bao giờ tắt": cất vào khung sau 10 giây
        return max(2.0, min(MAX_TIMEOUT, ms / 1000.0))

    def appear(self, x, y):
        self.pos = (x, y)
        self.move(x + 24, y)
        self.show()
        self.round_shape()

        def step(k):
            self.move(int(x + 24 * (1 - k)), y)
            self.fade(k)
        self.animate(step)
        self.arm()

    def fade(self, a):
        self.alpha = a
        if self.composited():
            Gtk.Widget.set_opacity(self, a)

    def glide(self, x, y):
        x0, y0 = self.pos
        self.pos = (x, y)
        if (x0, y0) == (x, y) or self.closing:
            return
        a0 = self.alpha          # đang hiện dở mà phải dời chỗ: hiện cho xong luôn

        def step(k):
            self.move(int(x0 + (x - x0) * k), int(y0 + (y - y0) * k))
            self.fade(a0 + (1 - a0) * k)
        self.animate(step)

    def arm(self):
        self.disarm()
        if self.remaining is not None:
            self.t_start = time.monotonic()
            self.timer = GLib.timeout_add(int(self.remaining * 1000), self.expired)

    def disarm(self):
        if self.timer is not None:
            GLib.source_remove(self.timer)
            self.timer = None

    def hovered(self, entered):
        if self.closing or self.remaining is None:
            return
        if entered:
            self.remaining = max(2.0, self.remaining - (time.monotonic() - self.t_start))
            self.disarm()
        else:
            self.arm()

    def expired(self):
        self.timer = None
        self.app.toast_expired(self.n)
        return False

    def vanish(self):
        if self.closing:
            return
        self.closing = True
        self.disarm()
        x, y = self.pos

        a0 = self.alpha

        def step(k):
            self.move(int(x + 24 * k), y)
            self.fade(a0 * (1 - k))
        self.animate(step, self.destroy, duration=ANIM * 0.7)


class Sidebar(WinBase):
    """Sidebar Container: khung Thông báo ở mép phải, bo 4 góc, trượt vào 0,3 giây."""

    def __init__(self, app):
        super().__init__(SIDE_RADIUS, Gdk.WindowTypeHint.DOCK)
        self.app = app
        self.set_title('Depot Khung thông báo')
        self.is_open = False
        self.grabbed = False
        self.geom = (0, 0, SIDE_W, 400)
        self.add_events(Gdk.EventMask.BUTTON_PRESS_MASK | Gdk.EventMask.KEY_PRESS_MASK)
        self.connect('button-press-event', self.on_button)
        self.connect('key-press-event', self.on_key)
        self.connect('grab-broken-event', self.on_grab_broken)

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        root.get_style_context().add_class('depot-sidebar')
        self.add(root)

        head = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        root.pack_start(head, False, False, 0)
        tcol = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        tcol.pack_start(Card.label('Thông báo', 'depot-title'), False, False, 0)
        self.count = Card.label('', 'depot-count')
        tcol.pack_start(self.count, False, False, 0)
        head.pack_start(tcol, True, True, 0)
        self.clear_btn = self.button('Xoá hết', 'depot-pill', app.clear)
        head.pack_start(self.clear_btn, False, False, 0)
        head.pack_start(self.button('›', 'depot-close', self.close), False, False, 0)
        for b in head.get_children()[1:]:
            b.set_valign(Gtk.Align.CENTER)

        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        row.get_style_context().add_class('depot-row')
        rcol = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
        rcol.pack_start(Card.label('Không làm phiền', 'depot-summary'), False, False, 0)
        rcol.pack_start(Card.label('Thông báo chỉ vào khung này, không hiện lên màn hình', 'depot-hint',
                                   chars=40, lines=2), False, False, 0)
        row.pack_start(rcol, True, True, 0)
        self.dnd = Gtk.Switch()
        self.dnd.set_can_focus(False)
        self.dnd.set_valign(Gtk.Align.CENTER)
        self.dnd.set_active(app.dnd)
        self.dnd_handler = self.dnd.connect('notify::active', lambda s, _p: app.set_dnd(s.get_active()))
        row.pack_start(self.dnd, False, False, 0)
        root.pack_start(row, False, False, 0)

        self.stack = Gtk.Stack()
        self.stack.set_transition_type(Gtk.StackTransitionType.CROSSFADE)
        self.stack.set_transition_duration(int(ANIM * 1000))
        root.pack_start(self.stack, True, True, 0)
        sw = Gtk.ScrolledWindow()
        sw.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        sw.set_overlay_scrolling(True)
        self.list = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        sw.add(self.list)
        self.stack.add_named(sw, 'list')
        empty = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        empty.set_valign(Gtk.Align.CENTER)
        bell = Gtk.Image.new_from_icon_name('notification-symbolic', Gtk.IconSize.DIALOG)
        bell.set_pixel_size(56)
        bell.set_opacity(0.35)
        empty.pack_start(bell, False, False, 0)
        lab = Card.label('Chưa có thông báo nào', 'depot-empty')
        lab.set_xalign(0.5)
        empty.pack_start(lab, False, False, 0)
        self.stack.add_named(empty, 'empty')
        root.show_all()

    @staticmethod
    def button(text, cls, cb):
        # không gắn tooltip: cửa sổ tooltip đè lên chính thẻ / khung đang xem
        b = Gtk.Button(label=text)
        b.set_relief(Gtk.ReliefStyle.NONE)
        b.set_can_focus(False)
        b.get_style_context().add_class(cls)
        b.connect('clicked', lambda _b: cb())
        return b

    def refresh(self):
        for c in self.list.get_children():
            self.list.remove(c)
        notes = self.app.notes
        for n in reversed(notes):
            c = Card(self.app, n, True)
            c.show_all()
            self.list.pack_start(c, False, False, 0)
        self.stack.set_visible_child_name('list' if notes else 'empty')
        self.clear_btn.set_sensitive(bool(notes))
        self.clear_btn.set_opacity(1.0 if notes else 0.4)
        unread = sum(1 for n in notes if n.get('unread'))
        if not notes:
            self.count.set_text('Không có thông báo')
        elif unread:
            self.count.set_text('%d thông báo · %d mới' % (len(notes), unread))
        else:
            self.count.set_text('%d thông báo' % len(notes))
        self.dnd.handler_block(self.dnd_handler)
        self.dnd.set_active(self.app.dnd)
        self.dnd.handler_unblock(self.dnd_handler)

    def place(self):
        wa = workarea()
        h = wa.height - 2 * SIDE_MARGIN
        self.geom = (wa.x + wa.width - SIDE_W - SIDE_MARGIN, wa.y + SIDE_MARGIN, SIDE_W, h)
        self.set_size_request(SIDE_W, h)
        self.resize(SIDE_W, h)
        return wa

    def open(self):
        if self.is_open:
            return
        self.is_open = True
        self.app.stash_all()                 # thẻ nổi đang hiện: vào khung hết, khỏi nằm đè dưới khung
        self.refresh()
        wa = self.place()
        x, y, _w, _h = self.geom
        off = wa.x + wa.width + 4 - x          # trượt từ ngoài mép phải vào
        self.move(x + (off if self.anim_on() else 0), y)
        self.show()
        self.round_shape()

        def step(k):
            self.move(int(x + off * (1 - k)), y)
            if self.composited():
                Gtk.Widget.set_opacity(self, 0.3 + 0.7 * k)
        self.animate(step)
        self.grab(12)

    def close(self):
        if not self.is_open:
            return
        self.is_open = False
        self.ungrab()
        self.app.mark_read()
        self.app.layout()
        wa = workarea()
        x, y, _w, _h = self.geom
        off = wa.x + wa.width + 4 - x

        def step(k):
            self.move(int(x + off * k), y)
            if self.composited():
                Gtk.Widget.set_opacity(self, 1 - 0.7 * k)
        self.animate(step, self.hide, duration=ANIM * 0.8)

    # Giữ chuột + bàn phím như một menu: bấm ra ngoài hoặc Esc là đóng, không cần focus của trình quản lý cửa sổ.
    def grab(self, tries):
        if not self.is_open or self.grabbed:
            return False
        seat = Gdk.Display.get_default().get_default_seat()
        st = seat.grab(self.get_window(), Gdk.SeatCapabilities.ALL, True, None, None, None)
        if st == Gdk.GrabStatus.SUCCESS:
            self.grabbed = True
        elif tries > 0:      # phím tắt còn đang giữ bàn phím, hoặc panel chưa nhả chuột: thử lại
            GLib.timeout_add(120, self.grab, tries - 1)
        else:
            log('không giữ được chuột/bàn phím:', st, '— đóng bằng nút › hoặc bấm chuông')
        return False

    def ungrab(self):
        if self.grabbed:
            Gdk.Display.get_default().get_default_seat().ungrab()
            self.grabbed = False

    def on_grab_broken(self, _w, _e):
        self.grabbed = False
        return False

    def on_button(self, _w, e):
        x, y, w, h = self.geom
        if not (x <= e.x_root <= x + w and y <= e.y_root <= y + h):
            self.close()
            return True
        return False

    def on_key(self, _w, e):
        if e.keyval == Gdk.KEY_Escape:
            self.close()
            return True
        return False


class LockOSD(WinBase):
    """Ô báo Caps Lock: ổ khoá đóng + chữ A khi bật, ổ khoá mở + chữ a khi tắt. Vẽ bằng cairo, không cần icon."""

    def __init__(self):
        super().__init__(OSD_RADIUS, Gdk.WindowTypeHint.NOTIFICATION)
        self.set_title('Depot Caps Lock')
        self.on = False
        self.alpha = 0.0
        self.hide_id = None
        area = Gtk.DrawingArea()
        area.set_size_request(OSD, OSD)
        area.connect('draw', self.paint)
        self.add(area)
        area.show()

    def paint(self, _w, cr):
        s = OSD
        rrect(cr, 0.5, 0.5, s - 1, s - 1, OSD_RADIUS)
        cr.set_source_rgba(0.03, 0.03, 0.045, 0.90 if self.composited() else 1.0)
        cr.fill_preserve()
        cr.set_source_rgba(1, 1, 1, 0.10)
        cr.set_line_width(1)
        cr.stroke()
        cx = s / 2
        bw, bh, by = 62, 48, 62             # thân ổ khoá
        r, lw = 19, 11                      # quai khoá
        cr.set_source_rgba(1, 1, 1, 0.96)
        cr.set_line_width(lw)
        cr.set_line_cap(cairo.LINE_CAP_BUTT)
        if self.on:                         # quai cắm cả hai chân vào thân
            top = by - 10
            cr.move_to(cx - r, by + 4)
            cr.line_to(cx - r, top)
            cr.arc(cx, top, r, math.pi, 2 * math.pi)
            cr.line_to(cx + r, by + 4)
        else:                               # quai nhấc lên, chân phải hở ra
            top = by - 22
            cr.move_to(cx - r, by + 4)
            cr.line_to(cx - r, top)
            cr.arc(cx, top, r, math.pi, 2 * math.pi)
            cr.line_to(cx + r, top + 9)
        cr.stroke()
        rrect(cr, cx - bw / 2, by, bw, bh, 9)
        cr.fill()
        lay = self.create_pango_layout('A' if self.on else 'a')
        lay.set_font_description(Pango.FontDescription('Inter Bold 25'))
        tw, th = lay.get_pixel_size()
        cr.set_source_rgba(0.03, 0.03, 0.045, 1)
        cr.move_to(cx - tw / 2, by + (bh - th) / 2)
        PangoCairo.show_layout(cr, lay)
        return True

    def fade(self, a):
        self.alpha = a
        if self.composited():
            Gtk.Widget.set_opacity(self, a)

    def flash(self, on):
        self.on = on
        wa = workarea()
        self.resize(OSD, OSD)
        self.move(wa.x + (wa.width - OSD) // 2, wa.y + 48)      # ngay dưới viên Dynamic Island
        if self.hide_id is not None:
            GLib.source_remove(self.hide_id)
        if not self.get_visible():
            self.alpha = 0.0
            self.show()
            self.round_shape()
            self.input_shape_combine_region(cairo.Region())      # chuột bấm xuyên qua ô báo
        self.queue_draw()
        a0 = self.alpha
        self.animate(lambda k: self.fade(a0 + (1 - a0) * k), duration=ANIM / 2)
        self.hide_id = GLib.timeout_add(int(OSD_HOLD * 1000), self.fade_out)

    def fade_out(self):
        self.hide_id = None
        a0 = self.alpha
        self.animate(lambda k: self.fade(a0 * (1 - k)), self.hide)
        return False


class Notify(Gtk.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE)
        self.notes = []          # cũ → mới
        self.toasts = []         # trên → dưới
        self.next_id = 1
        self.uid = 0
        self.daemon = False
        self.sidebar = None
        self.dnd = conf_get('DND') == '1'
        self.save_id = None
        self.state_id = None
        self.genmon = None       # id plugin genmon chạy depot-notify-bell
        self.conn = None

    # ---------------------------------------------------------------- khởi động
    def do_startup(self):
        Gtk.Application.do_startup(self)
        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGTERM, self.on_term)
        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGINT, self.on_term)

    def on_term(self):
        self.flush()
        self.quit()
        return False

    def start_daemon(self):
        if self.daemon:
            return
        self.daemon = True
        self.hold()
        prov = Gtk.CssProvider()
        prov.load_from_data(CSS.encode())
        Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), prov,
                                                 Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION + 10)
        self.load()
        self.sidebar = Sidebar(self)
        # Caps Lock: X báo qua XKB mỗi khi đèn khoá đổi, không cần cửa sổ nào của mình đang được chọn
        self.osd = LockOSD()
        self.keymap = Gdk.Keymap.get_for_display(Gdk.Display.get_default())
        self.caps = self.keymap.get_caps_lock_state()
        self.keymap.connect('state-changed', self.on_keymap)
        self.conn = self.get_dbus_connection()
        node = Gio.DBusNodeInfo.new_for_xml(IFACE_XML)
        self.conn.register_object(BUS_PATH, node.interfaces[0], self.on_call, None, None)
        Gio.bus_own_name_on_connection(
            self.conn, BUS_NAME,
            Gio.BusNameOwnerFlags.ALLOW_REPLACEMENT | Gio.BusNameOwnerFlags.REPLACE,
            lambda *_: log('đã nhận', BUS_NAME), self.name_lost)
        Gdk.Screen.get_default().connect('monitors-changed', lambda *_: self.layout())
        self.write_state()
        GLib.timeout_add_seconds(3, self.find_genmon)

    def on_keymap(self, keymap):
        caps = keymap.get_caps_lock_state()
        if caps != self.caps:
            self.caps = caps
            if conf_get('CAPS_OSD', '1') != '0':
                self.osd.flash(caps)

    def name_lost(self, conn, _name):
        """Trình thông báo khác đang giữ tên: bảo nó nghỉ (xfce4-notifyd, dunst), mình đã xếp hàng nhận tên."""
        if conn is None:                     # mất kết nối D-Bus (đang đăng xuất)
            return
        try:
            owner = conn.call_sync('org.freedesktop.DBus', '/org/freedesktop/DBus', 'org.freedesktop.DBus',
                                   'GetNameOwner', GLib.Variant('(s)', (BUS_NAME,)), None,
                                   Gio.DBusCallFlags.NONE, 1000, None).unpack()[0]
            if owner == conn.get_unique_name():
                return
            pid = conn.call_sync('org.freedesktop.DBus', '/org/freedesktop/DBus', 'org.freedesktop.DBus',
                                 'GetConnectionUnixProcessID', GLib.Variant('(s)', (owner,)), None,
                                 Gio.DBusCallFlags.NONE, 1000, None).unpack()[0]
            with open('/proc/%d/comm' % pid, encoding='utf-8') as f:
                comm = f.read().strip()
        except (GLib.Error, OSError):
            return
        if comm.startswith(OTHER_DAEMONS) and pid != os.getpid():
            log('dừng', comm, pid)
            try:
                os.kill(pid, signal.SIGTERM)
            except OSError:
                pass
        else:
            log(BUS_NAME, 'đang thuộc về', comm, '— chờ tới lượt')

    def do_command_line(self, cl):
        args = cl.get_arguments()[1:]
        cmd = args[0] if args else ''
        remote = cl.get_is_remote()
        if cmd in ('-h', '--help', 'help'):
            cl.print_literal('dùng: depot-notify [toggle|show|hide|clear|dnd on|off|toggle|status|quit]\n')
            return 0
        if cmd == 'quit':
            if self.daemon:
                self.flush()
                GLib.idle_add(self.quit)
            return 0
        if cmd == 'status' and not self.daemon:
            cl.print_literal('depot-notify chưa chạy\n')
            return 1
        if cmd not in ('', 'toggle', 'show', 'hide', 'clear', 'dnd', 'status'):
            cl.printerr_literal('depot-notify: không hiểu "%s" (thử: depot-notify help)\n' % cmd)
            return 2
        self.start_daemon()
        if cmd == 'toggle':
            self.sidebar.close() if self.sidebar.is_open else self.sidebar.open()
        elif cmd == 'show':
            self.sidebar.open()
        elif cmd == 'hide':
            self.sidebar.close()
        elif cmd == 'clear':
            self.clear()
        elif cmd == 'dnd':
            how = args[1] if len(args) > 1 else 'toggle'
            self.set_dnd(not self.dnd if how == 'toggle' else how == 'on')
        elif cmd == 'status':
            unread = sum(1 for n in self.notes if n.get('unread'))
            cl.print_literal('Thông báo: %d (mới: %d)\nKhông làm phiền: %s\nCaps Lock: %s\nKhung bên cạnh: %s\n' % (
                len(self.notes), unread, 'bật' if self.dnd else 'tắt', 'bật' if self.caps else 'tắt',
                'đang mở' if self.sidebar.is_open else 'đóng'))
        elif not remote:
            log('chạy nền')
        return 0

    # ---------------------------------------------------------------- D-Bus
    def on_call(self, _conn, sender, _path, _iface, method, params, inv):
        if method == 'GetCapabilities':
            inv.return_value(GLib.Variant('(as)', (['body', 'body-markup', 'body-hyperlinks', 'actions',
                                                    'icon-static', 'persistence'],)))
        elif method == 'GetServerInformation':
            inv.return_value(GLib.Variant('(ssss)', ('depot-notify', 'Depot OS', '1.0', '1.2')))
        elif method == 'CloseNotification':
            n = self.by_id(params.unpack()[0])
            inv.return_value(None)
            if n:
                self.remove(n, 3)
        elif method == 'Notify':
            try:
                nid = self.on_notify(sender, params)
            except Exception as e:          # một thông báo lỗi định dạng không được làm chết trình thông báo
                log('Notify lỗi:', repr(e))
                nid = self.new_id()
            inv.return_value(GLib.Variant('(u)', (nid,)))
        else:
            inv.return_dbus_error('org.freedesktop.DBus.Error.UnknownMethod', method)

    def new_id(self):
        nid = self.next_id
        self.next_id = nid + 1 if nid < 0xfffffff0 else 1
        return nid

    def by_id(self, nid):
        for n in self.notes:
            if n['alive'] and n['id'] == nid:
                return n
        for t in self.toasts:                 # thông báo tạm (transient) chỉ có thẻ nổi
            if t.n['alive'] and t.n['id'] == nid:
                return t.n
        return None

    @staticmethod
    def hint(hints, *keys):
        for k in keys:
            v = hints.lookup_value(k, None)
            if v is not None:
                return v
        return None

    def on_notify(self, sender, params):
        app_name, replaces, app_icon, summary, body = (params.get_child_value(i).unpack() for i in range(5))
        actions = params.get_child_value(5).unpack()
        hints = params.get_child_value(6)
        timeout = params.get_child_value(7).unpack()

        def h(default, *keys):
            v = self.hint(hints, *keys)
            try:
                return default if v is None else v.unpack()
            except Exception:
                return default

        urgency = h(1, 'urgency')
        urgency = urgency if isinstance(urgency, int) and 0 <= urgency <= 2 else 1
        desktop = h('', 'desktop-entry')
        icon = h('', 'image-path', 'image_path') or app_icon
        name = app_name.strip()
        if desktop and (not name or not icon):
            try:
                info = Gio.DesktopAppInfo.new(desktop if desktop.endswith('.desktop') else desktop + '.desktop')
                if info:
                    name = name or info.get_name()
                    if not icon and info.get_icon():
                        icon = info.get_icon().to_string()
            except TypeError:
                pass
        if name in ('notify-send', ''):
            name = 'Hệ thống'

        # để bấm vào thông báo thì mở lại đúng app / trang web: nhớ file .desktop app tự khai, tên chương trình gửi,
        # và địa chỉ web đầu tiên có trong nội dung
        m = URL_RE.search(body) or URL_RE.search(summary)
        url = m.group(0).rstrip('.,;:!?)') if m else ''

        old = self.by_id(replaces) if replaces else None
        n = old or {'uid': self.next_uid(), 'id': self.new_id()}
        n.update({
            'desktop': desktop, 'exe': self.sender_exe(sender), 'url': url,
            'app': name, 'summary': summary.strip(), 'body': body, 'icon': icon, 'pix': self.image(hints),
            'time': time.time(), 'urgency': urgency, 'timeout': timeout, 'sender': sender, 'alive': True,
            'actions': list(zip(actions[0::2], actions[1::2])),
            'transient': bool(h(False, 'transient')), 'resident': bool(h(False, 'resident')),
            'unread': True,
        })
        log('Notify', n['id'], name, '|', n['summary'], '| hành động:', [a[0] for a in n['actions']])
        if old:
            self.drop_toast(n, instant=True)
        if not n['transient']:
            if n in self.notes:
                self.notes.remove(n)
            self.notes.append(n)
            for extra in self.notes[:-KEEP]:
                self.remove(extra, 1)
        if self.sidebar.is_open:
            n['unread'] = False              # khung đang mở: thấy ngay trong khung, không cần thẻ nổi
            if n['transient']:
                self.show_toast(n)
        elif not self.dnd or urgency >= 2:
            self.show_toast(n)
        elif n['transient']:
            self.emit_closed(n, 1)           # Không làm phiền: thông báo tạm bỏ luôn
        self.changed()
        return n['id']

    @staticmethod
    def image(hints):
        v = Notify.hint(hints, 'image-data', 'image_data', 'icon_data')
        if v is None:
            return None
        try:
            w, h, stride, alpha, bits, _ch = (v.get_child_value(i).unpack() for i in range(6))
            data = v.get_child_value(6).get_data_as_bytes()
            if w <= 0 or h <= 0 or w > 4096 or h > 4096 or data.get_size() < (h - 1) * stride + w * (4 if alpha else 3):
                return None
            pix = GdkPixbuf.Pixbuf.new_from_bytes(data, GdkPixbuf.Colorspace.RGB, alpha, bits, w, h, stride)
            k = 72 / max(w, h)
            return pix.scale_simple(max(1, int(w * k)), max(1, int(h * k)), GdkPixbuf.InterpType.BILINEAR) \
                if k < 1 else pix
        except Exception as e:
            log('ảnh trong thông báo lỗi:', repr(e))
            return None

    def next_uid(self):
        self.uid += 1
        return self.uid

    def emit(self, n, signal_name, variant):
        if not self.conn:
            return
        try:
            self.conn.emit_signal(n.get('sender'), BUS_PATH, BUS_NAME, signal_name, variant)
        except GLib.Error as e:
            log('không gửi được', signal_name, e.message)

    def emit_closed(self, n, reason):
        if n['alive']:
            n['alive'] = False
            self.emit(n, 'NotificationClosed', GLib.Variant('(uu)', (n['id'], reason)))

    # ---------------------------------------------------------------- hành động của người dùng
    def invoke(self, n, key):
        """Bấm nút hành động (hoặc bấm vào thẻ = hành động 'default')."""
        if n['alive']:
            log('ActionInvoked', n['id'], key)
            self.emit(n, 'ActionInvoked', GLib.Variant('(us)', (n['id'], key)))
            if n['resident']:
                self.drop_toast(n)
                return
        self.remove(n, 2)
        if self.sidebar.is_open:
            self.sidebar.close()

    def activate_note(self, n):
        """Bấm vào thông báo (thẻ nổi hoặc trong khung): mở app / trang web đã gửi nó, rồi tắt thông báo."""
        has_default = n['alive'] and any(k == 'default' for k, _t in n['actions'])
        if has_default:
            self.invoke(n, 'default')        # app còn chờ: để chính nó mở đúng chỗ (tab, cuộc trò chuyện…)
        elif self.open_source(n):
            self.remove(n, 2)
            if self.sidebar.is_open:
                self.sidebar.close()
        elif self.toast_of(n):
            self.remove(n, 2)                # không biết mở gì (thông báo của script): bấm thẻ nổi = đã xem, tắt
        # trong khung: thẻ không mở được gì thì bấm không làm gì (tắt bằng ✕)

    def sender_exe(self, sender):
        """Tên chương trình đã gửi thông báo; rỗng nếu chỉ là lệnh trung gian (notify-send, script)."""
        try:
            pid = self.conn.call_sync('org.freedesktop.DBus', '/org/freedesktop/DBus', 'org.freedesktop.DBus',
                                      'GetConnectionUnixProcessID', GLib.Variant('(s)', (sender,)), None,
                                      Gio.DBusCallFlags.NONE, 500, None).unpack()[0]
            exe = os.path.basename(os.readlink('/proc/%d/exe' % pid))
        except (GLib.Error, OSError):
            return ''
        return '' if exe in GENERIC_SENDERS or exe.startswith('python') else exe

    def find_app(self, n):
        """File .desktop của app đã gửi thông báo: app tự khai (desktop-entry) → tên chương trình → tên hiển thị."""
        d = n.get('desktop') or ''
        for cand in (d, d + '.desktop'):
            if cand.endswith('.desktop'):
                try:
                    info = Gio.DesktopAppInfo.new(cand)
                    if info:
                        return info
                except TypeError:
                    pass
        exe = (n.get('exe') or '').lower()
        name = (n.get('app') or '').strip().lower()
        if name == 'hệ thống':
            name = ''
        if not exe and not name:
            return None
        second = None
        for info in Gio.AppInfo.get_all():
            try:
                if info.get_nodisplay():
                    continue
                idn = (info.get_id() or '').lower()
                idn = idn[:-8] if idn.endswith('.desktop') else idn
                keys = (os.path.basename(info.get_executable() or '').lower(),
                        (info.get_startup_wm_class() or '').lower(), idn, idn.rsplit('.', 1)[-1])
            except AttributeError:
                continue
            if exe and exe in keys:
                return info
            if name and second is None and name in keys + ((info.get_name() or '').lower(),):
                second = info
        return second

    def open_source(self, n):
        """Mở app đã gửi thông báo; không tìm ra app mà nội dung có địa chỉ web thì mở trang đó."""
        ctx = Gdk.Display.get_default().get_app_launch_context()
        info = self.find_app(n)
        try:
            if info:
                log('mở app', info.get_id())
                return bool(info.launch([], ctx))
            if n.get('url'):
                log('mở web', n['url'])
                return bool(Gio.AppInfo.launch_default_for_uri(n['url'], ctx))
        except GLib.Error as e:
            log('không mở được:', e.message)
        return False

    def dismiss(self, n):
        self.remove(n, 2)

    def stash(self, n):
        """Cất thẻ nổi vào khung (chuột phải); thông báo tạm thì tắt hẳn."""
        if n['transient']:
            self.remove(n, 2)
        else:
            self.drop_toast(n)

    def stash_all(self):
        for t in list(self.toasts):
            if not t.closing:
                self.toast_expired(t.n)
        self.layout()

    def toast_expired(self, n):
        if n['transient']:
            self.remove(n, 1)
        else:
            self.drop_toast(n)               # vẫn nằm trong khung, nút hành động còn dùng được

    def remove(self, n, reason):
        self.emit_closed(n, reason)
        self.drop_toast(n)
        if n in self.notes:
            self.notes.remove(n)
        self.changed()

    def clear(self):
        for n in list(self.notes):
            self.emit_closed(n, 2)
            self.drop_toast(n)
        self.notes = []
        self.changed()

    def mark_read(self):
        if any(n.get('unread') for n in self.notes):
            for n in self.notes:
                n['unread'] = False
            self.changed()

    def set_dnd(self, on):
        on = bool(on)
        if on == self.dnd:
            return
        self.dnd = on
        conf_set('DND', '1' if on else '0')
        if on:
            for t in list(self.toasts):
                if t.n['urgency'] < 2:
                    self.toast_expired(t.n)
        self.changed()

    # ---------------------------------------------------------------- thẻ nổi
    def toast_of(self, n):
        for t in self.toasts:
            if t.n is n and not t.closing:
                return t
        return None

    def show_toast(self, n):
        live = [t for t in self.toasts if not t.closing]
        while len(live) >= TOAST_MAX:        # quá nhiều: thẻ cũ nhất (không khẩn) vào khung
            old = next((t for t in live if t.n['urgency'] < 2), live[0])
            self.toast_expired(old.n)
            live.remove(old)
        t = Toast(self, n)
        self.toasts.append(t)
        x, y = self.layout(skip=t)
        t.appear(x, y)

    def drop_toast(self, n, instant=False):
        t = self.toast_of(n)
        if not t:
            return
        self.toasts.remove(t)
        if instant:
            t.closing = True
            t.disarm()
            t.destroy()
        else:
            t.vanish()
        self.layout()

    def layout(self, skip=None):
        """Xếp thẻ nổi từ góc phải trên xuống; trả về chỗ của thẻ `skip` (thẻ sắp hiện)."""
        wa = workarea()
        x = wa.x + wa.width - TOAST_W - 12
        if self.sidebar and self.sidebar.is_open:
            x -= SIDE_W + SIDE_MARGIN        # khung đang mở: thẻ nổi nằm bên trái khung
        y = wa.y + 10
        spot = (x, y)
        for t in self.toasts:
            if t is skip:
                spot = (x, y)
            else:
                t.glide(x, y)
            y += t.height + TOAST_GAP
        return spot

    # ---------------------------------------------------------------- lưu, báo cho panel
    def changed(self):
        if self.sidebar and self.sidebar.is_open:
            self.sidebar.refresh()
        if self.save_id is None:
            self.save_id = GLib.timeout_add(400, self.flush)
        self.write_state()

    def flush(self):
        if self.save_id is not None:
            GLib.source_remove(self.save_id)
            self.save_id = None
        keep = [{k: n.get(k) for k in ('app', 'summary', 'body', 'icon', 'time', 'urgency', 'unread',
                                       'desktop', 'exe', 'url')}
                for n in self.notes]
        write_private(HISTORY, json.dumps(keep, ensure_ascii=False))
        return False

    def load(self):
        try:
            with open(HISTORY, encoding='utf-8') as f:
                old = json.load(f)
        except (OSError, ValueError):
            return
        for o in old[-KEEP:] if isinstance(old, list) else []:
            if not isinstance(o, dict):
                continue
            # thông báo của lần chạy trước: app không còn chờ trả lời, chỉ còn chữ
            self.notes.append({
                'uid': self.next_uid(), 'id': 0, 'alive': False, 'sender': None, 'pix': None, 'actions': [],
                'transient': False, 'resident': False, 'timeout': -1,
                'app': str(o.get('app') or ''), 'summary': str(o.get('summary') or ''),
                'body': str(o.get('body') or ''), 'icon': str(o.get('icon') or ''),
                'time': float(o.get('time') or time.time()), 'urgency': int(o.get('urgency') or 1),
                'unread': bool(o.get('unread')),
                'desktop': str(o.get('desktop') or ''), 'exe': str(o.get('exe') or ''), 'url': str(o.get('url') or ''),
            })

    def write_state(self):
        unread = sum(1 for n in self.notes if n.get('unread'))
        text = 'UNREAD=%d\nTOTAL=%d\nDND=%d\n' % (unread, len(self.notes), 1 if self.dnd else 0)
        if text == getattr(self, 'state_text', None):
            return
        self.state_text = text
        write_private(STATE, text)
        if self.state_id is None:
            self.state_id = GLib.timeout_add(250, self.poke_panel)

    def find_genmon(self):
        """Tìm plugin genmon đang chạy depot-notify-bell để bảo nó vẽ lại ngay khi số thông báo đổi."""
        self.genmon = []
        d = os.path.expanduser('~/.config/xfce4/panel')
        try:
            for f in os.listdir(d):
                if f.startswith('genmon-') and f.endswith('.rc'):
                    with open(os.path.join(d, f), encoding='utf-8', errors='replace') as fh:
                        if 'depot-notify-bell' in fh.read():
                            self.genmon.append(f[:-3])
        except OSError:
            pass
        self.poke_panel()
        return False

    def poke_panel(self):
        self.state_id = None
        for g in self.genmon or []:
            try:        # GLib tự dọn tiến trình con (không để lại tiến trình ma)
                GLib.spawn_async(['xfce4-panel', '--plugin-event=%s:refresh:bool:true' % g],
                                 flags=GLib.SpawnFlags.SEARCH_PATH | GLib.SpawnFlags.STDOUT_TO_DEV_NULL |
                                 GLib.SpawnFlags.STDERR_TO_DEV_NULL)
            except GLib.Error:
                self.genmon = []
                break
        return False


def main():
    GLib.set_prgname('depot-notify')
    Gdk.set_program_class('Depot-notify')
    sys.exit(Notify().run(sys.argv))


if __name__ == '__main__':
    main()
