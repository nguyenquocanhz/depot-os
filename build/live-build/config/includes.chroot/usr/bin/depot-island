#!/usr/bin/env python3
# Depot OS — depot-island: "Dynamic Island" cho XFCE / i3 (X11)
# By WrenEvil.tech & nguyenquocanhz (nqatech)
#
# Viên đen ở giữa trên cùng, ngay dưới thanh menu. Không có gì phát: ẩn hẳn (vô tung vô ảnh).
#   Đang phát: viên nhỏ — ảnh bìa + sóng nhạc.
#   Đổi bài / rê chuột / bấm: phồng ra — ảnh bìa, tên bài, ca sĩ, thanh thời gian, nút lùi · dừng/phát · tới.
#   Bấm ảnh bìa: mở cửa sổ trình phát.
#   Ẩn chủ động: nút × ở góc phải khi phồng, hoặc chuột phải → "Ẩn tới bài sau" / "Tắt Dynamic Island".
#   Tạm dừng quá 20 giây: tự ẩn (trình duyệt giữ trình phát "Paused" tới khi đóng tab — trước đây viên nằm mãi).
#   Phát lại hoặc đổi bài thì hiện lại.
# Nhạc lấy qua MPRIS trên D-Bus (Firefox, Chrome, VLC, mpv có mpris, Spotify, Telegram…) — không gọi lệnh ngoài.
# Co giãn bằng lò xo (hơi nảy) khi có compositor (picom); không compositor hoặc tắt "Animation bên trong ứng dụng"
# thì đổi cỡ ngay, không hiệu ứng. Bật/tắt: Hiệu ứng hình ảnh → "Dynamic Island" (depot-effects).
#
#   depot-island            chạy (mỗi phiên một bản)
#   depot-island --demo     chạy kèm một trình phát giả để xem thử

import hashlib
import math
import os
import re
import sys
import threading
import time
import urllib.parse
import urllib.request

import gi
gi.require_version('Gtk', '3.0')
gi.require_version('Gdk', '3.0')
gi.require_version('PangoCairo', '1.0')
gi.require_foreign('cairo')
import cairo  # noqa: E402
from gi.repository import Gdk, GdkPixbuf, Gio, GLib, Gtk, Pango, PangoCairo  # noqa: E402

MPRIS = 'org.mpris.MediaPlayer2.'
PLAYER = 'org.mpris.MediaPlayer2.Player'
PATH = '/org/mpris/MediaPlayer2'
CACHE = os.path.join(os.environ.get('XDG_CACHE_HOME') or os.path.expanduser('~/.cache'), 'depot-island')
CONF = os.path.expanduser('~/.config/depot/island')

# kích thước viên: (rộng, cao, bo góc)
COMPACT = (214, 32, 16)
EXPANDED = (392, 138, 34)
POP = (232, 32, 16)          # nháy nhẹ khi dừng/phát
WIN_W, WIN_H = EXPANDED[0] + 24, EXPANDED[1] + 16
BG = (0.02, 0.02, 0.035)
FG = (0.92, 0.93, 0.96)
DIM = (0.55, 0.57, 0.64)
RED = (1.0, 0.18, 0.24)
HOLD_AFTER_CHANGE = 3.5      # giây phồng ra sau khi đổi bài
PAUSE_HIDE = 20.0            # giây tạm dừng rồi tự ẩn (0 = không tự ẩn); đổi bằng PAUSE_HIDE=… trong ~/.config/depot/island
FONT = 'Inter'
DEBUG = bool(os.environ.get('DEPOT_ISLAND_DEBUG'))


def conf():
    d = {}
    try:
        with open(CONF, encoding='utf-8') as f:
            for l in f:
                m = re.match(r'\s*([A-Z_]+)\s*=\s*(.*?)\s*$', l)
                if m:
                    d[m.group(1)] = m.group(2)
    except OSError:
        pass
    return d


def top_offset():
    """Khoảng cách từ mép trên: ngay dưới thanh menu (macOS / i3bar), sát mép khi taskbar nằm dưới (kiểu Windows)."""
    c = conf()
    if c.get('Y', '').isdigit():
        return int(c['Y'])
    de = os.environ.get('XDG_CURRENT_DESKTOP', '').lower()
    if 'i3' in de:
        return 30
    try:
        with open(os.path.expanduser('~/.config/depot/layout'), encoding='utf-8') as f:
            lay = f.read().strip()
    except OSError:
        lay = 'macos'
    return 34 if lay == 'macos' else 8


def fmt_time(us):
    if us is None or us < 0:
        return '--:--'
    s = int(us // 1_000_000)
    return '%d:%02d' % (s // 60, s % 60)


# ------------------------------------------------------------------ MPRIS
class Players:
    """Theo dõi mọi trình phát MPRIS; chọn cái đang phát (hoặc cái vừa dừng gần nhất)."""

    def __init__(self, bus, changed):
        self.bus, self.changed = bus, changed
        self.p = {}          # tên well-known -> {'owner', 'status', 'meta', 't'}
        self.owner = {}      # unique name -> tên well-known
        bus.signal_subscribe('org.freedesktop.DBus', 'org.freedesktop.DBus', 'NameOwnerChanged',
                             '/org/freedesktop/DBus', None, Gio.DBusSignalFlags.NONE, self._owner_changed)
        bus.signal_subscribe(None, 'org.freedesktop.DBus.Properties', 'PropertiesChanged', PATH, None,
                             Gio.DBusSignalFlags.NONE, self._props_changed)
        bus.signal_subscribe(None, PLAYER, 'Seeked', PATH, None, Gio.DBusSignalFlags.NONE, self._seeked)
        bus.call('org.freedesktop.DBus', '/org/freedesktop/DBus', 'org.freedesktop.DBus', 'ListNames', None,
                 GLib.VariantType('(as)'), Gio.DBusCallFlags.NONE, -1, None, self._listed)

    def _listed(self, bus, res):
        try:
            names = bus.call_finish(res).unpack()[0]
        except GLib.Error:
            return
        for n in names:
            if n.startswith(MPRIS):
                self._add(n)

    def _add(self, name):
        def got_owner(bus, res):
            try:
                owner = bus.call_finish(res).unpack()[0]
            except GLib.Error:
                return
            self.p[name] = {'owner': owner, 'status': 'Stopped', 'meta': {}, 't': time.monotonic(),
                            'pos': None, 'pos_t': 0.0}
            self.owner[owner] = name
            self.bus.call(name, PATH, 'org.freedesktop.DBus.Properties', 'GetAll', GLib.Variant('(s)', (PLAYER,)),
                          GLib.VariantType('(a{sv})'), Gio.DBusCallFlags.NONE, 2000, None, self._got_all, name)
        self.bus.call('org.freedesktop.DBus', '/org/freedesktop/DBus', 'org.freedesktop.DBus', 'GetNameOwner',
                      GLib.Variant('(s)', (name,)), GLib.VariantType('(s)'), Gio.DBusCallFlags.NONE, 2000, None,
                      got_owner)

    def _got_all(self, bus, res, name):
        try:
            props = bus.call_finish(res).unpack()[0]
        except GLib.Error:
            return
        self._apply(name, props)

    def _apply(self, name, props):
        p = self.p.get(name)
        if not p:
            return
        if 'PlaybackStatus' in props:
            p['status'] = props['PlaybackStatus']
            p['t'] = time.monotonic()
        if 'Metadata' in props:
            p['meta'] = props['Metadata'] or {}
        if 'Position' in props:
            p['pos'], p['pos_t'] = props['Position'], time.monotonic()
        self.changed()

    def _owner_changed(self, _c, _s, _p, _i, _sig, params):
        name, old, new = params.unpack()
        if not name.startswith(MPRIS):
            return
        if old:
            self.owner.pop(old, None)
            self.p.pop(name, None)
            self.changed()
        if new:
            self._add(name)

    def _props_changed(self, _c, sender, _p, _i, _sig, params):
        iface, changed, _inv = params.unpack()
        if iface == PLAYER and sender in self.owner:
            self._apply(self.owner[sender], changed)

    def _seeked(self, _c, sender, _p, _i, _sig, params):
        name = self.owner.get(sender)
        if name and name in self.p:
            self.p[name]['pos'], self.p[name]['pos_t'] = params.unpack()[0], time.monotonic()
            self.changed()

    def current(self):
        live = [(n, p) for n, p in self.p.items() if p['status'] in ('Playing', 'Paused') and p['meta']]
        if not live:
            return None, None
        playing = [x for x in live if x[1]['status'] == 'Playing']
        return max(playing or live, key=lambda x: x[1]['t'])

    def call(self, name, method, iface=PLAYER, path=PATH):
        self.bus.call(name, path, iface, method, None, None, Gio.DBusCallFlags.NONE, 2000, None, None)

    def poll_position(self, name):
        """Hỏi vị trí đang phát (chỉ khi viên đang phồng — vài trình phát không báo Position qua tín hiệu)."""
        def done(bus, res):
            try:
                v = bus.call_finish(res).unpack()[0]
            except GLib.Error:
                return
            if name in self.p:
                self.p[name]['pos'], self.p[name]['pos_t'] = v, time.monotonic()
        self.bus.call(name, PATH, 'org.freedesktop.DBus.Properties', 'Get', GLib.Variant('(ss)', (PLAYER, 'Position')),
                      GLib.VariantType('(v)'), Gio.DBusCallFlags.NONE, 1000, None, done)


# ------------------------------------------------------------------ ảnh bìa
class Art:
    def __init__(self, ready):
        self.ready = ready
        self.url, self.pix = None, None

    def want(self, url):
        if url == self.url:
            return
        self.url, self.pix = url, None
        if not url:
            return
        if url.startswith('file://'):
            self._load(urllib.parse.unquote(urllib.parse.urlparse(url).path), url)
        elif url.startswith(('http://', 'https://')):
            threading.Thread(target=self._fetch, args=(url,), daemon=True).start()

    def _fetch(self, url):
        os.makedirs(CACHE, exist_ok=True)
        path = os.path.join(CACHE, hashlib.sha1(url.encode()).hexdigest())
        if not os.path.exists(path):
            try:
                req = urllib.request.Request(url, headers={'User-Agent': 'depot-island'})
                with urllib.request.urlopen(req, timeout=6) as r, open(path + '.tmp', 'wb') as f:
                    f.write(r.read(4 * 1024 * 1024))
                os.replace(path + '.tmp', path)
            except (OSError, ValueError):
                return
            self._trim()
        GLib.idle_add(self._load, path, url)

    @staticmethod
    def _trim(keep=60):
        try:
            files = sorted((os.path.join(CACHE, f) for f in os.listdir(CACHE)), key=os.path.getmtime)
            for f in files[:-keep]:
                os.remove(f)
        except OSError:
            pass

    def _load(self, path, url):
        if url != self.url:
            return False
        try:
            self.pix = GdkPixbuf.Pixbuf.new_from_file_at_scale(path, 160, 160, True)
        except GLib.Error:
            self.pix = None
        self.ready()
        return False


# ------------------------------------------------------------------ lò xo
class Spring:
    def __init__(self, v):
        self.x, self.v, self.t = float(v), 0.0, float(v)

    def step(self, dt, k=420.0, c=27.0):   # zeta ≈ 0.66: nảy nhẹ một nhịp rồi đứng
        a = k * (self.t - self.x) - c * self.v
        self.v += a * dt
        self.x += self.v * dt
        if abs(self.t - self.x) < 0.3 and abs(self.v) < 2:
            self.x, self.v = self.t, 0.0
            return False
        return True

    def jump(self):
        self.x, self.v = self.t, 0.0


def rrect(cr, x, y, w, h, r):
    r = max(0.0, min(r, w / 2, h / 2))
    cr.new_sub_path()
    cr.arc(x + w - r, y + r, r, -math.pi / 2, 0)
    cr.arc(x + w - r, y + h - r, r, 0, math.pi / 2)
    cr.arc(x + r, y + h - r, r, math.pi / 2, math.pi)
    cr.arc(x + r, y + r, r, math.pi, 3 * math.pi / 2)
    cr.close_path()


# ------------------------------------------------------------------ cửa sổ
class Island(Gtk.Window):
    def __init__(self):
        super().__init__(type=Gtk.WindowType.TOPLEVEL, title='Depot Island')
        self.set_decorated(False)
        self.set_resizable(False)
        self.set_keep_above(True)
        self.set_skip_taskbar_hint(True)
        self.set_skip_pager_hint(True)
        self.set_accept_focus(False)
        self.set_focus_on_map(False)
        self.stick()
        # DOCK: không lấy focus, mọi workspace; video toàn màn hình vẫn nằm trên (xfwm4 xếp fullscreen trên dock)
        self.set_type_hint(Gdk.WindowTypeHint.DOCK)
        self.set_app_paintable(True)
        scr = self.get_screen()
        vis = scr.get_rgba_visual()
        if vis:
            self.set_visual(vis)
        self.composited = scr.is_composited() and vis is not None
        scr.connect('composited-changed', self._composited_changed)
        self.add_events(Gdk.EventMask.BUTTON_PRESS_MASK | Gdk.EventMask.ENTER_NOTIFY_MASK |
                        Gdk.EventMask.LEAVE_NOTIFY_MASK | Gdk.EventMask.POINTER_MOTION_MASK)
        self.connect('draw', self.on_draw)
        self.connect('button-press-event', self.on_click)
        self.connect('enter-notify-event', self.on_enter)
        self.connect('leave-notify-event', self.on_leave)

        self.w, self.h, self.r = Spring(COMPACT[0]), Spring(COMPACT[1]), Spring(COMPACT[2])
        self.alpha = Spring(0)          # độ hiện của cả viên (0 = ẩn)
        self.mode = 'hidden'            # hidden | compact | expanded
        self.hover = False
        self.hold_until = 0.0
        self.anim_id = None
        self.bars_id = None
        self.last_frame = 0.0
        self.track_key = None
        self.cur, self.info = None, None
        self.buttons = {}
        self.pop_until = 0.0
        self.dismissed = None           # (bài, lúc đang phát?) người dùng đã chủ động ẩn
        self.paused_since = None        # lúc bắt đầu tạm dừng (để tự ẩn)
        self.menu = None
        try:
            self.pause_hide = float(conf().get('PAUSE_HIDE', PAUSE_HIDE))
        except ValueError:
            self.pause_hide = PAUSE_HIDE

        self.art = Art(self.queue_draw)
        self.players = Players(Gio.bus_get_sync(Gio.BusType.SESSION, None), self.update)
        GLib.timeout_add(1000, self._tick)
        self.place()
        Gdk.Screen.get_default().connect('monitors-changed', lambda *_: self.place())

    # --- vị trí / hình dạng
    def place(self):
        disp = Gdk.Display.get_default()
        mon = disp.get_primary_monitor() or disp.get_monitor(0)
        g = mon.get_geometry()
        # cửa sổ không đổi cỡ được (set_resizable False) nên cỡ đặt bằng size_request, resize() bị bỏ qua
        if self.composited:
            self.set_size_request(WIN_W, WIN_H)
            self.resize(WIN_W, WIN_H)
            self.move(g.x + (g.width - WIN_W) // 2, g.y + top_offset())
        else:
            w, h = int(self.w.t), int(self.h.t)
            self.set_size_request(w, h)
            self.resize(w, h)
            self.move(g.x + (g.width - w) // 2, g.y + top_offset())
        self._geom = g

    def anim_on(self):
        s = Gtk.Settings.get_default()
        return self.composited and (s is None or s.get_property('gtk-enable-animations'))

    def _composited_changed(self, scr):
        self.composited = scr.is_composited() and scr.get_rgba_visual() is not None
        self.place()
        self.queue_draw()

    def pill_rect(self):
        w, h = self.w.x, self.h.x
        if self.composited:
            return (WIN_W - w) / 2, 4, w, h
        return 0, 0, w, h

    def update_shape(self):
        x, y, w, h = self.pill_rect()
        reg = cairo.Region(cairo.RectangleInt(int(x), int(y), max(1, int(w)), max(1, int(h))))
        self.input_shape_combine_region(reg)
        if not self.composited:
            # không compositor: cắt góc tròn bằng shape X (không trong suốt được)
            surf = cairo.ImageSurface(cairo.FORMAT_A1, max(1, int(w)), max(1, int(h)))
            cr = cairo.Context(surf)
            rrect(cr, 0, 0, int(w), int(h), self.r.x)
            cr.fill()
            self.shape_combine_region(Gdk.cairo_region_create_from_surface(surf))

    # --- trạng thái
    def update(self):
        name, p = self.players.current()
        self.cur = name
        if not p:
            self.paused_since = None
            self.set_mode('hidden')
            return
        meta = p['meta']
        title = str(meta.get('xesam:title') or '').strip()
        artist = meta.get('xesam:artist') or []
        if isinstance(artist, str):
            artist = [artist]
        album = str(meta.get('xesam:album') or '')
        if not title:
            url = str(meta.get('xesam:url') or '')
            title = urllib.parse.unquote(os.path.basename(urllib.parse.urlparse(url).path)) or 'Đang phát'
        self.info = {'title': title, 'artist': ', '.join(str(a) for a in artist) or album,
                     'length': meta.get('mpris:length'), 'status': p['status'], 'player': name}
        self.art.want(str(meta.get('mpris:artUrl') or '') or None)
        key = (name, title, self.info['artist'])
        playing = p['status'] == 'Playing'
        now = time.monotonic()
        new_track = key != self.track_key
        self.track_key = key
        if playing:
            self.paused_since = None
        elif self.paused_since is None or new_track:     # bài mới lúc đang dừng: đếm lại từ đầu
            self.paused_since = now
        # đã chủ động ẩn: nằm im tới khi đổi bài, hoặc bấm phát lại sau khi ẩn lúc đang tạm dừng
        if self.dismissed:
            dkey, was_playing = self.dismissed
            if dkey != key or (playing and not was_playing):
                self.dismissed = None
            else:
                self.set_mode('hidden')
                return
        if not playing and self.pause_hide > 0 and not self.hover and now - self.paused_since >= self.pause_hide:
            self.set_mode('hidden')              # tạm dừng lâu: tự ẩn
            return
        if new_track:                            # bài mới: phồng ra vài giây rồi thu về
            self.hold_until = now + HOLD_AFTER_CHANGE
            self.set_mode('expanded')
        elif self.mode == 'hidden':
            self.set_mode('compact')
        else:
            self.set_mode(self.mode)   # cập nhật sóng nhạc theo trạng thái phát
        self.queue_draw()

    def dismiss(self):
        """Người dùng chủ động ẩn viên (nút ×, chuột phải)."""
        if not self.info:
            return
        self.dismissed = (self.track_key, self.info['status'] == 'Playing')
        self.hover = False
        self.hold_until = 0.0
        self.set_mode('hidden')

    def turn_off(self):
        """Tắt hẳn: ghi ISLAND=0 qua depot-effects (bật lại ở Hiệu ứng hình ảnh), rồi thoát."""
        import subprocess
        try:
            subprocess.Popen(['depot-effects', 'island', 'off'], start_new_session=True,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except OSError:
            pass
        self.dismiss()
        app = self.get_application()
        if app:
            GLib.timeout_add(600, lambda: (app.quit(), False)[1])

    def popup_menu(self, event):
        self.menu = Gtk.Menu()
        for label, cb in (('Ẩn tới bài sau', self.dismiss), ('Tắt Dynamic Island', self.turn_off)):
            it = Gtk.MenuItem(label=label)
            it.connect('activate', lambda _i, f=cb: f())
            self.menu.append(it)
        self.menu.show_all()
        self.menu.popup_at_pointer(event)

    def set_mode(self, mode):
        if mode == 'compact' and (self.hover or time.monotonic() < self.hold_until):
            mode = 'expanded'
        self.mode = mode
        if mode == 'hidden':
            self.alpha.t = 0
            self.w.t, self.h.t, self.r.t = 120, 26, 13       # co lại rồi tan
        else:
            self.alpha.t = 1
            if not self.get_visible():
                self.w.x, self.h.x, self.r.x = 120, 26, 13
                self.show_all()
                self.place()
            if mode == 'expanded':
                tgt = EXPANDED
            elif time.monotonic() < self.pop_until:
                tgt = POP
            else:
                tgt = COMPACT
            self.w.t, self.h.t, self.r.t = tgt
        if not self.composited:
            for s in (self.w, self.h, self.r, self.alpha):
                s.jump()
            self.place()
        self.kick()
        self.bars(self.mode == 'compact' and self.info and self.info['status'] == 'Playing')

    def kick(self):
        if not self.anim_on():
            for s in (self.w, self.h, self.r, self.alpha):
                s.jump()
            self.frame_done()
            return
        if self.anim_id is None:
            self.last_frame = time.monotonic()
            self.anim_id = GLib.timeout_add(16, self.frame)

    def frame(self):
        now = time.monotonic()
        dt = min(0.05, now - self.last_frame)
        self.last_frame = now
        moving = False
        for s in (self.w, self.h, self.r):
            moving |= s.step(dt)
        moving |= self.alpha.step(dt, k=300, c=34)
        self.update_shape()
        self.queue_draw()
        if not moving:
            self.anim_id = None
            self.frame_done()
            return False
        return True

    def frame_done(self):
        self.update_shape()
        self.queue_draw()
        if self.mode == 'hidden' and self.alpha.x <= 0.01 and self.get_visible():
            self.hide()

    def bars(self, on):
        if on and self.bars_id is None and self.anim_on():
            self.bars_id = GLib.timeout_add(90, lambda: (self.queue_draw(), True)[1])
        elif not on and self.bars_id is not None:
            GLib.source_remove(self.bars_id)
            self.bars_id = None

    def _tick(self):
        now = time.monotonic()
        if self.mode == 'expanded' and not self.hover and now >= self.hold_until:
            self.set_mode('compact')
        if self.mode == 'compact' and self.pop_until and now >= self.pop_until:
            self.pop_until = 0
            self.set_mode('compact')
        if self.mode == 'expanded' and self.cur:
            self.players.poll_position(self.cur)
            self.queue_draw()
        if (self.mode != 'hidden' and self.paused_since is not None and self.pause_hide > 0 and not self.hover
                and now - self.paused_since >= self.pause_hide):
            self.set_mode('hidden')
        return True

    # --- chuột
    def inside(self, ex, ey):
        x, y, w, h = self.pill_rect()
        return x <= ex <= x + w and y <= ey <= y + h

    def on_enter(self, _w, _e):
        if self.mode == 'hidden':
            return
        self.hover = True
        self.set_mode('expanded')

    def on_leave(self, _w, e):
        if e.detail == Gdk.NotifyType.INFERIOR:
            return
        self.hover = False
        self.hold_until = max(self.hold_until, time.monotonic() + 0.6)

    def on_click(self, _w, e):
        if DEBUG:
            print('click', e.type, e.time, e.button, round(e.x), round(e.y), self.cur, flush=True)
        # X có thể giao cùng một cú bấm hai lần (và thêm 2BUTTON_PRESS khi bấm nhanh) — nút dừng/phát sẽ bật rồi tắt
        if e.type != Gdk.EventType.BUTTON_PRESS or e.time == getattr(self, 'last_click', None):
            return
        self.last_click = e.time
        if e.button == 3 and self.mode != 'hidden':      # chuột phải: menu ẩn / tắt
            self.popup_menu(e)
            return
        if e.button != 1 or not self.cur:
            return
        for name, (x, y, w, h) in self.buttons.items():
            if x <= e.x <= x + w and y <= e.y <= y + h:
                if name == 'close':
                    self.dismiss()
                elif name == 'raise':
                    self.players.call(self.cur, 'Raise', iface='org.mpris.MediaPlayer2')
                else:
                    self.players.call(self.cur, name)
                    if name == 'PlayPause':
                        self.pop_until = time.monotonic() + 0.35
                return
        if self.mode == 'compact':
            self.hold_until = time.monotonic() + HOLD_AFTER_CHANGE
            self.set_mode('expanded')

    # --- vẽ
    def text(self, cr, s, x, y, w, size, color, bold=False, alpha=1.0):
        lay = PangoCairo.create_layout(cr)
        fd = Pango.FontDescription('%s %s%d' % (FONT, 'Bold ' if bold else '', size))
        lay.set_font_description(fd)
        lay.set_text(s, -1)
        lay.set_width(int(max(1, w) * Pango.SCALE))
        lay.set_ellipsize(Pango.EllipsizeMode.END)
        cr.set_source_rgba(*color, alpha)
        cr.move_to(x, y)
        PangoCairo.show_layout(cr, lay)
        return lay.get_pixel_size()[1]

    def draw_art(self, cr, x, y, size, radius, alpha):
        cr.save()
        rrect(cr, x, y, size, size, radius)
        cr.clip()
        if self.art.pix:
            pw, ph = self.art.pix.get_width(), self.art.pix.get_height()
            s = size / min(pw, ph)
            cr.translate(x + (size - pw * s) / 2, y + (size - ph * s) / 2)
            cr.scale(s, s)
            Gdk.cairo_set_source_pixbuf(cr, self.art.pix, 0, 0)
            cr.paint_with_alpha(alpha)
        else:
            g = cairo.LinearGradient(x, y, x + size, y + size)
            g.add_color_stop_rgba(0, 0.16, 0.17, 0.22, alpha)
            g.add_color_stop_rgba(1, 0.06, 0.06, 0.09, alpha)
            cr.set_source(g)
            cr.paint()
            # nốt nhạc đơn giản
            cr.set_source_rgba(*FG, 0.8 * alpha)
            u = size / 10
            cr.arc(x + 4 * u, y + 7 * u, 1.3 * u, 0, 2 * math.pi)
            cr.fill()
            cr.rectangle(x + 5 * u, y + 2.5 * u, 0.7 * u, 4.6 * u)
            cr.fill()
            cr.rectangle(x + 5 * u, y + 2.5 * u, 2.4 * u, 0.8 * u)
            cr.fill()
        cr.restore()

    def draw_bars(self, cr, x, cy, alpha, playing):
        t = time.monotonic()
        for i in range(4):
            if playing and self.anim_on():
                hgt = 4 + 9 * (0.5 + 0.5 * math.sin(t * (6.0 + i * 1.7) + i * 1.3))
            else:
                hgt = 4
            cr.set_source_rgba(*RED, alpha)
            rrect(cr, x + i * 5, cy - hgt / 2, 3, hgt, 1.5)
            cr.fill()

    def draw_controls(self, cr, cx, cy, alpha, playing):
        self.buttons = {}
        cr.set_source_rgba(*FG, alpha)
        # lùi
        bx = cx - 70
        for k in (0, 1):
            cr.move_to(bx + 10 - k * 9, cy - 7)
            cr.line_to(bx + 10 - k * 9, cy + 7)
            cr.line_to(bx + 1 - k * 9, cy)
            cr.close_path()
        cr.fill()
        self.buttons['Previous'] = (bx - 16, cy - 16, 34, 32)
        # dừng / phát
        if playing:
            rrect(cr, cx - 8, cy - 9, 5.5, 18, 1.5)
            rrect(cr, cx + 2.5, cy - 9, 5.5, 18, 1.5)
        else:
            cr.move_to(cx - 6, cy - 10)
            cr.line_to(cx - 6, cy + 10)
            cr.line_to(cx + 10, cy)
            cr.close_path()
        cr.fill()
        self.buttons['PlayPause'] = (cx - 18, cy - 18, 36, 36)
        # tới
        bx = cx + 62
        for k in (0, 1):
            cr.move_to(bx + k * 9, cy - 7)
            cr.line_to(bx + k * 9, cy + 7)
            cr.line_to(bx + 9 + k * 9, cy)
            cr.close_path()
        cr.fill()
        self.buttons['Next'] = (bx - 8, cy - 16, 34, 32)

    def on_draw(self, _w, cr):
        cr.set_operator(cairo.OPERATOR_SOURCE)
        cr.set_source_rgba(0, 0, 0, 0)
        cr.paint()
        cr.set_operator(cairo.OPERATOR_OVER)
        a = max(0.0, min(1.0, self.alpha.x))
        if a <= 0.01:
            return
        x, y, w, h = self.pill_rect()
        r = self.r.x
        rrect(cr, x, y, w, h, r)
        cr.set_source_rgba(*BG, 0.97 * a)
        cr.fill_preserve()
        cr.set_source_rgba(1, 1, 1, 0.06 * a)
        cr.set_line_width(1)
        cr.stroke()
        if not self.info:
            return
        playing = self.info['status'] == 'Playing'
        # 0 = viên nhỏ, 1 = phồng hẳn
        e = max(0.0, min(1.0, (h - COMPACT[1]) / (EXPANDED[1] - COMPACT[1])))
        cr.save()
        rrect(cr, x, y, w, h, r)
        cr.clip()
        if e < 0.6:                                     # nội dung viên nhỏ
            ca = a * (1 - e / 0.6)
            s = h - 10
            self.draw_art(cr, x + 6, y + 5, s, s / 2, ca)
            self.draw_bars(cr, x + w - 30, y + h / 2, ca, playing)
            self.text(cr, self.info['title'], x + 14 + s, y + (h - 16) / 2, w - s - 54, 9, FG, alpha=ca)
            self.buttons = {}
        if e > 0.35:                                    # nội dung phồng
            ea = a * min(1.0, (e - 0.35) / 0.65)
            pad = 14
            s = min(66, h - 2 * pad - 26)
            ax, ay = x + pad, y + pad
            self.draw_art(cr, ax, ay, s, 14, ea)
            tx, tw = ax + s + 12, w - s - 2 * pad - 72
            th = self.text(cr, self.info['title'], tx, ay + 6, tw, 11, FG, bold=True, alpha=ea)
            self.text(cr, self.info['artist'] or '', tx, ay + 10 + th, tw, 9, DIM, alpha=ea)
            self.draw_bars(cr, x + w - pad - 50, ay + 14, ea, playing)
            # nút × (ẩn viên): vòng mờ + dấu chéo, góc phải trên
            qx, qy = x + w - pad - 10, ay + 14
            cr.arc(qx, qy, 11, 0, 2 * math.pi)
            cr.set_source_rgba(1, 1, 1, 0.10 * ea)
            cr.fill()
            cr.set_source_rgba(*FG, 0.85 * ea)
            cr.set_line_width(1.6)
            cr.set_line_cap(cairo.LINE_CAP_ROUND)
            for dx in (-1, 1):
                cr.move_to(qx - 4 * dx, qy - 4)
                cr.line_to(qx + 4 * dx, qy + 4)
            cr.stroke()
            # thanh thời gian
            p = self.players.p.get(self.cur) or {}
            pos = p.get('pos')
            if pos is not None and playing:
                pos += (time.monotonic() - p.get('pos_t', 0)) * 1_000_000
            length = self.info['length']
            by = ay + s + 12
            bx, bw = x + pad + 40, w - 2 * pad - 80
            self.text(cr, fmt_time(pos), x + pad, by - 6, 38, 8, DIM, alpha=ea)
            left = None if (length is None or pos is None) else length - pos
            self.text(cr, ('-' + fmt_time(left)) if left is not None else '--:--', bx + bw + 6, by - 6, 40, 8,
                      DIM, alpha=ea)
            rrect(cr, bx, by, bw, 4, 2)
            cr.set_source_rgba(1, 1, 1, 0.18 * ea)
            cr.fill()
            if length and pos is not None and length > 0:
                fr = max(0.0, min(1.0, pos / length))
                rrect(cr, bx, by, max(4, bw * fr), 4, 2)
                cr.set_source_rgba(*FG, 0.9 * ea)
                cr.fill()
            if e > 0.85:
                self.draw_controls(cr, x + w / 2, y + h - 22, ea, playing)
                self.buttons['raise'] = (ax, ay, s, s)
                self.buttons['close'] = (qx - 16, qy - 16, 32, 32)
        cr.restore()


def demo():
    """Trình phát giả trên D-Bus để xem thử (không phát tiếng)."""
    import subprocess
    subprocess.Popen([sys.executable, os.path.abspath(__file__), '--demo-player'])


def demo_player():
    xml = '''<node>
      <interface name="org.mpris.MediaPlayer2"><method name="Raise"/>
        <property name="Identity" type="s" access="read"/></interface>
      <interface name="org.mpris.MediaPlayer2.Player">
        <method name="PlayPause"/><method name="Next"/><method name="Previous"/>
        <property name="PlaybackStatus" type="s" access="read"/>
        <property name="Metadata" type="a{sv}" access="read"/>
        <property name="Position" type="x" access="read"/></interface></node>'''
    songs = [('Bóng ma trên phố', 'WrenEvil', 214), ('Vô tung vô ảnh', 'Depot Band', 187), ('Kho đêm', 'nqatech', 203)]
    st = {'i': 0, 'status': 'Playing', 't0': time.monotonic()}
    bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
    node = Gio.DBusNodeInfo.new_for_xml(xml)

    def meta():
        t, a, l = songs[st['i']]
        m = {'mpris:trackid': GLib.Variant('o', '/depot/%d' % st['i']), 'xesam:title': GLib.Variant('s', t),
             'xesam:artist': GLib.Variant('as', [a]), 'mpris:length': GLib.Variant('x', l * 1_000_000)}
        art = os.environ.get('DEPOT_ISLAND_DEMO_ART', '/usr/share/pixmaps/depot-logo.svg')
        if st['i'] != 1 and os.path.exists(art):     # bài 2 không có ảnh bìa: xem kiểu dự phòng (nốt nhạc)
            m['mpris:artUrl'] = GLib.Variant('s', 'file://' + urllib.parse.quote(art))
        return m

    def prop(name):
        if name == 'PlaybackStatus':
            return GLib.Variant('s', st['status'])
        if name == 'Metadata':
            return GLib.Variant('a{sv}', meta())
        if name == 'Position':
            return GLib.Variant('x', int((time.monotonic() - st['t0']) * 1_000_000 + 47_000_000))
        if name == 'Identity':
            return GLib.Variant('s', 'Depot demo')

    def emit(*names):
        bus.emit_signal(None, PATH, 'org.freedesktop.DBus.Properties', 'PropertiesChanged',
                        GLib.Variant('(sa{sv}as)', (PLAYER, {n: prop(n) for n in names}, [])))

    def call(_c, _s, _p, _i, method, _params, inv):
        if method == 'PlayPause':
            st['status'] = 'Paused' if st['status'] == 'Playing' else 'Playing'
            emit('PlaybackStatus')
        elif method in ('Next', 'Previous'):
            st['i'] = (st['i'] + (1 if method == 'Next' else -1)) % len(songs)
            st['t0'] = time.monotonic()
            emit('Metadata')
        inv.return_value(None)

    for iface in node.interfaces:
        # get_property: (connection, sender, path, interface, property)
        bus.register_object(PATH, iface, call, lambda *a: prop(a[4]), None)
    Gio.bus_own_name_on_connection(bus, MPRIS + 'depotdemo', Gio.BusNameOwnerFlags.NONE, None, None)
    GLib.MainLoop().run()


def main():
    if '--demo-player' in sys.argv:
        demo_player()
        return
    app = Gtk.Application(application_id='tech.wrenevil.DepotIsland', flags=Gio.ApplicationFlags.FLAGS_NONE)
    state = {}

    def activate(a):
        if 'win' in state:
            return
        state['win'] = Island()
        a.add_window(state['win'])
        a.hold()
        if '--demo' in sys.argv:
            demo()

    app.connect('activate', activate)
    app.run([sys.argv[0]])


if __name__ == '__main__':
    main()
