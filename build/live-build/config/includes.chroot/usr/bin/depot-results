#!/bin/sh
# Depot OS — đo máy thật, ghi bằng chứng vào <out>/<phiên-bản>/<máy>/ (Phase 2, ROADMAP.md).
# Chạy NGAY TRONG phiên desktop (XFCE hoặc i3), sau khi để máy rảnh vài phút:
#
#   depot-results <máy> [--version v0.11] [--video file.mp4] [--seconds 30] [--out ~/depot-results]
#
# <máy> là tên ngắn [a-z0-9-], vd: i3gen2-ssd, vmware-bios. Ghi ra:
#   sysinfo.txt  CPU, GPU, RAM, kernel, phiên desktop, live hay đã cài, zram
#   memory.txt   `free -m` + RAM từng tiến trình (PSS; có sudo thì đủ cả tiến trình root)
#   boot.txt     systemd-analyze (tổng, blame, critical-chain) + các service ConditionNeedsUpdate
#   plymouth-boot-duration   mốc thời gian boot của Plymouth (làm thanh tiến trình boot chạy đều)
#   gpu.txt      vainfo + glxinfo -B
#   video.txt    (khi có --video) mpv --hwdec=vaapi trong N giây, CPU trung bình toàn máy
#   SUMMARY.md   so với thông số mục tiêu trong README.md
# Không gửi gì đi đâu. Chép thư mục kết quả về repo: results/<phiên-bản>/<máy>/
set -eu

M=${1:-}
case "$M" in ''|-*|*[!a-z0-9-]*) echo "cách dùng: $0 <máy [a-z0-9-]> [--version V] [--video FILE] [--seconds N] [--out DIR]" >&2; exit 2 ;; esac
shift
V=unknown VIDEO= SECS=30 OUT="$HOME/depot-results"
while [ $# -gt 0 ]; do
    case "$1" in
        --version) V=${2:?}; shift ;;
        --video) VIDEO=${2:?}; shift ;;
        --seconds) SECS=${2:?}; shift ;;
        --out) OUT=${2:?}; shift ;;
        *) echo "tuỳ chọn lạ: $1" >&2; exit 2 ;;
    esac
    shift
done
case "$SECS" in ''|*[!0-9]*) echo "--seconds cần một số" >&2; exit 2 ;; esac
case "$V" in *[!A-Za-z0-9.+~-]*) echo "--version chỉ gồm [A-Za-z0-9.+~-]" >&2; exit 2 ;; esac
[ -z "$VIDEO" ] || [ -r "$VIDEO" ] || { echo "không đọc được video: $VIDEO" >&2; exit 1; }

D="$OUT/$V/$M"
mkdir -p "$D"
SUDO=
sudo -n true 2>/dev/null && SUDO="sudo -n"
have() { command -v "$1" >/dev/null 2>&1; }
LIVE=installed
[ -d /run/live/medium ] && LIVE=live
SESSION=${XDG_CURRENT_DESKTOP:-${DESKTOP_SESSION:-unknown}}

echo ">> sysinfo"
{
    echo "# $(date -u +%Y-%m-%dT%H:%MZ) · Depot OS $V · $LIVE"
    echo "kernel:  $(uname -r)"
    echo "cmdline: $(cat /proc/cmdline)"
    echo "cpu:     $(sed -n 's/^model name[[:space:]]*: //p' /proc/cpuinfo | head -1) ($(nproc) luồng)"
    echo "ram:     $(awk '/^MemTotal:/ {printf "%.1f GB", $2/1048576}' /proc/meminfo)"
    echo "session: $SESSION (${XDG_SESSION_TYPE:-?})"
    echo "uptime:  $(awk '{printf "%d phút", $1/60}' /proc/uptime)"
    echo "virt:    $(systemd-detect-virt 2>/dev/null || echo none)"
    echo
    echo "# GPU"
    have lspci && lspci -nnk | grep -A3 -Ei 'vga|3d|display' || echo "(không có lspci)"
    echo
    echo "# swap / zram"
    swapon --show 2>/dev/null || true
    have zramctl && zramctl 2>/dev/null || true
    echo
    echo "# compositor & tiến trình desktop đang chạy"
    for p in picom picom-animated xfwm4 i3 plank conky; do
        pgrep -x "$p" >/dev/null 2>&1 && echo "  $p: chạy" || echo "  $p: không"
    done
} > "$D/sysinfo.txt"

echo ">> memory"
{
    echo "# free -m (cột 'used' đã trừ page cache thu hồi được)"
    free -m
    echo
    echo "# PSS từng tiến trình, MB (trang dùng chung chia đều cho các tiến trình map nó)"
    [ -n "$SUDO" ] && echo "# đủ mọi tiến trình (sudo)" || echo "# chỉ tiến trình của user này — có sudo không mật khẩu thì đủ cả root"
    $SUDO sh -c 'for f in /proc/[0-9]*/smaps_rollup; do
        k=$(awk "/^Pss:/ {print \$2}" "$f" 2>/dev/null) || continue
        [ -n "$k" ] && printf "%s %s\n" "$k" "$(cat "${f%/smaps_rollup}/comm" 2>/dev/null)"
    done' | sort -rn | awk '{ k = $1; $1 = ""; t += k; if (NR <= 40) printf "%8.1f %s\n", k / 1024, $0 }
        END { printf "%8.1f  tổng PSS (%d tiến trình)\n", t / 1024, NR }'
} > "$D/memory.txt"
RAM_USED=$(free -m | awk '/^Mem:/ {print $3}')

echo ">> boot"
{
    systemd-analyze 2>&1 || true
    echo
    echo "# 20 unit chậm nhất"
    systemd-analyze blame 2>/dev/null | head -20 || true
    echo
    echo "# critical-chain tới graphical.target"
    systemd-analyze critical-chain graphical.target 2>/dev/null || true
    echo
    echo "# ConditionNeedsUpdate: 'ConditionResult=no' là đã bỏ qua (hook 9900-depot-finalize làm sẵn lúc build)"
    for u in ldconfig.service systemd-update-done.service; do
        printf '%s: ' "$u"
        systemctl show -p ConditionResult --value "$u" 2>/dev/null || echo "?"
    done
} > "$D/boot.txt"
# Plymouth ghi lúc boot xong: mỗi dòng "tỉ-lệ-thời-gian:trạng-thái". Chép vào repo làm
# config/includes.chroot/var/lib/plymouth/boot-duration để thanh tiến trình boot live chạy đều
# (không có file này Plymouth đoán 60 giây, thanh kẹt ở ~25% rồi nhảy lên 100%)
[ -s /var/lib/plymouth/boot-duration ] && cp /var/lib/plymouth/boot-duration "$D/plymouth-boot-duration"
# "Startup finished in 3.2s (kernel) + 1min 4.5s (userspace) = 1min 7.7s" -> 67.7
BOOT_S=$(systemd-analyze 2>/dev/null | sed -n 's/.*= \(.*\)$/\1/p' | head -1 | awk '{
    t = 0
    for (i = 1; i <= NF; i++) {
        v = $i
        if (v ~ /min$/) { sub(/min$/, "", v); t += v * 60 }
        else if (v ~ /ms$/) { sub(/ms$/, "", v); t += v / 1000 }
        else if (v ~ /s$/) { sub(/s$/, "", v); t += v }
    }
    if (NF) printf "%.1f", t }')

echo ">> gpu"
{
    echo "# vainfo"
    have vainfo && vainfo 2>&1 || echo "(không có vainfo)"
    echo
    echo "# glxinfo -B"
    have glxinfo && glxinfo -B 2>&1 || echo "(không có glxinfo)"
} > "$D/gpu.txt"
VAAPI_H264=no
grep -q 'VAProfileH264.*VAEntrypointVLD' "$D/gpu.txt" && VAAPI_H264=yes

# CPU bận (%) toàn máy giữa hai lần đọc /proc/stat
cpu_sample() { awk '/^cpu / { idle = $5 + $6; t = 0; for (i = 2; i <= NF; i++) t += $i; print t, idle }' /proc/stat; }
VIDEO_CPU= VIDEO_HW=
if [ -n "$VIDEO" ]; then
    echo ">> video ($SECS giây)"
    if have mpv; then
        set -- $(cpu_sample)
        T0=$1 I0=$2
        mpv --hwdec=vaapi --no-audio --length="$SECS" --term-status-msg= "$VIDEO" > "$D/video.mpv.log" 2>&1 || true
        set -- $(cpu_sample)
        VIDEO_CPU=$(awk -v t="$(( $1 - T0 ))" -v i="$(( $2 - I0 ))" 'BEGIN { if (t > 0) printf "%.0f", 100 * (t - i) / t }')
        VIDEO_HW=no
        grep -q 'Using hardware decoding (vaapi' "$D/video.mpv.log" && VIDEO_HW=yes
        {
            echo "file:     $(basename "$VIDEO")"
            echo "seconds:  $SECS"
            echo "hwdec:    $VIDEO_HW"
            echo "cpu_avg:  ${VIDEO_CPU}% (toàn máy, mọi luồng)"
            echo
            grep -Ei 'hardware decoding|VO:|Video --vid|error|fail' "$D/video.mpv.log" || true
        } > "$D/video.txt"
    else
        echo "(không có mpv)" > "$D/video.txt"
    fi
fi

# đạt / chưa đạt so với README.md, "Thông số mục tiêu"
verdict() { [ -z "$1" ] && echo "—" || { awk -v a="$1" -v b="$2" 'BEGIN { exit !(a < b) }' && echo "✅" || echo "❌"; }; }
case "$SESSION" in *i3*) RAM_GOAL=400 RAM_TXT="~350 MB (i3)" ;; *) RAM_GOAL=700 RAM_TXT="< 700 MB (XFCE)" ;; esac
{
    echo "# $M — Depot OS $V"
    echo
    echo "Đo $(date -u +%Y-%m-%dT%H:%MZ) bằng \`depot-results $M\` · $LIVE · phiên $SESSION · uptime $(awk '{printf "%d phút", $1/60}' /proc/uptime)."
    echo
    echo "| Chỉ số | Mục tiêu | Đo được | |"
    echo "|---|---|---|---|"
    echo "| RAM đã dùng (free 'used') | $RAM_TXT | ${RAM_USED} MB | $(verdict "$RAM_USED" "$RAM_GOAL") |"
    echo "| Boot (systemd-analyze) | < 40 s | ${BOOT_S:-?} s | $(verdict "$BOOT_S" 40) |"
    echo "| VA-API H.264 (vainfo) | có | $VAAPI_H264 | $([ "$VAAPI_H264" = yes ] && echo ✅ || echo ❌) |"
    if [ -n "$VIDEO" ]; then
        echo "| mpv giải mã phần cứng | vaapi | ${VIDEO_HW:-?} | $([ "$VIDEO_HW" = yes ] && echo ✅ || echo ❌) |"
        echo "| CPU khi phát video | < 40 % | ${VIDEO_CPU:-?} % | $(verdict "$VIDEO_CPU" 40) |"
    fi
    echo
    echo "**Điều kiện** (tự điền): máy thật hay VM; SSD/HDD/USB; màn hình và độ phân giải; để rảnh bao lâu"
    echo "trước khi đo; app nào đang mở; cắm sạc hay pin."
} > "$D/SUMMARY.md"

echo ">> xong: $D"
cat "$D/SUMMARY.md"
