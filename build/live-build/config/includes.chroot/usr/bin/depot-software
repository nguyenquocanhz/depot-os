#!/bin/sh
# Depot OS — mở GNOME Software ("Phần mềm") và TẮT HẲN sau khi đóng cửa sổ.
# Đóng cửa sổ xong GNOME Software vẫn chạy ngầm (~250 MB RAM) tới lúc đăng xuất — máy 4 GB không gánh nổi.
#   depot-software [tham số của gnome-software]   (menu, dock, nhấp đúp file .deb đều gọi lệnh này)
#   depot-software --patch   (root) trỏ file .desktop của GNOME Software về lệnh này, bỏ DBusActivatable
#                            (không thì dock/GIO mở thẳng qua D-Bus, bỏ qua lệnh này); apt tự gọi sau mỗi lần cài gói
APPS=/usr/share/applications

patch() {
    for f in "$APPS/org.gnome.Software.desktop" "$APPS/gnome-software-local-file-packagekit.desktop"; do
        [ -f "$f" ] || continue
        sed -i -e 's#^Exec=\(/usr/bin/\)\?gnome-software#Exec=depot-software#' -e '/^DBusActivatable=/d' "$f"
    done
}

# cửa sổ GNOME Software đang hiện? (đọc thẳng X, không cần WM hỗ trợ EWMH: chạy được cả XFCE lẫn i3)
visible() {
    for w in $(xwininfo -root -tree 2>/dev/null | awk '/\("gnome-software" / { print $1 }'); do
        xwininfo -id "$w" 2>/dev/null | grep -q 'IsViewable' && return 0
    done
    return 1
}

# byte GNOME Software đã đọc (cả socket mạng): tăng nhanh = đang tải app, chưa được tắt
rchar() { awk '/^rchar/ { print $2 }' "/proc/$1/io" 2>/dev/null || echo 0; }

[ "${1:-}" = --patch ] && { patch; exit 0; }

gnome-software "$@" &
# đợi cửa sổ hiện (lần mở đầu nạp danh mục có thể lâu)
i=0
until visible; do
    sleep 1; i=$((i + 1))
    [ $i -ge 90 ] && exit 0
done
# cửa sổ đóng + 20 giây không tải gì → tắt hẳn. Đang cài dở thì đợi tiếp:
# gói Debian do packagekitd cài (vẫn chạy khi tắt GNOME Software), app Flatpak thì tải trong chính tiến trình này
idle=0
while pid=$(pgrep -u "$(id -u)" -x gnome-software | head -1) && [ -n "$pid" ]; do
    a=$(rchar "$pid"); sleep 5; b=$(rchar "$pid")
    if visible || [ $((b - a)) -gt 262144 ]; then
        idle=0
    else
        idle=$((idle + 1))
        [ $idle -ge 4 ] && { gnome-software --quit; exit 0; }
    fi
done
