# ====================================================================== tiện ích

def which(cmd):
    return shutil.which(cmd)


def run(argv, timeout=6):
    """Chạy lệnh, trả (mã thoát, stdout, stderr). Không ném lỗi."""
    try:
        p = subprocess.run(argv, capture_output=True, text=True, timeout=timeout, env=C_ENV,
                           stdin=subprocess.DEVNULL)
        return p.returncode, p.stdout, p.stderr
    except (OSError, subprocess.SubprocessError) as e:
        return 1, '', str(e)


def spawn(argv):
    try:
        subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
        return True
    except OSError:
        return False


def bg(fn, done=None):
    """Chạy fn ở luồng phụ (lệnh ngoài có thể chậm), xong gọi done(kết quả) trên luồng giao diện."""
    def work():
        try:
            r = fn()
        except Exception as e:                      # noqa: BLE001 — một mục hỏng không được làm sập cả app
            print('depot-settings:', e, file=sys.stderr)
            r = None
        if done:
            GLib.idle_add(lambda: (done(r), False)[1])
    threading.Thread(target=work, daemon=True).start()


def read(path, default=''):
    try:
        with open(path, encoding='utf-8', errors='replace') as f:
            return f.read().strip()
    except OSError:
        return default


def conf_value(path, key, default=''):
    for line in read(path).splitlines():
        k, _, v = line.strip().partition('=')
        if k == key:
            return v.strip().strip('"')
    return default


def conf_set(path, key, value):
    """Đổi một khoá trong file KEY=VALUE, giữ nguyên các dòng khác."""
    lines = [l for l in read(path).splitlines() if l.split('=', 1)[0].strip() != key]
    lines.append('%s=%s' % (key, value))
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, 'w', encoding='utf-8') as f:
            f.write('\n'.join(lines) + '\n')
    except OSError:
        pass


def fold(text):
    """Bỏ dấu tiếng Việt + chữ thường, để tìm 'man hinh' ra 'Màn hình'."""
    t = unicodedata.normalize('NFD', text.lower().replace('đ', 'd'))
    return ''.join(c for c in t if not unicodedata.combining(c))


_cache, _cache_lock = {}, threading.Lock()


def cached(fn, ttl=1.5):
    """Nhiều mục cùng hỏi một trạng thái (vd âm thanh) trong một lần làm mới thì chỉ chạy lệnh một lần."""
    def wrap():
        now = time.monotonic()
        with _cache_lock:
            hit = _cache.get(fn)
            if hit and now - hit[0] < ttl:
                return hit[1]
        val = fn()
        with _cache_lock:
            _cache[fn] = (time.monotonic(), val)
        return val
    return wrap


def flush_cache():
    with _cache_lock:
        _cache.clear()


def app_info(desktop_id):
    try:
        return Gio.DesktopAppInfo.new(desktop_id)
    except TypeError:
        return None


def launch(target):
    """target: 'ten.desktop' (mở theo file .desktop: đúng lệnh, đúng terminal, có báo đang mở) hoặc [lệnh…]."""
    if isinstance(target, str):
        info = app_info(target)
        if info is None:
            return False
        try:
            ctx = Gdk.Display.get_default().get_app_launch_context()
            return info.launch([], ctx)
        except GLib.Error:
            return False
    return spawn(target)


def available(target):
    if isinstance(target, str):
        return app_info(target) is not None
    return bool(target) and which(target[0]) is not None


def pick_icon(*names):
    theme = Gtk.IconTheme.get_default()
    for n in names:
        if theme.has_icon(n):
            return n
    return 'applications-system-symbolic'


def xfconf_get(channel, prop, default=''):
    rc, out, _ = run(['xfconf-query', '-c', channel, '-p', prop])
    return out.strip() if rc == 0 else default


def xfconf_set(channel, prop, typ, value):
    return run(['xfconf-query', '-c', channel, '-p', prop, '-n', '-t', typ, '-s', str(value)])[0] == 0


class Latest:
    """Kéo thanh trượt sinh rất nhiều giá trị: chỉ áp giá trị mới nhất, không xếp hàng lệnh."""

    def __init__(self, fn):
        self.fn, self.value, self.busy = fn, None, False
        self.lock = threading.Lock()

    def push(self, value):
        with self.lock:
            self.value = value
            if self.busy:
                return
            self.busy = True
        threading.Thread(target=self._work, daemon=True).start()

    def _work(self):
        while True:
            with self.lock:
                v, self.value = self.value, None
                if v is None:
                    self.busy = False
                    return
            try:
                self.fn(v)
            except Exception as e:                  # noqa: BLE001
                print('depot-settings:', e, file=sys.stderr)


# ====================================================================== hệ thống: đọc / đổi trạng thái

# ---- Màn hình
def bl_dir():
    dirs = sorted(glob.glob('/sys/class/backlight/*'))
    return dirs[0] if dirs else None


def bl_get():
    d = bl_dir()
    if not d:
        return None
    try:
        return round(int(read(d + '/brightness')) * 100 / max(1, int(read(d + '/max_brightness'))))
    except ValueError:
        return None


def bl_set(pct):
    d = bl_dir()
    if not d:
        return
    try:
        mx = int(read(d + '/max_brightness'))
    except ValueError:
        return
    val = max(1, round(mx * max(1, min(100, pct)) / 100))
    try:        # logind đổi đèn nền cho phiên đang ngồi trước máy — không cần root
        bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
        bus.call_sync('org.freedesktop.login1', '/org/freedesktop/login1/session/auto',
                      'org.freedesktop.login1.Session', 'SetBrightness',
                      GLib.Variant('(ssu)', ('backlight', os.path.basename(d), val)), None,
                      Gio.DBusCallFlags.NONE, 2000, None)
        return
    except GLib.Error:
        pass
    try:
        with open(d + '/brightness', 'w') as f:
            f.write(str(val))
    except OSError:
        pass


@cached
def screens():
    """{'outs': [tên], 'night': bool, 'mode': '1920 × 1080', 'hz': '144', 'name': 'eDP1'}; None = không có xrandr."""
    rc, out, _ = run(['xrandr', '--current', '--verbose'])
    if rc:
        return None
    st = {'outs': [], 'night': False, 'mode': '', 'hz': '', 'name': ''}
    cur = None
    for line in out.splitlines():
        m = re.match(r'^(\S+) (connected|disconnected)(?: primary)? ?(\d+x\d+)?', line)
        if m:
            cur = m.group(1) if m.group(2) == 'connected' else None
            if cur:
                st['outs'].append(cur)
                if m.group(3) and not st['mode']:
                    st['mode'], st['name'] = m.group(3).replace('x', ' × '), cur
        elif cur and 'Gamma:' in line:
            try:
                vals = [float(v) for v in line.split('Gamma:')[1].strip().split(':')]
            except ValueError:
                vals = [1.0, 1.0, 1.0]
            if any(abs(v - 1.0) > 0.05 for v in vals):
                st['night'] = True
        elif cur == st['name'] and not st['hz']:
            m = re.search(r'\*current', line)
            if m:
                st['_cur'] = True
            elif st.get('_cur') and 'v:' in line:
                m = re.search(r'clock\s+([\d.]+)Hz', line)
                if m:
                    st['hz'] = '%g' % round(float(m.group(1)))
                st['_cur'] = False
    return st if st['outs'] else None


def night_set(on):
    st = screens()
    for o in (st or {}).get('outs', []):
        run(['xrandr', '--output', o, '--gamma', NIGHT_GAMMA if on else '1:1:1'])


SCALES = [('96', '100% (mặc định)'), ('106', '110%'), ('120', '125%'), ('144', '150%')]


def dpi_get():
    v = xfconf_get('xsettings', '/Xft/DPI', '96')
    return '96' if v in ('-1', '') else v


def dpi_set(v):
    xfconf_set('xsettings', '/Xft/DPI', 'int', v)


# ---- Âm thanh (PipeWire / PulseAudio qua pactl)
@cached
def audio_state():
    rc, out, _ = run(['pactl', 'get-sink-volume', '@DEFAULT_SINK@'])
    if rc:
        return None
    m = re.search(r'(\d+)%', out)
    st = {'vol': int(m.group(1)) if m else 0,
          'muted': 'yes' in run(['pactl', 'get-sink-mute', '@DEFAULT_SINK@'])[1]}
    rc, out, _ = run(['pactl', 'get-source-mute', '@DEFAULT_SOURCE@'])
    st['mic'] = None if rc else 'yes' not in out          # None = không có micro
    m = re.search(r'(\d+)%', run(['pactl', 'get-source-volume', '@DEFAULT_SOURCE@'])[1])
    st['mic_vol'] = int(m.group(1)) if m else None
    return st


@cached
def audio_sinks():
    """([(tên, mô tả)], tên mặc định)"""
    default = run(['pactl', 'get-default-sink'])[1].strip()
    try:
        data = json.loads(run(['pactl', '-f', 'json', 'list', 'sinks'])[1])
    except ValueError:
        data = []
    return [(s.get('name', ''), s.get('description') or s.get('name', '')) for s in data], default


def vol_icon(vol, muted):
    if muted or vol == 0:
        return 'audio-volume-muted-symbolic'
    return 'audio-volume-high-symbolic' if vol >= 66 else 'audio-volume-medium-symbolic' if vol >= 33 \
        else 'audio-volume-low-symbolic'


# ---- Không làm phiền
def dnd_backend():
    if which('depot-notify'):
        return 'depot'
    if which('xfconf-query') and run(['xfconf-query', '-c', 'xfce4-notifyd', '-l'])[0] == 0:
        return 'xfce'
    return None


def dnd_get():
    be = dnd_backend()
    if be == 'depot':
        st = os.path.join(RUN, 'depot-notify.state')
        if os.path.exists(st):
            return conf_value(st, 'DND') == '1'
        return conf_value(NOTIFY_CONF, 'DND') == '1'
    if be == 'xfce':
        return xfconf_get('xfce4-notifyd', '/do-not-disturb') == 'true'
    return None


def dnd_set(on):
    if dnd_backend() == 'depot':
        run(['depot-notify', 'dnd', 'on' if on else 'off'])
    else:
        xfconf_set('xfce4-notifyd', '/do-not-disturb', 'bool', 'true' if on else 'false')


# ---- Pin
POWER_MODES = [('auto', 'Tự động'), ('off', 'Tắt tiết kiệm'), ('low', 'Low'), ('medium', 'Medium'),
               ('high', 'High'), ('ultra', 'Ultra')]


def power_mode():
    m = conf_value(os.path.join(CONFIG, 'depot', 'power'), 'MODE', 'auto')
    return m if m in dict(POWER_MODES) else 'auto'


def battery():
    """(phần trăm, mô tả, icon) hoặc None nếu máy không có pin."""
    for d in sorted(glob.glob('/sys/class/power_supply/BAT*')):
        cap, status = read(d + '/capacity'), read(d + '/status')
        if not cap.isdigit():
            continue
        if status == 'Full' or (status != 'Discharging' and int(cap) >= 99):
            return int(cap), 'Đã sạc đầy, đang cắm điện', 'battery-full-charged-symbolic'
        if status == 'Charging':
            return int(cap), 'Đang sạc', 'battery-good-charging-symbolic'
        return int(cap), 'Đang dùng pin', 'battery-good-symbolic'
    return None


# ---- Lưu trữ
def gb(n):
    return ('%.1f GB' % (n / 1e9)).replace('.', ',')


def disks():
    """[(tên hiển thị, điểm gắn, đã dùng, tổng)]"""
    out, seen = [], set()
    points = ['/']
    for line in read('/proc/mounts').splitlines():
        f = line.split()
        if len(f) >= 3 and f[1].startswith(('/media/', '/mnt/', '/run/media/')) and \
                f[2] in ('ext4', 'ext3', 'vfat', 'exfat', 'ntfs', 'ntfs3', 'fuseblk', 'btrfs', 'xfs', 'f2fs'):
            points.append(f[1].replace('\\040', ' '))
    for p in points:
        try:
            u = shutil.disk_usage(p)
            dev = os.stat(p).st_dev
        except OSError:
            continue
        if dev in seen or u.total == 0:
            continue
        seen.add(dev)
        out.append(('Ổ hệ thống' if p == '/' else os.path.basename(p) or p, p, u.used, u.total))
    return out


# ---- Bluetooth
def bt_present():
    if not which('bluetoothctl'):
        return False
    if glob.glob('/sys/class/bluetooth/hci*'):
        return True
    return any(read(p) == 'bluetooth' for p in glob.glob('/sys/class/rfkill/*/type'))


def bt_rfkill(block):
    """Chặn / bỏ chặn sóng Bluetooth (như `rfkill block bluetooth`), qua /dev/rfkill — không cần root."""
    try:
        fd = os.open('/dev/rfkill', os.O_WRONLY)
        try:
            os.write(fd, struct.pack('IBBBB', 0, 2, 3, 1 if block else 0, 0))   # type=BLUETOOTH, op=CHANGE_ALL
        finally:
            os.close(fd)
        return True
    except OSError:
        return False


@cached
def bt_powered():
    return bool(re.search(r'^\s*Powered:\s*yes', run(['bluetoothctl', 'show'], timeout=4)[1], re.M))


def bt_devices(kind):
    out = run(['bluetoothctl', 'devices', kind], timeout=4)[1]
    return [(m.group(1), m.group(2)) for m in re.finditer(r'^Device (\S+) (.+)$', out, re.M)]


def bt_set(on):
    if on:
        bt_rfkill(False)
        for _ in range(10):
            run(['bluetoothctl', 'power', 'on'], timeout=5)
            flush_cache()
            if bt_powered():
                return True
            time.sleep(0.4)
        return False
    run(['bluetoothctl', 'power', 'off'], timeout=5)
    bt_rfkill(True)
    return True


def bt_list():
    """[(mac, tên, đang kết nối)] các thiết bị đã ghép; [] khi Bluetooth tắt."""
    if not bt_powered():
        return []
    con = {m for m, _n in bt_devices('Connected')}
    return [(m, n, m in con) for m, n in bt_devices('Paired')]


def bt_connect(mac, connect=True):
    rc, out, _ = run(['bluetoothctl', 'connect' if connect else 'disconnect', mac], timeout=25)
    return rc == 0 and 'Failed' not in out


# ---- Máy in (CUPS)
PRINT_INSTALL = 'sudo apt install cups system-config-printer'


def printers():
    """[(tên, trạng thái, là mặc định)]; None = máy chưa cài CUPS."""
    if not which('lpstat'):
        return None
    out = run(['lpstat', '-p', '-d'], timeout=8)[1]
    m = re.search(r'system default destination: (\S+)', out)
    default = m.group(1) if m else ''
    res = []
    for m in re.finditer(r'^printer (\S+) (is idle|now printing|disabled)', out, re.M):
        state = {'is idle': 'Sẵn sàng', 'now printing': 'Đang in', 'disabled': 'Đang tạm dừng'}[m.group(2)]
        res.append((m.group(1), state, m.group(1) == default))
    return res


# ---- Mạng (NetworkManager)
def nm_split(line):
    return [p.replace('\\:', ':').replace('\\\\', '\\') for p in re.split(r'(?<!\\):', line)]


@cached
def net_state():
    """None = máy không có NetworkManager."""
    rc, out, _ = run(['nmcli', '-t', '-f', 'DEVICE,TYPE,STATE,CONNECTION', 'dev'])
    if rc:
        return None
    st = {'dev': None, 'on': False, 'state': '', 'ssid': '', 'signal': 0, 'eth': None, 'eth_state': '', 'ip': ''}
    conn = ''
    for line in out.splitlines():
        f = nm_split(line)
        if len(f) < 4:
            continue
        if f[1] == 'wifi' and st['dev'] is None:
            st['dev'], st['state'], conn = f[0], f[2], f[3]
        elif f[1] == 'ethernet' and st['eth'] is None:
            st['eth'], st['eth_state'] = f[0], f[2]
    if st['dev']:
        st['on'] = run(['nmcli', '-t', '-f', 'WIFI', 'radio'])[1].strip() == 'enabled'
        if st['on'] and st['state'].startswith('connected'):
            out = run(['nmcli', '-t', '-f', 'IN-USE,SSID,SIGNAL', 'dev', 'wifi', 'list', 'ifname', st['dev'],
                       '--rescan', 'no'])[1]
            for line in out.splitlines():
                f = nm_split(line)
                if len(f) >= 3 and f[0] == '*':
                    st['ssid'] = f[1]
                    st['signal'] = int(f[2]) if f[2].isdigit() else 0
            st['ssid'] = st['ssid'] or conn
    use = st['eth'] if st['eth_state'].startswith('connected') else st['dev'] if st['ssid'] else None
    if use:
        out = run(['nmcli', '-t', '-f', 'IP4.ADDRESS', 'dev', 'show', use])[1]
        m = re.search(r'IP4\.ADDRESS\[\d+\]:([\d.]+)', out)
        st['ip'] = m.group(1) if m else ''
    return st


def wifi_set(on):
    run(['nmcli', 'radio', 'wifi', 'on' if on else 'off'])


def wifi_list(rescan='auto'):
    """[(ssid, tín hiệu, có khoá, đang dùng, đã lưu)] — mạng đang dùng trên cùng, rồi mạnh nhất trước."""
    saved = set()
    for line in run(['nmcli', '-t', '-f', 'NAME,TYPE', 'con', 'show'])[1].splitlines():
        f = nm_split(line)
        if len(f) >= 2 and f[1] == '802-11-wireless':
            saved.add(f[0])
    out = run(['nmcli', '-t', '-f', 'IN-USE,SSID,SIGNAL,SECURITY', 'dev', 'wifi', 'list', '--rescan', rescan],
              timeout=20)[1]
    nets = {}
    for line in out.splitlines():
        f = nm_split(line)
        if len(f) < 4 or not f[1]:
            continue
        sig = int(f[2]) if f[2].isdigit() else 0
        sec = f[3].strip() not in ('', '--')
        old = nets.get(f[1])
        if old is None or f[0] == '*' or (sig > old[1] and not old[3]):
            nets[f[1]] = (f[1], sig, sec, f[0] == '*' or bool(old and old[3]), f[1] in saved)
    return sorted(nets.values(), key=lambda n: (not n[3], -n[1]))


def wifi_connect(ssid, password=None, saved=False):
    """Trả (thành công, thông báo lỗi)."""
    if saved and not password:
        rc, out, err = run(['nmcli', '--wait', '30', 'con', 'up', 'id', ssid], timeout=40)
    else:
        argv = ['nmcli', '--wait', '30', 'dev', 'wifi', 'connect', ssid]
        if password:
            argv += ['password', password]
        rc, out, err = run(argv, timeout=40)
    msg = (err or out).strip().splitlines()
    return rc == 0, (msg[-1] if msg else '')


def wifi_disconnect(dev):
    run(['nmcli', 'dev', 'disconnect', dev], timeout=15)


def wifi_icon(sig, on=True, connected=True):
    if not on:
        return 'network-wireless-disabled-symbolic'
    if not connected:
        return 'network-wireless-offline-symbolic'
    if sig >= 60:
        return 'network-wireless-signal-excellent-symbolic'
    if sig >= 40:
        return 'network-wireless-signal-good-symbolic'
    if sig >= 20:
        return 'network-wireless-signal-ok-symbolic'
    return 'network-wireless-signal-weak-symbolic'


def airplane_get():
    st = net_state()
    if st is None:
        return None
    radios = run(['nmcli', '-t', '-f', 'WIFI,WWAN', 'radio'])[1].strip().split(':')
    return all(r == 'disabled' for r in radios) and not (bt_present() and bt_powered())


def airplane_set(on):
    if on:
        if bt_present():
            conf_set(CONF, 'AIRPLANE_BT', '1' if bt_powered() else '0')
            bt_set(False)
        run(['nmcli', 'radio', 'all', 'off'])
    else:
        run(['nmcli', 'radio', 'all', 'on'])
        if bt_present() and conf_value(CONF, 'AIRPLANE_BT') == '1':      # Bluetooth trước đó đang bật thì bật lại
            bt_set(True)


# ---- Cá nhân hoá
def wallpaper_path():
    out = run(['xfconf-query', '-c', 'xfce4-desktop', '-lv'])[1]
    best = [l for l in out.splitlines() if 'workspace0/last-image' in l] or \
           [l for l in out.splitlines() if 'last-image' in l]
    for l in best:
        p = l.split(None, 1)[1].strip() if len(l.split(None, 1)) > 1 else ''
        if os.path.isfile(p):
            return p
    return None


EFFECTS = [('auto', 'Tự chọn theo máy'), ('best', 'Đẹp nhất'), ('fast', 'Nhanh nhất')]
