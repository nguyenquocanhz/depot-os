    # ---- Giới thiệu
    def build_about(self):
        p = self.page('about', 'Giới thiệu')
        self.hero(p, pick_icon('depot-logo', 'computer', 'computer-symbolic'), socket.gethostname(),
                  lambda: conf_value('/etc/os-release', 'PRETTY_NAME', 'Linux'))
        p.add(Gtk.Box(height_request=6))
        p.section('Cấu hình máy')
        text = ['']

        def build(box, rows):
            text[0] = '\n'.join('%s: %s' % (k, v.replace('\n', ', ')) for k, v in rows or [])
            grid = Gtk.Grid(column_spacing=32, row_spacing=10)
            grid.get_style_context().add_class('st-card')
            for i, (k, v) in enumerate(rows or []):
                kl = label(k, 'st-row-sub')
                kl.set_valign(Gtk.Align.START)
                grid.attach(kl, 0, i, 1, 1)
                vl = label(v, 'st-row-title', wrap=True, selectable=True)
                grid.attach(vl, 1, i, 1, 1)
            box.pack_start(grid, False, False, 0)
        p.dynamic(about_info, build)
        p.index('Cấu hình máy', 'CPU, RAM, đồ hoạ, hệ điều hành', 'computer-symbolic', 'specs cau hinh chip')

        def copy():
            Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD).set_text(text[0], -1)
            btn.set_label('Đã sao chép')
            GLib.timeout_add(1500, lambda: (btn.set_label('Sao chép'), False)[1])
        btn = text_button('Sao chép', copy)
        p.card('edit-copy-symbolic', 'Sao chép cấu hình', 'Chép các dòng trên để gửi khi cần hỗ trợ',
               trailing=[btn], keywords='copy specs')
        self.update_rows(p)
        p.section('Xem thêm')
        p.link('computer-symbolic', 'Giới thiệu máy này', 'Tên máy, chip, đồ hoạ, RAM, ổ đĩa', 'depot-about.desktop')
        p.link('starred-symbolic', 'Phiên bản Depot', 'Home, Pro hay for Workstation', 'depot-edition.desktop',
               'edition')
        p.link('utilities-system-monitor-symbolic', 'Chẩn đoán main (Boot Diag)',
               'Main, chipset, BIOS, khe RAM, khả năng nâng cấp CPU', 'depot-bootdiag.desktop', 'bios mainboard')
        p.link('help-about-symbolic', 'Thông tin về XFCE', 'Phiên bản các thành phần desktop', 'xfce4-about.desktop')
        p.link('preferences-other-symbolic', 'Trình quản lý cài đặt XFCE', 'Mọi hộp thoại cài đặt gốc của XFCE',
               'xfce-settings-manager.desktop', 'xfce settings manager')

    # ------------------------------------------------------------------ chụp từng trang (để kiểm tra giao diện)
    def shoot(self, outdir, ids):
        os.makedirs(outdir, exist_ok=True)
        ids = list(ids)

        def step():
            if self.shoot_last:
                gw = self.get_window()
                pb = Gdk.pixbuf_get_from_window(gw, 0, 0, gw.get_width(), gw.get_height())
                if pb:
                    pb.savev(os.path.join(outdir, self.shoot_last + '.png'), 'png', [], [])
            if not ids:
                self.close()
                return False
            self.shoot_last = ids.pop(0)
            self.go(self.shoot_last)
            return True
        self.shoot_last = None
        GLib.timeout_add(1800, step)


class App(Gtk.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE)
        self.win = None

    def do_command_line(self, cl):
        args = cl.get_arguments()[1:]
        if args and args[0] in ('-h', '--help'):
            cl.print_literal('dùng: depot-settings [TRANG]\ntrang: %s\n' % ' '.join(
                ['system', 'display', 'sound', 'notifications', 'power', 'storage', 'devices', 'printers', 'network', 'wifi',
                 'personalize', 'apps', 'time', 'access', 'about']))
            return 0
        if self.win is None:
            self.win = Window(self)
        if args and args[0] == '--shots' and len(args) > 1:
            self.win.present()
            self.win.shoot(args[1], args[2:] or [p for p in self.win.pages if p != 'search'])
            return 0
        if args and args[0] == '--search':
            self.win.search.set_text(' '.join(args[1:]))
        elif args:
            if args[0] in self.win.pages:
                self.win.go(args[0])
            else:
                cl.printerr_literal('depot-settings: không có trang "%s"\n' % args[0])
        self.win.present()
        return 0


if __name__ == '__main__':
    sys.exit(App().run(sys.argv))
