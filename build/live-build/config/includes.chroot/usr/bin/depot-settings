    def build_storage(self):
        p = self.page('storage', 'Lưu trữ', 'system')

        def build(box, data):
            for name, point, used, total in data or []:
                row = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
                row.get_style_context().add_class('st-card')
                top = Gtk.Box(spacing=16)
                top.pack_start(image('drive-harddisk-symbolic', 20), False, False, 0)
                top.pack_start(label('%s (%s)' % (name, point), 'st-row-title'), True, True, 0)
                top.pack_end(label('Còn trống %s' % gb(total - used), 'st-row-value', xalign=1.0), False, False, 0)
                row.pack_start(top, False, False, 0)
                bar = Gtk.ProgressBar()
                bar.set_fraction(used / total)
                row.pack_start(bar, False, False, 0)
                row.pack_start(label('Đã dùng %s trong %s' % (gb(used), gb(total)), 'st-row-sub'), False, False, 0)
                box.pack_start(row, False, False, 0)
        p.dynamic(disks, build)
        p.index('Dung lượng ổ đĩa', 'Đã dùng, còn trống', 'drive-harddisk-symbolic', 'disk space o cung')
        p.link('drive-removable-media-symbolic', 'Lưu dữ liệu trên USB',
               'Vùng lưu mã hoá trên USB đang boot: giữ tệp và cài đặt qua lần khởi động sau',
               'depot-persist.desktop', 'persistence usb')
        p.link('folder-symbolic', 'Mở trình quản lý tệp', 'Xem và dọn các thư mục', 'thunar.desktop', 'thunar file')

    # ---- Bluetooth và thiết bị
    def build_devices(self):
        p = self.page('devices', 'Bluetooth và thiết bị')
        if bt_present():
            def bt_sub():
                if not bt_powered():
                    return 'Đang tắt'
                con = [n for _m, n in bt_devices('Connected')]
                return 'Đang kết nối: ' + ', '.join(con) if con else 'Đang bật, chưa kết nối thiết bị nào'
            c = p.switch('bluetooth-symbolic', 'Bluetooth', '', bt_powered, bt_set, 'bluetooth tai nghe loa')
            p.refreshers.append(lambda: bg(bt_sub, c.set_sub))

            def build(box, devs):
                for mac, name, con in devs or []:
                    def act(mac=mac, con=con):
                        bg(lambda: bt_connect(mac, not con), lambda _r: (flush_cache(), self.refresh_soon()))
                    card = Card('bluetooth-active-symbolic' if con else 'bluetooth-symbolic', name,
                                'Đã kết nối' if con else 'Đã ghép đôi',
                                trailing=[text_button('Ngắt' if con else 'Kết nối', act)])
                    box.pack_start(card.widget, False, False, 0)
            p.dynamic(bt_list, build)
            p.link('list-add-symbolic', 'Thêm thiết bị', 'Dò và ghép đôi tai nghe, loa, chuột, bàn phím Bluetooth',
                   'blueman-manager.desktop', 'pair ghep doi')
        else:
            p.note('Máy này không có Bluetooth.')
        p.nav('printer-symbolic', 'Máy in và máy quét', 'Máy in đã cài, thêm máy in, in thử, quét tài liệu',
              'printers')
        p.section('Thiết bị nhập')
        p.link('input-mouse-symbolic', 'Chuột và touchpad', 'Tốc độ, nút trái/phải, cuộn, chạm để bấm',
               'xfce-mouse-settings.desktop', 'mouse touchpad chuot')
        p.link(pick_icon('tool-pointer-symbolic', 'input-mouse-symbolic'), 'Con trỏ chuột',
               'Kiểu và cỡ con trỏ', 'depot-cursor.desktop', 'cursor pointer')
        p.link(pick_icon('preferences-desktop-keyboard-symbolic', 'input-keyboard-symbolic'), 'Bàn phím', 'Tốc độ lặp phím, phím tắt ứng dụng, bố cục',
               'xfce-keyboard-settings.desktop', 'keyboard shortcut phim tat layout')
        p.link(pick_icon('accessories-character-map-symbolic', 'input-keyboard-symbolic'), 'Bộ gõ tiếng Việt (Unikey)', 'Kiểu gõ VNI / Telex, phím chuyển V–E',
               'depot-unikey.desktop', 'unikey telex vni go tieng viet fcitx')

    def build_printers(self):
        p = self.page('printers', 'Máy in và máy quét', 'devices')
        p.index('Máy in và máy quét', 'Máy in đã cài, thêm máy in, in thử', 'printer-symbolic', 'printer in an cups scan')

        def build(box, data):
            if data is None:
                box.pack_start(label('Bản Depot OS chạy từ USB chưa cài dịch vụ in (CUPS) nên chưa nhận máy in. '
                                     'Cài bằng lệnh dưới đây trong Terminal (cần mạng, tải khoảng 10 MB), rồi mở lại '
                                     'trang này. Khi cài Depot OS vào ổ cứng thì phần in ấn được cài sẵn.',
                                     'st-note', wrap=True), False, False, 0)

                def copy():
                    Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD).set_text(PRINT_INSTALL, -1)
                    btn.set_label('Đã sao chép')
                    GLib.timeout_add(1500, lambda: (btn.set_label('Sao chép lệnh'), False)[1])
                btn = text_button('Sao chép lệnh', copy)
                card = Card('utilities-terminal-symbolic', PRINT_INSTALL, 'Lệnh cài dịch vụ in và công cụ thêm máy in',
                            trailing=[btn] + ([text_button('Mở Terminal', lambda: launch('xfce4-terminal.desktop'))]
                                              if available('xfce4-terminal.desktop') else []))
                card.title.set_selectable(True)
                box.pack_start(card.widget, False, False, 0)
                return
            if not data:
                box.pack_start(label('Chưa có máy in nào. Cắm máy in (USB) hoặc bật máy in mạng rồi bấm '
                                     '"Thêm máy in".', 'st-note', wrap=True), False, False, 0)
            for name, state, default in data:
                def make_default(name=name):
                    bg(lambda: run(['lpoptions', '-d', name]), lambda _r: self.refresh_soon())

                def test(name=name):
                    page = '/usr/share/cups/data/testprint'
                    bg(lambda: run(['lp', '-d', name, page] if os.path.exists(page) else ['lp', '-d', name,
                                                                                            '/etc/os-release']))
                trail = [text_button('In thử', test)]
                if not default:
                    trail.append(text_button('Đặt mặc định', make_default))
                card = Card('printer-symbolic', name, state + (' · máy in mặc định' if default else ''),
                            trailing=trail)
                box.pack_start(card.widget, False, False, 0)
        p.dynamic(printers, build)
        p.link('list-add-symbolic', 'Thêm và quản lý máy in', 'Dò máy in USB / mạng, chọn driver, hàng đợi in',
               'system-config-printer.desktop', 'add printer driver')
        if which('lpstat') and not available('system-config-printer.desktop'):
            p.card('list-add-symbolic', 'Thêm và quản lý máy in', 'Mở trang quản lý CUPS trong trình duyệt',
                   on_click=lambda: spawn(['xdg-open', 'http://localhost:631/admin']),
                   chevron=pick_icon('external-link-symbolic', 'go-next-symbolic'))
        p.link('scanner-symbolic', 'Quét tài liệu', 'Quét ảnh, tài liệu từ máy quét hoặc máy in đa năng',
               'simple-scan.desktop', 'scan scanner may quet')

    # ---- Mạng và Internet
    def build_network(self):
        p = self.page('network', 'Mạng và Internet')
        if not which('nmcli'):
            p.note('Máy này không dùng NetworkManager nên không chỉnh mạng ở đây được.')
            return

        def status():
            st = net_state()
            if not st:
                return None
            if st['eth_state'].startswith('connected'):
                return 'Mạng dây — đã kết nối' + (' · %s' % st['ip'] if st['ip'] else '')
            if st['ssid']:
                return 'Wi‑Fi "%s" — đã kết nối' % st['ssid'] + (' · %s' % st['ip'] if st['ip'] else '')
            return 'Chưa kết nối mạng'
        h = self.hero(p, pick_icon('network-wireless-symbolic'), 'Trạng thái mạng', status, px=36)

        def hero_icon(st):
            if st:
                wired = st['eth_state'].startswith('connected')
                h.image.set_from_icon_name('network-wired-symbolic' if wired else
                                           wifi_icon(st['signal'], st['on'], bool(st['ssid'])), Gtk.IconSize.MENU)
        p.refreshers.append(lambda: bg(net_state, hero_icon))
        p.add(Gtk.Box(height_request=6))
        c = p.switch('network-wireless-symbolic', 'Wi‑Fi', '', lambda: (net_state() or {}).get('on'), wifi_set,
                     'wifi wireless khong day')

        def wifi_sub(st):
            if st and st['dev']:
                c.set_sub('Đã kết nối "%s"' % st['ssid'] if st['ssid'] else 'Đang bật' if st['on'] else 'Đang tắt')
            else:
                c.set_sub('Máy này không có card Wi‑Fi')
                c.switch.set_sensitive(False)
        p.refreshers.append(lambda: bg(net_state, wifi_sub))
        p.nav('network-wireless-signal-excellent-symbolic', 'Hiện các mạng Wi‑Fi', 'Chọn mạng, nhập mật khẩu, '
              'ngắt kết nối', 'wifi')

        def eth():
            st = net_state()
            if not st or not st['eth']:
                return 'Máy này không có cổng mạng dây'
            return {'connected': 'Đã kết nối', 'unavailable': 'Chưa cắm dây',
                    'disconnected': 'Đã cắm dây, chưa kết nối'}.get(st['eth_state'].split(' ')[0],
                                                                    st['eth_state']) + ' · ' + st['eth']
        p.info('network-wired-symbolic', 'Mạng dây (Ethernet)', eth, keywords='lan ethernet day mang')
        p.switch('airplane-mode-symbolic', 'Chế độ máy bay', 'Tắt hết sóng: Wi‑Fi và Bluetooth',
                 airplane_get, airplane_set, 'airplane flight tat song')
        p.section('Nâng cao')
        p.link('network-server-symbolic', 'DNS và Proxy', 'Đổi máy chủ DNS (kể cả DNS mã hoá) và proxy cho mọi mạng',
               'depot-dns-proxy.desktop', 'dns proxy nextdns cloudflare')
        p.link('preferences-system-network-symbolic', 'Cài đặt mạng nâng cao', 'IP tĩnh, VPN, mạng ẩn, sửa/xoá '
               'mạng đã lưu', 'nm-connection-editor.desktop', 'ip tinh vpn static hidden')

    def build_wifi(self):
        p = self.page('wifi', 'Wi‑Fi', 'network')
        if not which('nmcli'):
            return
        p.switch('network-wireless-symbolic', 'Wi‑Fi', 'Bật để dò và kết nối mạng không dây',
                 lambda: (net_state() or {}).get('on'), wifi_set)
        status = label('', 'st-note', wrap=True)
        rescan = ['auto']

        def get():
            st = net_state()
            if not st or not st['dev'] or not st['on']:
                return ('off', ())
            mode, rescan[0] = rescan[0], 'no'
            return ('on', tuple(wifi_list(mode)))

        def build(box, data):
            state, nets = data if data else ('off', ())
            if state == 'off':
                box.pack_start(label('Wi‑Fi đang tắt.', 'st-note'), False, False, 0)
                return
            if not nets:
                box.pack_start(label('Chưa thấy mạng nào. Bấm "Quét lại".', 'st-note'), False, False, 0)
            for ssid, sig, sec, used, saved in nets:
                sub = 'Đã kết nối' if used else ('Đã lưu' if saved else 'Có mật khẩu' if sec else 'Mạng mở')
                outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
                outer.get_style_context().add_class('st-card')
                top = Gtk.Box()
                top.pack_start(image(wifi_icon(sig), 20, 'st-row-icon'), False, False, 0)
                col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
                col.pack_start(label(ssid, 'st-row-title'), False, False, 0)
                col.pack_start(label('%s · tín hiệu %d%%' % (sub, sig), 'st-row-sub'), False, False, 0)
                top.pack_start(col, True, True, 0)
                if sec and not used:
                    top.pack_end(image('network-wireless-encrypted-symbolic', 14, 'st-chev'), False, False, 0)
                outer.pack_start(top, False, False, 0)
                ask = Gtk.Box(spacing=8)
                ask.set_no_show_all(True)
                entry = Gtk.Entry()
                entry.set_visibility(False)
                entry.set_placeholder_text('Mật khẩu Wi‑Fi')
                entry.get_style_context().add_class('st-field')
                entry.set_input_purpose(Gtk.InputPurpose.PASSWORD)
                ask.pack_start(entry, True, True, 0)

                def connect(password=None, ssid=ssid, saved=saved, ask=ask, entry=entry):
                    status.set_text('Đang kết nối "%s"…' % ssid)
                    box.hold = False

                    def done(r):
                        ok, msg = r or (False, '')
                        status.set_text('Đã kết nối "%s".' % ssid if ok else
                                        'Không kết nối được "%s"%s' % (ssid, ': ' + msg if msg else '.'))
                        flush_cache()
                        box.reset()
                        self.refresh_soon()
                    bg(lambda: wifi_connect(ssid, password, saved), done)

                def clicked(_b=None, sec=sec, saved=saved, used=used, ask=ask, entry=entry, connect=connect):
                    if used:
                        st = net_state()
                        bg(lambda: wifi_disconnect(st['dev']),
                           lambda _r: (flush_cache(), box.reset(), self.refresh_soon()))
                    elif sec and not saved:
                        box.hold = True                  # đang nhập mật khẩu: đừng dựng lại danh sách
                        ask.show()
                        for w in ask.get_children():
                            w.show()
                        entry.grab_focus()
                    else:
                        connect()
                btn = text_button('Ngắt kết nối' if used else 'Kết nối', clicked)
                top.pack_end(btn, False, False, 0)
                ok = text_button('Kết nối', lambda entry=entry, connect=connect: connect(entry.get_text()),
                                 accent=True)
                entry.connect('activate', lambda e, connect=connect: connect(e.get_text()))

                def cancel(ask=ask):
                    box.hold = False
                    ask.hide()
                ask.pack_start(ok, False, False, 0)
                ask.pack_start(text_button('Huỷ', cancel), False, False, 0)
                outer.pack_start(ask, False, False, 0)
                box.pack_start(outer, False, False, 0)
        head = Gtk.Box()
        head.pack_start(label('Mạng có sẵn', 'st-section'), True, True, 0)
        lst = [None]

        def do_rescan():
            rescan[0] = 'yes'
            status.set_text('Đang quét…')
            lst[0].hold = False
            lst[0].reset()
            p.refresh()
            GLib.timeout_add(6000, lambda: (status.get_text() == 'Đang quét…' and status.set_text(''), False)[1])
        b = text_button('Quét lại', do_rescan)
        b.set_valign(Gtk.Align.END)
        b.set_margin_bottom(4)
        head.pack_end(b, False, False, 0)
        p.add(head)
        p.add(status)
        lst[0] = p.dynamic(get, build)

        def on_enter():
            rescan[0] = 'auto'
            lst[0].hold = False
        p.on_enter = on_enter

    # ---- Cá nhân hoá
    def build_personalize(self):
        p = self.page('personalize', 'Cá nhân hoá')
        thumb = Gtk.Image()
        thumb.get_style_context().add_class('st-thumb')
        thumb.set_halign(Gtk.Align.START)
        thumb.set_margin_bottom(10)
        thumb.set_no_show_all(True)
        p.add(thumb)
        shown = [None]

        def load():
            path = wallpaper_path()
            if not path or path == shown[0]:
                return None
            try:
                return path, GdkPixbuf.Pixbuf.new_from_file_at_scale(path, 320, 180, True)
            except GLib.Error:
                return None

        def show(r):
            if r:
                shown[0] = r[0]
                thumb.set_from_pixbuf(r[1])
                thumb.show()
        p.refreshers.append(lambda: bg(load, show))
        p.link('preferences-desktop-wallpaper-symbolic', 'Hình nền', 'Album hình nền Depot và ảnh của bạn',
               'depot-wallpaper.desktop', 'wallpaper background anh nen')
        p.dropdown('preferences-color-symbolic', 'Chế độ màu của Cài đặt', 'Nền tối hay sáng cho app Cài đặt này',
                   THEMES, lambda: conf_value(CONF, 'THEME', 'system'), self.set_theme, 'dark light toi sang theme')
        p.link('preferences-desktop-appearance-symbolic', 'Giao diện, biểu tượng, phông chữ',
               'Theme tối/sáng của cả hệ thống, bộ icon, phông và cỡ chữ', 'xfce-ui-settings.desktop',
               'appearance theme icon font')
        if which('depot-effects'):
            p.section('Hiệu ứng')

            def set_fx(k):
                run(['depot-effects', 'set', k], timeout=30)
            p.dropdown('applications-graphics-symbolic', 'Hiệu ứng hình ảnh',
                       'Animation, bóng đổ, mờ dần: đẹp nhất, nhanh nhất hoặc để Depot tự chọn', EFFECTS,
                       lambda: effects_conf('PRESET', 'auto'), set_fx, 'animation shadow hieu ung picom')
            p.switch(pick_icon('view-pin-symbolic', 'starred-symbolic'), 'Dynamic Island',
                     'Viên đen ở giữa phía trên, hiện bài nhạc đang phát',
                     lambda: effects_conf('ISLAND', '1') == '1',
                     lambda on: run(['depot-effects', 'island', 'on' if on else 'off'], timeout=30),
                     'island nhac music')
            p.link('applications-graphics-symbolic', 'Bật tắt từng hiệu ứng', 'Animation cửa sổ, bóng đổ, mờ dần, '
                   'widget, phóng to dock…', 'depot-effects.desktop')
        p.section('Bố cục desktop')

        def layout():
            return 'Đang dùng kiểu %s — đổi sang macOS, Windows 10 hoặc Windows 11' % \
                LAYOUTS.get(run(['depot-layout', 'current'])[1].strip(), '?')
        c = p.link('view-dual-symbolic', 'Bố cục desktop', 'Kiểu macOS, Windows 10 hoặc Windows 11',
                   'depot-layout.desktop', 'layout taskbar dock macos windows')
        if c:
            p.refreshers.append(lambda: bg(layout, c.set_sub))

        def clock():
            return 'Đồng hồ đang ở %s thanh panel' % CLOCKS.get(run(['depot-clock', 'current'])[1].strip(), '?')
        c2 = p.link('preferences-system-time-symbolic', 'Vị trí đồng hồ', 'Bên trái, ở giữa hoặc bên phải thanh panel',
                    'depot-clock.desktop', 'clock dong ho')
        if c2:
            p.refreshers.append(lambda: bg(clock, c2.set_sub))
        p.link(pick_icon('dock-symbolic', 'view-list-symbolic'), 'Thanh tác vụ (panel)',
               'Kích thước, vị trí, các nút và khay hệ thống', 'panel-preferences.desktop', 'taskbar panel')
        p.link('preferences-desktop-wallpaper-symbolic', 'Biểu tượng trên màn hình nền', 'Hiện/ẩn icon, menu chuột '
               'phải của desktop', 'xfce-backdrop-settings.desktop', 'desktop icons')
        p.section('Cửa sổ')
        p.link('focus-windows-symbolic', 'Cửa sổ', 'Kiểu thanh tiêu đề, phím tắt cửa sổ, cách lấy tiêu điểm',
               'xfce-wm-settings.desktop', 'window manager xfwm')
        p.link('focus-windows-symbolic', 'Tinh chỉnh cửa sổ', 'Dính cạnh, chuyển cửa sổ Alt+Tab, compositor',
               'xfce-wmtweaks-settings.desktop', 'tweaks alt tab snap')
        p.link('view-grid-symbolic', 'Không gian làm việc', 'Số lượng và tên các desktop ảo',
               'xfce-workspaces-settings.desktop', 'workspace desktop ao')

    def set_theme(self, mode):
        conf_set(CONF, 'THEME', mode)
        GLib.idle_add(lambda: (self.apply_theme(), False)[1])

    # ---- Ứng dụng
    def build_apps(self):
        p = self.page('apps', 'Ứng dụng')
        p.link('preferences-desktop-default-applications-symbolic', 'Ứng dụng mặc định',
               'Trình duyệt, thư, trình quản lý tệp; loại tệp nào mở bằng app nào', 'xfce4-mime-settings.desktop',
               'default apps mime trinh duyet mac dinh')
        p.link('system-run-symbolic', 'Khởi động cùng máy', 'Ứng dụng tự chạy khi đăng nhập, lưu phiên làm việc',
               'xfce-session-settings.desktop', 'autostart startup tu khoi dong session')
        p.link('system-software-install-symbolic', 'Cài và gỡ phần mềm', 'Kho Debian và Flathub',
               'org.gnome.Software.desktop', 'software store cai dat go')
        p.link('utilities-system-monitor-symbolic', 'Quản lý tác vụ', 'Xem và tắt ứng dụng đang chạy',
               'xfce4-taskmanager.desktop', 'task manager')
        if which('depot-webview'):
            # Mini App của Telegram: depot-webview biết máy đang có bản WebKitGTK nào và sửa (cần quyền quản trị)
            def wv_state():
                rc, out, _ = run(['depot-webview', 'status'])
                lines = [l for l in out.splitlines() if l.startswith('Telegram')]
                return rc == 10, (lines[0] if lines else out.strip())

            def wv_show(r):
                need, text = r or (False, '')
                wv.set_sub(text if need else 'Đang ổn — ' + text if text else '')
                wv_btn.set_sensitive(need)
                set_class(wv_btn, 'accent', need)

            def wv_fix():
                wv_btn.set_sensitive(False)
                wv.set_sub('Đang sửa… (hệ thống sẽ hỏi mật khẩu quản trị)')

                def done(r):
                    rc, out, err = r or (1, '', '')
                    tail = [l for l in (out or err).splitlines() if l.strip()]
                    if rc:
                        wv.set_sub('Chưa sửa được: ' + (tail[-1].lstrip('!> ') if tail else 'đã huỷ'))
                        wv_btn.set_sensitive(True)
                    else:
                        self.toast('Đã sửa. Thoát hẳn Telegram rồi mở lại để thử Mini App.')
                        self.refresh_soon()
                bg(lambda: run(['depot-webview', 'fix'], timeout=900), done)
            wv_btn = text_button('Sửa', wv_fix)
            wv = p.card('applications-internet-symbolic', 'Mini App của Telegram',
                        'Mini App / Mini Game không mở được, cửa sổ trắng hoặc tự đóng', trailing=[wv_btn],
                        keywords='telegram mini app game webkit webkitgtk webview')
            p.refreshers.append(lambda: bg(wv_state, wv_show))
        p.section('Cài đặt của từng ứng dụng')
        p.link('folder-symbolic', 'Trình quản lý tệp', 'Cách hiện tệp, thanh bên, hành vi của Thunar',
               'thunar-settings.desktop', 'thunar file manager')
        p.link('utilities-terminal-symbolic', 'Terminal', 'Phông chữ, màu, phím tắt của Terminal',
               'xfce4-terminal-settings.desktop', 'terminal')
        p.link('edit-paste-symbolic', 'Bộ nhớ tạm', 'Lịch sử sao chép (Win+V)', 'xfce4-clipman-settings.desktop',
               'clipboard')

    # ---- Thời gian và ngôn ngữ
    def build_time(self):
        p = self.page('time', 'Thời gian và ngôn ngữ')

        def now():
            days = ['Thứ Hai', 'Thứ Ba', 'Thứ Tư', 'Thứ Năm', 'Thứ Sáu', 'Thứ Bảy', 'Chủ Nhật']
            t = time.localtime()
            return '%s, %02d/%02d/%d · %s' % (days[t.tm_wday], t.tm_mday, t.tm_mon, t.tm_year,
                                              tz_get() or time.tzname[0])
        h = self.hero(p, 'preferences-system-time-symbolic', time.strftime('%H:%M'), now, px=36)
        p.refreshers.append(lambda: h.title.set_text(time.strftime('%H:%M')))
        p.add(Gtk.Box(height_request=6))
        p.section('Ngày giờ')
        if which('timedatectl') and which('depot-region'):
            p.switch('preferences-system-time-symbolic', 'Tự đồng bộ giờ', 'Lấy giờ chuẩn qua Internet', ntp_get,
                     lambda on: run(['depot-region', 'ntp', 'on' if on else 'off'], timeout=60), 'ntp dong bo gio')
            p.card('view-refresh-symbolic', 'Đồng bộ giờ ngay', 'Chỉnh lại đồng hồ theo máy chủ giờ',
                   trailing=[text_button('Đồng bộ', lambda: bg(
                       lambda: run(['depot-region', 'sync'], timeout=60), lambda _r: self.refresh_soon()))],
                   keywords='sync time')

        def region():
            out = run(['depot-region', 'status'])[1]
            lang = re.search(r'Ngôn ngữ:\s*(\S+)', out)
            tz = re.search(r'Múi giờ:\s*(\S+)', out)
            return ' · '.join(m.group(1) for m in (lang, tz) if m) or None
        c = p.link('preferences-desktop-locale-symbolic', 'Ngôn ngữ, múi giờ, máy chủ giờ',
                   'Đổi ngôn ngữ hiển thị, múi giờ', 'depot-region.desktop', 'language timezone locale mui gio')
        if c and which('depot-region'):
            p.refreshers.append(lambda: bg(region, lambda r: r and c.set_sub(
                '%s — bấm để đổi ngôn ngữ hiển thị, múi giờ' % r)))
        p.section('Gõ chữ')
        p.link(pick_icon('accessories-character-map-symbolic', 'input-keyboard-symbolic'), 'Bộ gõ tiếng Việt (Unikey)', 'Kiểu gõ VNI / Telex / VIQR, bảng mã, phím '
               'chuyển V–E', 'depot-unikey.desktop', 'unikey telex vni go dau')
        p.link(pick_icon('preferences-desktop-keyboard-symbolic', 'input-keyboard-symbolic'), 'Bố cục bàn phím', 'Thêm bố cục phím (US, Việt…), phím đổi bố cục',
               'xfce-keyboard-settings.desktop', 'keyboard layout')
        p.link('preferences-other-symbolic', 'Cấu hình Fcitx 5', 'Thêm bộ gõ ngôn ngữ khác, phím tắt bộ gõ',
               'fcitx5-configtool.desktop' if available('fcitx5-configtool.desktop')
               else 'org.fcitx.fcitx5-config-qt.desktop', 'fcitx input method')

