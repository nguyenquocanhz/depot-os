               'xfce4-clipman-settings.desktop', 'clipboard clipman copy paste dán')
        p.link('applications-system-symbolic', 'Driver phần cứng',
               'Thiết bị đang chạy driver gì, cài driver còn thiếu', 'depot-drivers.desktop', 'nvidia firmware wifi')
        p.link(pick_icon('sensors-temperature-symbolic', 'utilities-system-monitor-symbolic'), 'Cảm biến phần cứng',
               'Nhiệt độ CPU/GPU, quạt, điện áp, kiểm tra nhiệt', 'depot-hwmon.desktop', 'nhiet do temperature fan')
