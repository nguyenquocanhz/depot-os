            p.dropdown('zoom-in-symbolic', 'Tỉ lệ', 'Cỡ chữ và giao diện của mọi ứng dụng', SCALES,
                       dpi_get, dpi_set, 'scale dpi co chu to nho font size')

        def res():
            st = screens()
