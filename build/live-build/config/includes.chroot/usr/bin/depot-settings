        self.lock_rows(p)

    def lock_rows(self, p):
        """Công tắc ô báo Num Lock / Caps Lock (dùng ở trang Thông báo và Trợ năng)."""
        kinds = [k for k in ('num', 'caps') if lock_backend(k)]
        if not kinds:
            return
        p.section('Báo phím khoá trên màn hình')
        rows = {'num': ('input-dialpad-symbolic', 'Báo Num Lock', 'Bấm Num Lock thì hiện ô ổ khoá chữ "Num" trên màn hình',
                        'numlock phim so osd', '--test-num'),
                'caps': (pick_icon('caps-lock-symbolic', 'input-keyboard-symbolic'), 'Báo Caps Lock',
                         'Bấm Caps Lock thì hiện ô ổ khoá chữ "A" trên màn hình', 'capslock chu hoa osd', '--test')}
        for kind in kinds:
            icon_name, title, sub, words, test = rows[kind]
            extra = None
            if lock_backend(kind) == 'capslock':
                extra = [text_button('Thử', lambda test=test: spawn([capslock_bin(), test]))]
            p.switch(icon_name, title, sub, lambda kind=kind: lock_get(kind), lambda on, kind=kind: lock_set(kind, on),
                     words, extra=extra)

    def update_rows(self, p):
        """Thẻ cập nhật OTA của gói depot-capslock (ô báo Caps Lock / Num Lock) — chỉ hiện khi máy có gói đó."""
        ver = capslock_version()
        if not ver:
            return
        p.section('Cập nhật')
        new = [False]

        def click():
            btn.set_sensitive(False)
            if new[0]:
                card.set_sub('Đang tải và cài bản mới…')
                bg(lambda: capslock_update('--update'), done)
            else:
                card.set_sub('Đang hỏi kho mã nguồn…')
                bg(lambda: capslock_update('--check-update'), show)

        def done(r):
            _ok, msg = r or (False, 'Không chạy được lệnh cập nhật.')
            new[0] = False
            btn.set_label('Kiểm tra cập nhật')
            btn.set_sensitive(True)
            set_class(btn, 'accent', False)
            card.set_sub(msg)

        def show(r):
            new[0], msg = r or (False, 'Không kiểm tra được.')
            btn.set_sensitive(True)
            card.set_sub(msg)
            btn.set_label('Cập nhật' if new[0] else 'Kiểm tra cập nhật')
            set_class(btn, 'accent', new[0])
        btn = text_button('Kiểm tra cập nhật', click)
        card = p.card('software-update-available-symbolic', 'Ô báo Caps Lock / Num Lock (depot-capslock)',
                      'Phiên bản %s' % ver, trailing=[btn], keywords='update cap nhat ota phien ban version')
        p.switch('view-refresh-symbolic', 'Tự kiểm tra bản mới', 'Mỗi ngày hỏi một lần, có bản mới thì báo — '
                 'không tự cài', lambda: conf_value(CAPS_CONF, 'UPDATE_CHECK', '1') != '0',
                 lambda on: conf_set(CAPS_CONF, 'UPDATE_CHECK', '1' if on else '0'), 'auto update')

