# ---- Thời gian
def ntp_get():
    rc, out, _ = run(['timedatectl', 'show', '-p', 'NTP', '--value'])
    return None if rc else out.strip() == 'yes'


def tz_get():
    return run(['timedatectl', 'show', '-p', 'Timezone', '--value'])[1].strip()


# ---- Ô báo Caps Lock / Num Lock
# Trên Depot OS ô báo nằm trong depot-notify (CAPS_OSD / NUM_OSD trong ~/.config/depot/notify). Phím nào depot-notify
# của máy chưa báo (ISO cũ chưa có Num Lock) hoặc máy không có depot-notify thì do gói depot-capslock báo
# (CAPSLOCK / NUMLOCK trong ~/.config/depot-capslock.conf). Mỗi phím chỉ một nơi báo.
LOCK_KEYS = {'caps': ('CAPS_OSD', 'CAPSLOCK'), 'num': ('NUM_OSD', 'NUMLOCK')}


@cached
def notify_keys():
    """Các phím depot-notify của máy này tự báo."""
    try:
        with open('/usr/bin/depot-notify', 'rb') as f:
            src = f.read()
    except OSError:
        return set()
    have = set()
    if b'class LockOSD' in src:
        have.add('caps')
        if b'get_num_lock_state' in src:
            have.add('num')
    return have


def capslock_bin():
    return which('depot-capslock')


def capslock_version():
    exe = capslock_bin()
    m = re.search(r'(\d+(?:\.\d+)+)', run([exe, '--version'])[1]) if exe else None
    return m.group(1) if m else ''


def lock_backend(kind):
    """'notify' | 'capslock' | None — nơi báo phím này trên máy."""
    if kind in notify_keys():
        return 'notify'
    ver = capslock_version()
    if ver and (kind == 'caps' or tuple(int(x) for x in ver.split('.')[:2]) >= (1, 1)):   # Num Lock có từ bản 1.1
        return 'capslock'
    return None


def lock_get(kind):
    be = lock_backend(kind)
    if be == 'notify':
        return conf_value(NOTIFY_CONF, LOCK_KEYS[kind][0], '1') != '0'
    if be == 'capslock':
        return conf_value(CAPS_CONF, 'ENABLED', '1') != '0' and conf_value(CAPS_CONF, LOCK_KEYS[kind][1], '1') != '0'
    return None


def lock_set(kind, on):
    be = lock_backend(kind)
    if be == 'notify':
        conf_set(NOTIFY_CONF, LOCK_KEYS[kind][0], '1' if on else '0')
    elif be == 'capslock':
        if on and conf_value(CAPS_CONF, 'ENABLED', '1') == '0':
            # ENABLED=0 đang tắt cả hai: bật lại cho phím này, phím kia giữ nguyên là tắt
            other = 'num' if kind == 'caps' else 'caps'
            conf_set(CAPS_CONF, LOCK_KEYS[other][1], '0')
            conf_set(CAPS_CONF, 'ENABLED', '1')
        conf_set(CAPS_CONF, LOCK_KEYS[kind][1], '1' if on else '0')
        if on:
            spawn([capslock_bin()])              # chưa chạy nền thì chạy; đang chạy rồi thì bản mới tự thoát


def capslock_update(cmd):
    """depot-capslock --check-update → (có bản mới?, thông báo); --update → (thành công?, thông báo)."""
    rc, out, err = run([capslock_bin(), cmd], timeout=300)
    msg = (out or err).strip().splitlines()
    return (rc == 10 if cmd == '--check-update' else rc == 0), (msg[-1] if msg else '')


# ---- Giới thiệu
def about_info():
    """[(nhãn, giá trị)]"""
    rows = []
    vendor = read('/sys/class/dmi/id/sys_vendor')
    model = read('/sys/class/dmi/id/product_name')
    if model and model.lower() not in ('to be filled by o.e.m.', 'system product name', 'default string'):
        rows.append(('Kiểu máy', ('%s %s' % (vendor, model)).strip() if vendor.lower() not in model.lower() else model))
    cpu = ''
    for line in read('/proc/cpuinfo').splitlines():
        if line.startswith('model name'):
            cpu = re.sub(r'\s+', ' ', line.split(':', 1)[1]).strip()
            break
    if cpu:
        rows.append(('Bộ xử lý', '%s (%d luồng)' % (cpu, os.cpu_count() or 1)))
    m = re.search(r'MemTotal:\s+(\d+)', read('/proc/meminfo'))
    if m:
        rows.append(('RAM', ('%.1f GB' % (int(m.group(1)) / 1048576)).replace('.', ',')))
    if which('lspci'):
        gpus = [re.sub(r'\s*\(rev [0-9a-f]+\)$', '', l.split(': ', 1)[1]) for l in run(['lspci'])[1].splitlines()
                if re.search(r'VGA|3D controller|Display controller', l) and ': ' in l]
        if gpus:
            rows.append(('Đồ hoạ', '\n'.join(gpus)))
    for name, _p, used, total in disks()[:1]:
        rows.append(('Lưu trữ', 'Đã dùng %s / %s' % (gb(used), gb(total))))
    osr = {}
    for line in read('/etc/os-release').splitlines():
        k, _, v = line.partition('=')
        osr[k] = v.strip('"')
    rows.append(('Hệ điều hành', osr.get('PRETTY_NAME', 'Linux')))
    if which('depot-edition'):
        ed = run(['depot-edition', 'current'])[1].strip()
        if ed:
            rows.append(('Phiên bản Depot', ed.capitalize()))
    rows.append(('Nhân Linux', os.uname().release))
    m = re.search(r'xfce4-session\s+([\d.]+)', run(['xfce4-session', '--version'])[1]) if which('xfce4-session') \
        else None
    rows.append(('Desktop', 'XFCE %s (X11)' % m.group(1) if m else os.environ.get('XDG_CURRENT_DESKTOP', '')))
    return rows


# ====================================================================== các mảnh giao diện

def label(text='', cls=None, xalign=0.0, wrap=False, selectable=False):
    l = Gtk.Label(label=text)
    l.set_xalign(xalign)
    if wrap:
        l.set_line_wrap(True)
        l.set_line_wrap_mode(Pango.WrapMode.WORD_CHAR)
        l.set_max_width_chars(60)
    else:
        l.set_ellipsize(Pango.EllipsizeMode.END)
    l.set_selectable(selectable)
    if cls:
        for c in cls.split():
            l.get_style_context().add_class(c)
    return l


def image(name, px=16, cls=None):
    img = Gtk.Image.new_from_icon_name(name, Gtk.IconSize.MENU)
    img.set_pixel_size(px)
    if cls:
        img.get_style_context().add_class(cls)
    return img


def set_class(widget, cls, on):
    ctx = widget.get_style_context()
    (ctx.add_class if on else ctx.remove_class)(cls)


def text_button(text, cb, accent=False):
    b = Gtk.Button(label=text)
    b.get_style_context().add_class('st-btn')
    if accent:
        b.get_style_context().add_class('accent')
    b.set_valign(Gtk.Align.CENTER)
    b.set_can_focus(False)
    b.connect('clicked', lambda *_: cb())
    return b


class Dropdown(Gtk.MenuButton):
    """Ô chọn kiểu Windows 11: nút hiện giá trị + mũi tên, bấm ra danh sách có vạch màu nhấn ở mục đang chọn."""

    def __init__(self, options, on_pick):
        super().__init__()
        self.options, self.on_pick, self.value = list(options), on_pick, None
        self.get_style_context().add_class('st-btn')
        self.set_valign(Gtk.Align.CENTER)
        self.set_can_focus(False)
        box = Gtk.Box(spacing=10)
        self.text = label('', 'st-drop-label')
        box.pack_start(self.text, True, True, 0)
        box.pack_end(image('pan-down-symbolic', 12), False, False, 0)
        self.add(box)
        self.pop = Gtk.Popover()
        self.pop.get_style_context().add_class('st-pop')
        self.pop.set_position(Gtk.PositionType.BOTTOM)
        self.set_popover(self.pop)
        self.fill()

    def fill(self):
        old = self.pop.get_child()
        if old:
            self.pop.remove(old)
        col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        for key, name in self.options:
            b = Gtk.Button()
            b.get_style_context().add_class('st-item')
            set_class(b, 'on', key == self.value)
            row = Gtk.Box()
            pill = Gtk.Box()
            pill.get_style_context().add_class('st-pill')
            pill.set_valign(Gtk.Align.CENTER)
            row.pack_start(pill, False, False, 0)
            row.pack_start(label(name), True, True, 0)
            b.add(row)
            b.connect('clicked', self._picked, key)
            col.pack_start(b, False, False, 0)
        col.show_all()
        self.pop.add(col)

    def _picked(self, _b, key):
        self.pop.popdown()
        if key != self.value:
            self.set_value(key)
            self.on_pick(key)

    def set_options(self, options):
        if list(options) != self.options:
            self.options = list(options)
            self.fill()
            self.set_value(self.value)

    def set_value(self, key, fallback='Tuỳ chỉnh'):
        self.value = key
        self.text.set_text(dict(self.options).get(key, fallback if key is not None else '…'))
        self.fill()


class Card:
    """Một thẻ cài đặt: icon · tên + mô tả một dòng · điều khiển / mũi tên bên phải."""

    def __init__(self, icon_name, title, sub=None, trailing=None, on_click=None, chevron=None):
        row = Gtk.Box()
        self.icon = image(icon_name, 20, 'st-row-icon')
        self.icon.set_valign(Gtk.Align.CENTER)
        row.pack_start(self.icon, False, False, 0)
        text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
        text.set_valign(Gtk.Align.CENTER)
        self.title = label(title, 'st-row-title')
        self.sub = label(sub or '', 'st-row-sub')
        self.sub.set_no_show_all(True)
        self.sub.set_visible(bool(sub))
        text.pack_start(self.title, False, False, 0)
        text.pack_start(self.sub, False, False, 0)
        row.pack_start(text, True, True, 0)
        self.trail = Gtk.Box(spacing=8)
        self.trail.set_valign(Gtk.Align.CENTER)
        self.trail.set_margin_start(16)
        for w in trailing or []:
            self.trail.pack_start(w, False, False, 0)
        row.pack_end(self.trail, False, False, 0)
        if on_click:
            if chevron:
                row.pack_end(image(chevron, 14, 'st-chev'), False, False, 0)
                row.reorder_child(self.trail, -1)
            self.widget = Gtk.Button()
            self.widget.add(row)
            self.widget.set_can_focus(False)
            self.widget.connect('clicked', lambda *_: on_click())
        else:
            self.widget = row
        self.widget.get_style_context().add_class('st-card')

    def set_sub(self, text):
        self.sub.set_text(text or '')
        self.sub.set_visible(bool(text))

    def set_icon(self, name):
        self.icon.set_from_icon_name(name, Gtk.IconSize.MENU)


class Page:
    """Một trang: cột các thẻ. Mỗi điều khiển đăng ký một hàm làm mới (đọc lại trạng thái thật của máy)."""

    def __init__(self, win, pid, title, parent=None, icon=None):
        self.win, self.id, self.title, self.parent, self.icon = win, pid, title, parent, icon
        self.refreshers = []
        self.box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        self.box.get_style_context().add_class('st-page')
        clamp = Gtk.Box()
        self.box.set_size_request(-1, -1)
        clamp.pack_start(self.box, True, True, 0)
        self.scroll = Gtk.ScrolledWindow()
        self.scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        self.scroll.add(clamp)

    # ---- dựng
    def add(self, widget):
        self.box.pack_start(widget, False, False, 0)
        return widget

    def index(self, title, sub, icon_name, keywords=''):
        self.win.search_index.append((fold(' '.join([title, sub or '', keywords, self.title])), title,
                                      sub or '', icon_name, self.id))

    def section(self, text):
        return self.add(label(text, 'st-section'))

    def note(self, text):
        return self.add(label(text, 'st-note', wrap=True))

    def card(self, icon_name, title, sub=None, trailing=None, on_click=None, chevron=None, keywords='',
             index=True):
        c = Card(icon_name, title, sub, trailing, on_click, chevron)
        self.add(c.widget)
        if index:
            self.index(title, sub, icon_name, keywords)
        return c

    def nav(self, icon_name, title, sub, page_id, keywords=''):
        return self.card(icon_name, title, sub, on_click=lambda: self.win.go(page_id), chevron='go-next-symbolic',
                         keywords=keywords, index=False)

    def link(self, icon_name, title, sub, target, keywords=''):
        """Mở một công cụ sẵn có của máy. Máy không có công cụ đó thì không tạo thẻ."""
        if not available(target):
            return None
        return self.card(icon_name, title, sub, on_click=lambda: self.win.open_tool(target, title),
                         chevron=pick_icon('external-link-symbolic', 'go-next-symbolic'), keywords=keywords)

    def switch(self, icon_name, title, sub, get, set_, keywords='', extra=None):
        sw = Gtk.Switch()
        sw.set_valign(Gtk.Align.CENTER)
        sw.set_can_focus(False)
        state = label('', 'st-switch-text', xalign=1.0)
        c = self.card(icon_name, title, sub, trailing=(extra or []) + [state, sw], keywords=keywords)
        busy = [0]

        def show(v):
            if busy[0]:
                return
            sw.set_sensitive(v is not None)
            on = bool(v)
            if sw.get_active() != on:
                sw.handler_block(hid)
                sw.set_active(on)
                sw.handler_unblock(hid)
            state.set_text('Bật' if on else 'Tắt')

        def changed(s, _p):
            on = s.get_active()
            state.set_text('Bật' if on else 'Tắt')
            busy[0] += 1

            def done(_r):
                busy[0] -= 1
                flush_cache()
                self.win.refresh_soon()
            bg(lambda: set_(on), done)
        hid = sw.connect('notify::active', changed)
        self.refreshers.append(lambda: bg(get, show))
        c.switch = sw
        return c

    def slider(self, icon_name, title, get, set_, sub=None, keywords='', icon_for=None):
        adj = Gtk.Adjustment(value=0, lower=0, upper=100, step_increment=1, page_increment=10)
        sc = Gtk.Scale(orientation=Gtk.Orientation.HORIZONTAL, adjustment=adj)
        sc.set_draw_value(False)
        sc.set_size_request(260, -1)
        sc.set_can_focus(False)
        val = label('', 'st-row-value', xalign=1.0)
        val.set_width_chars(3)
        c = self.card(icon_name, title, sub, trailing=[val, sc], keywords=keywords)
        latest = Latest(set_)
        touched = [0.0]

        def show(v):
            if time.monotonic() - touched[0] < 2.0:          # đang kéo: không giật thanh trượt về giá trị cũ
                return
            sc.set_sensitive(v is not None)
            if v is None:
                val.set_text('')
                return
            sc.handler_block(hid)
            adj.set_value(v)
            sc.handler_unblock(hid)
            val.set_text(str(int(v)))
            if icon_for:
                c.set_icon(icon_for(int(v)))

        def changed(_s):
            v = int(round(adj.get_value()))
            touched[0] = time.monotonic()
            val.set_text(str(v))
            if icon_for:
                c.set_icon(icon_for(v))
            latest.push(v)
        hid = sc.connect('value-changed', changed)
        self.refreshers.append(lambda: bg(get, show))
        c.scale = sc
        return c

    def dropdown(self, icon_name, title, sub, options, get, set_, keywords='', get_options=None):
        def picked(key):
            def done(_r):
                flush_cache()
                self.win.refresh_soon()
            bg(lambda: set_(key), done)
        dd = Dropdown(options, picked)
        c = self.card(icon_name, title, sub, trailing=[dd], keywords=keywords)

        def show(r):
            if r is None:
                dd.set_sensitive(False)
                return
            dd.set_sensitive(True)
            if get_options:
                opts, key = r
                dd.set_options(opts)
            else:
                key = r
            if key != dd.value:
                dd.set_value(key)
        self.refreshers.append(lambda: bg((lambda: (get_options(), get())) if get_options else get, show))
        c.dropdown = dd
        return c

    def info(self, icon_name, title, get, sub=None, keywords='', trailing=None):
        """Thẻ chỉ hiện thông tin; get() trả chữ cho dòng mô tả (hoặc (mô tả, icon))."""
        c = self.card(icon_name, title, sub, trailing=trailing, keywords=keywords)

        def show(r):
            if isinstance(r, tuple):
                c.set_sub(r[0])
                if r[1]:
                    c.set_icon(r[1])
            elif r is not None:
                c.set_sub(r)
        self.refreshers.append(lambda: bg(get, show))
        return c

    def dynamic(self, get, build):
        """Danh sách thay đổi theo máy (mạng Wi-Fi, thiết bị Bluetooth): dựng lại khi dữ liệu đổi."""
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        self.add(box)
        last = [object()]

        def show(data):
            if data == last[0] or getattr(box, 'hold', False):
                return
            last[0] = data
            for w in box.get_children():
                box.remove(w)
            build(box, data)
            box.show_all()
        self.refreshers.append(lambda: bg(get, show))
        box.reset = lambda: last.__setitem__(0, object())
        return box

    def refresh(self):
        for fn in self.refreshers:
            fn()


# ====================================================================== cửa sổ chính

NAV = [   # (id trang, tên, icon thanh bên)
    ('system', 'Hệ thống', ('computer',)),
    ('devices', 'Bluetooth và thiết bị', ('bluetooth', 'preferences-system-bluetooth', 'bluetooth-symbolic')),
    ('network', 'Mạng và Internet', ('preferences-system-network', 'network-wireless', 'network-wireless-symbolic')),
    ('personalize', 'Cá nhân hoá', ('preferences-desktop-wallpaper', 'preferences-desktop-theme',
                                    'preferences-desktop-wallpaper-symbolic')),
    ('apps', 'Ứng dụng', ('preferences-desktop-default-applications', 'applications-other', 'view-app-grid-symbolic')),
    ('time', 'Thời gian và ngôn ngữ', ('preferences-system-time', 'preferences-desktop-locale',
                                       'preferences-system-time-symbolic')),
    ('access', 'Trợ năng', ('preferences-desktop-accessibility', 'preferences-desktop-accessibility-symbolic')),
    ('about', 'Giới thiệu', ('help-about', 'dialog-information', 'help-about-symbolic')),
]


class Window(Gtk.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title='Cài đặt')
        self.set_default_size(1100, 760)
        self.set_size_request(760, 480)
        self.set_icon_name('preferences-system')
        self.get_style_context().add_class('st-win')
        self.search_index = []
        self.pages = {}
        self.history = []
        self.current = None
        self.refresh_id = None
        self.css = Gtk.CssProvider()
        Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), self.css,
                                                 Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION + 20)
        self.apply_theme()
        st = Gtk.Settings.get_default()
        st.connect('notify::gtk-theme-name', lambda *_: self.apply_theme())
        st.connect('notify::gtk-application-prefer-dark-theme', lambda *_: self.apply_theme())

        self.build_titlebar()
        root = Gtk.Box()
        root.get_style_context().add_class('st-root')
        self.add(root)
        root.pack_start(self.build_sidebar(), False, False, 0)
        right = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.crumbs = Gtk.Box()
        self.crumbs.get_style_context().add_class('st-crumbs')
        right.pack_start(self.crumbs, False, False, 0)
        self.stack = Gtk.Stack()
        self.stack.set_transition_type(Gtk.StackTransitionType.CROSSFADE)
        self.stack.set_transition_duration(120)
        right.pack_start(self.stack, True, True, 0)
        root.pack_start(right, True, True, 0)

        self.build_pages()
        self.connect('key-press-event', self.on_key)
        self.connect('notify::is-active', lambda *_: self.is_active() and self.refresh_soon())
        self.connect('window-state-event', self.on_state)
        GLib.timeout_add_seconds(4, self.tick)
        root.show_all()
        self.go('system', record=False)

    # ------------------------------------------------------------------ giao diện tối / sáng
    def theme_mode(self):
        mode = conf_value(CONF, 'THEME', 'system')
        if mode in ('dark', 'light'):
            return mode
        st = Gtk.Settings.get_default()
        name = (st.get_property('gtk-theme-name') or '').lower()
        return 'dark' if 'dark' in name or st.get_property('gtk-application-prefer-dark-theme') else 'light'

    def apply_theme(self):
        pal = PALETTES[self.theme_mode()]
        defs = ''.join('@define-color st_%s %s;\n' % (k, v) for k, v in pal.items())
        defs += '@define-color placeholder_text_color %s;\n' % pal['fg2']
        self.css.load_from_data((defs + CSS).encode())

    # ------------------------------------------------------------------ thanh tiêu đề
    def build_titlebar(self):
        bar = Gtk.Box()
        bar.get_style_context().add_class('st-titlebar')
        self.back = Gtk.Button()
        self.back.add(image('go-previous-symbolic', 16))
        self.back.get_style_context().add_class('st-back')
        self.back.set_tooltip_text('Quay lại (Alt+←)')
        self.back.set_can_focus(False)
        self.back.connect('clicked', lambda *_: self.go_back())
        bar.pack_start(self.back, False, False, 0)
        bar.pack_start(label('Cài đặt', 'st-app-title'), False, False, 0)
        for icon_name, cls, tip, cb in (
                ('window-close-symbolic', 'close', 'Đóng', self.close),
                ('window-maximize-symbolic', 'max', 'Phóng to', self.toggle_max),
                ('window-minimize-symbolic', 'min', 'Thu nhỏ', self.iconify)):
            b = Gtk.Button()
            img = image(icon_name, 14)
            b.add(img)
            b.get_style_context().add_class('st-winbtn')
            b.get_style_context().add_class(cls)
            b.set_tooltip_text(tip)
            b.set_can_focus(False)
            b.set_valign(Gtk.Align.START)
            b.connect('clicked', lambda _b, f=cb: f())
            bar.pack_end(b, False, False, 0)
            if cls == 'max':
                self.max_img, self.max_btn = img, b
        bar.show_all()
        self.set_titlebar(bar)

    def toggle_max(self):
        if self.is_maximized():
            self.unmaximize()
        else:
            self.maximize()

    def on_state(self, _w, ev):
        mx = bool(ev.new_window_state & Gdk.WindowState.MAXIMIZED)
        self.max_img.set_from_icon_name('window-restore-symbolic' if mx else 'window-maximize-symbolic',
                                        Gtk.IconSize.MENU)
        self.max_btn.set_tooltip_text('Thu về' if mx else 'Phóng to')
        return False

    # ------------------------------------------------------------------ thanh bên
    def build_sidebar(self):
        side = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        side.get_style_context().add_class('st-side')
        side.set_size_request(288, -1)
        # người dùng
        user = Gtk.Box(spacing=12)
        user.get_style_context().add_class('st-user')
        user.pack_start(self.avatar(), False, False, 0)
        pw = pwd.getpwuid(os.getuid())
        name = (pw.pw_gecos or '').split(',')[0] or pw.pw_name
        col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
        col.set_valign(Gtk.Align.CENTER)
        col.pack_start(label(name, 'st-user-name'), False, False, 0)
        col.pack_start(label('%s · %s' % (pw.pw_name, socket.gethostname()), 'st-user-sub'), False, False, 0)
        user.pack_start(col, True, True, 0)
        side.pack_start(user, False, False, 0)
        # tìm kiếm
        self.search = Gtk.Entry()
        self.search.set_placeholder_text('Tìm cài đặt')
        self.search.set_icon_from_icon_name(Gtk.EntryIconPosition.SECONDARY, 'system-search-symbolic')
        self.search.get_style_context().add_class('st-search')
        self.search.connect('changed', self.on_search)
        self.search.connect('activate', self.on_search_enter)
        side.pack_start(self.search, False, False, 0)
        # danh mục
        self.nav = Gtk.ListBox()
        self.nav.get_style_context().add_class('st-nav')
        self.nav.set_selection_mode(Gtk.SelectionMode.SINGLE)
        self.nav_rows = {}
        for pid, title, icons in NAV:
            row = Gtk.ListBoxRow()
            row.page_id = pid
            box = Gtk.Box(spacing=0)
            pill = Gtk.Box()
            pill.get_style_context().add_class('st-pill')
            pill.set_valign(Gtk.Align.CENTER)
            box.pack_start(pill, False, False, 0)
            img = image(pick_icon(*icons), 20)
            if pid == 'system':     # bản 16px của icon máy tính là nét đơn sắc: lấy bản màu cỡ lớn rồi thu nhỏ
                try:
                    pb = Gtk.IconTheme.get_default().load_icon(pick_icon(*icons), 48,
                                                               Gtk.IconLookupFlags.FORCE_SIZE)
                    img.set_from_pixbuf(pb.scale_simple(20, 20, GdkPixbuf.InterpType.HYPER))
                except GLib.Error:
                    pass
            img.set_margin_start(10)
            img.set_margin_end(14)
            box.pack_start(img, False, False, 0)
            box.pack_start(label(title, 'st-nav-label'), True, True, 0)
            row.add(box)
            self.nav.add(row)
            self.nav_rows[pid] = row
        self.nav_handler = self.nav.connect('row-selected', self.on_nav)
        sc = Gtk.ScrolledWindow()
        sc.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        sc.add(self.nav)
        side.pack_start(sc, True, True, 0)
        return side

    def avatar(self):
        size = 56
        for p in (os.path.expanduser('~/.face'), os.path.expanduser('~/.face.icon')):
            try:
                pb = GdkPixbuf.Pixbuf.new_from_file_at_scale(p, size, size, False)
            except GLib.Error:
                continue
            area = Gtk.DrawingArea()
            area.set_size_request(size, size)

            def draw(_w, cr, pb=pb):
                import math
                cr.arc(size / 2, size / 2, size / 2, 0, 2 * math.pi)
                cr.clip()
                Gdk.cairo_set_source_pixbuf(cr, pb, 0, 0)
                cr.paint()
            area.connect('draw', draw)
            area.set_valign(Gtk.Align.CENTER)
            return area
        box = Gtk.Box()
        box.get_style_context().add_class('st-avatar')
        img = image('avatar-default-symbolic', 28)
        img.set_halign(Gtk.Align.CENTER)
        box.pack_start(img, True, True, 0)
        box.set_valign(Gtk.Align.CENTER)
        return box

    # ------------------------------------------------------------------ điều hướng
    def page(self, pid, title, parent=None):
        p = Page(self, pid, title, parent)
        self.pages[pid] = p
        self.stack.add_named(p.scroll, pid)
        return p

    def top_of(self, pid):
        while pid in self.pages and self.pages[pid].parent:
            pid = self.pages[pid].parent
        return pid

    def go(self, pid, record=True):
        if pid not in self.pages:
            return
        if record and self.current and self.current != pid:
            self.history.append(self.current)
        self.current = pid
        p = self.pages[pid]
        self.stack.set_visible_child_name(pid)
        p.scroll.get_vadjustment().set_value(0)
        self.back.set_sensitive(bool(self.history))
        # thanh bên
        self.nav.handler_block(self.nav_handler)
        row = self.nav_rows.get(self.top_of(pid))
        if row:
            self.nav.select_row(row)
        else:
            self.nav.unselect_all()
        self.nav.handler_unblock(self.nav_handler)
        # breadcrumb
        for w in self.crumbs.get_children():
            self.crumbs.remove(w)
        chain, q = [], pid
        while q:
            chain.insert(0, q)
            q = self.pages[q].parent
        for i, q in enumerate(chain):
            last = i == len(chain) - 1
            if i:
                self.crumbs.pack_start(label('›', 'st-crumb-sep'), False, False, 0)
            l = label(self.pages[q].title, 'st-crumb' if last else 'st-crumb dim')
            if last:
                self.crumbs.pack_start(l, False, False, 0)
            else:
                b = Gtk.Button()
                b.add(l)
                b.get_style_context().add_class('st-crumb-btn')
                b.set_can_focus(False)
                b.connect('clicked', lambda _b, q=q: self.go(q))
                self.crumbs.pack_start(b, False, False, 0)
        self.crumbs.show_all()
        if pid != 'search' and self.search.get_text():
            self.search.handler_block_by_func(self.on_search)
            self.search.set_text('')
            self.search.handler_unblock_by_func(self.on_search)
        if hasattr(p, 'on_enter'):
            p.on_enter()
        flush_cache()
        p.refresh()

    def go_back(self):
        if self.history:
            self.go(self.history.pop(), record=False)

    def on_nav(self, _lb, row):
        if row is not None:
            self.history.clear()
            self.go(row.page_id, record=False)

    def on_key(self, _w, e):
        alt = e.state & Gdk.ModifierType.MOD1_MASK
        ctrl = e.state & Gdk.ModifierType.CONTROL_MASK
        if (alt and e.keyval == Gdk.KEY_Left) or e.keyval == Gdk.KEY_Back:
            self.go_back()
            return True
        if e.keyval == Gdk.KEY_Escape:
            if self.search.is_focus() and self.search.get_text():
                self.search.set_text('')
            else:
                self.go_back()
            return True
        if ctrl and e.keyval in (Gdk.KEY_f, Gdk.KEY_e, Gdk.KEY_k):
            self.search.grab_focus()
            return True
        return False

    def tick(self):
        if self.is_active() and self.current:
            self.pages[self.current].refresh()
        return True

    def refresh_soon(self):
        if self.refresh_id is None:
            def fire():
                self.refresh_id = None
                if self.current:
                    self.pages[self.current].refresh()
                return False
            self.refresh_id = GLib.timeout_add(350, fire)

    def open_tool(self, target, title):
        if not launch(target):
            self.toast('Không mở được "%s"' % title)

    def toast(self, text):
        d = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.INFO,
                              buttons=Gtk.ButtonsType.OK, text=text)
        d.connect('response', lambda d, _r: d.destroy())
        d.show()

    # ------------------------------------------------------------------ tìm kiếm
    def on_search(self, entry):
        q = fold(entry.get_text().strip())
        if not q:
            if self.current == 'search':
                self.go_back()
            return
        p = self.pages['search']
        for w in p.box.get_children():
            p.box.remove(w)
        words = q.split()

        def rank(it):
            # 0: cả cụm nằm trong tên · 1: cả cụm nằm trong mô tả / từ khoá · 2: đủ các từ (mỗi từ mở đầu một chữ)
            if q in fold(it[1]):
                return 0
            if q in it[0]:
                return 1
            have = it[0].split()
            return 2 if all(any(h.startswith(w) for h in have) for w in words) else None
        ranked = [(rank(it), i, it) for i, it in enumerate(self.search_index)]
        best = min((r for r, _i, _it in ranked if r is not None), default=None)
        # đã có mục khớp nguyên cụm thì không kéo theo các mục chỉ khớp rời từng từ
        hits = [it for r, _i, it in sorted(x for x in ranked if x[0] is not None and (x[0] < 2 or best == 2))]
        self.search_hits = hits
        if not hits:
            p.add(label('Không thấy cài đặt nào khớp với "%s".' % entry.get_text().strip(), 'st-note', wrap=True))
        for _n, title, sub, icon_name, pid in hits[:40]:
            where = self.pages[pid]
            path = where.title if not where.parent else '%s › %s' % (self.pages[where.parent].title, where.title)
            c = Card(icon_name, title, path if not sub else '%s — %s' % (path, sub),
                     on_click=lambda pid=pid: self.go(pid), chevron='go-next-symbolic')
            p.add(c.widget)
        p.box.show_all()
        if self.current != 'search':
            self.go('search')

    def on_search_enter(self, _e):
        hits = getattr(self, 'search_hits', [])
        if self.current == 'search' and hits:
            self.go(hits[0][4])

    # ================================================================== các trang
