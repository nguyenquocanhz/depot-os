              'notifications')
        p.nav('battery-symbolic', 'Nguồn và pin', 'Chế độ pin, tắt màn hình, ngủ', 'power')
        p.nav('drive-harddisk-symbolic', 'Lưu trữ', 'Dung lượng đã dùng, vùng lưu trên USB', 'storage')
