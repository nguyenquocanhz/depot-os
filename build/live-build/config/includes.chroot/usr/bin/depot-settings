                   'màn hình ngoài', 'xfce-display-settings.desktop', 'resolution refresh rate hdmi may chieu xoay')
        if c:
            p.refreshers.append(lambda: bg(res, lambda r: r and c.set_sub(
                'Đang dùng %s — bấm để đổi độ phân giải, tần số quét, màn hình ngoài' % r)))

