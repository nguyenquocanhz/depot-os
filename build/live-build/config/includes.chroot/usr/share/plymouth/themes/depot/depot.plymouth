[Plymouth Theme]
Name=Depot
Description=Depot OS boot animation — logo đặt khớp với menu boot (scripts/gen-boot-video.py), thanh tiến trình mảnh
ModuleName=script

[script]
ImageDir=/usr/share/plymouth/themes/depot
ScriptFile=/usr/share/plymouth/themes/depot/depot.script

[script-env-graphical]
Font=Inter 14
