<?xml version="1.0" encoding="UTF-8"?>
<!-- Depot OS — Terminal (xfce4-terminal 1.1): màu "Bóng ma" theo logo Depot by WrenEvil, JetBrains Mono, nền trong mờ,
     không thanh menu / thanh công cụ / thanh cuộn (chuột phải vẫn có menu), con trỏ dọc nhấp nháy, tab gọn.
     Lề trong khung chữ: ~/.config/gtk-3.0/gtk.css (vte-terminal). Bảng màu chọn lại được: Tuỳ chỉnh > Màu > "Depot Bóng ma". -->
<channel name="xfce4-terminal" version="1.0">
  <property name="font-use-system" type="bool" value="false"/>
  <property name="font-name" type="string" value="JetBrains Mono 11"/>
  <property name="font-allow-bold" type="bool" value="true"/>
  <property name="misc-default-geometry" type="string" value="96x28"/>
  <property name="misc-menubar-default" type="bool" value="false"/>
  <property name="misc-toolbar-default" type="bool" value="false"/>
  <property name="misc-borders-default" type="bool" value="true"/>
  <property name="scrolling-bar" type="string" value="TERMINAL_SCROLLBAR_NONE"/>
  <property name="scrolling-lines" type="uint" value="20000"/>
  <property name="misc-cursor-shape" type="string" value="TERMINAL_CURSOR_SHAPE_IBEAM"/>
  <property name="misc-cursor-blinks" type="bool" value="true"/>
  <property name="misc-slim-tabs" type="bool" value="true"/>
  <property name="misc-tab-close-buttons" type="bool" value="true"/>
  <property name="misc-new-tab-adjacent" type="bool" value="true"/>
  <property name="misc-confirm-close" type="bool" value="true"/>
  <property name="misc-show-unsafe-paste-dialog" type="bool" value="true"/>
  <property name="misc-hyperlinks-enabled" type="bool" value="true"/>
  <property name="misc-mouse-autohide" type="bool" value="true"/>
  <property name="misc-mouse-wheel-zoom" type="bool" value="true"/>
  <property name="misc-rewrap-on-resize" type="bool" value="true"/>
  <property name="misc-search-dialog-opacity" type="uint" value="90"/>
  <property name="title-initial" type="string" value="Terminal"/>
  <!-- nền trong mờ: cần picom (luôn chạy, xem depot-effects); không compositor thì nền đặc -->
  <property name="background-mode" type="string" value="TERMINAL_BACKGROUND_TRANSPARENT"/>
  <property name="background-darkness" type="double" value="0.90"/>
  <property name="color-use-theme" type="bool" value="false"/>
  <property name="color-foreground" type="string" value="#e8ecf5"/>
  <property name="color-background" type="string" value="#07080c"/>
  <property name="color-cursor-use-default" type="bool" value="false"/>
  <property name="color-cursor" type="string" value="#ff2d3d"/>
  <property name="color-cursor-foreground" type="string" value="#07080c"/>
  <property name="color-selection-use-default" type="bool" value="false"/>
  <property name="color-selection" type="string" value="#ffffff"/>
  <property name="color-selection-background" type="string" value="#5a1620"/>
  <property name="color-bold-use-default" type="bool" value="true"/>
  <property name="color-bold-is-bright" type="bool" value="false"/>
  <property name="tab-activity-color" type="string" value="#ff2d3d"/>
  <property name="color-palette" type="string" value="#1b1d24;#ff4d5a;#7fd1a8;#f0c674;#6f9ad8;#c79bf2;#6cc7d9;#c9cfdc;#5d6272;#ff6b74;#9be3bf;#ffd98e;#8fb4ef;#dab6ff;#8fdcea;#ffffff"/>
</channel>
